/**
 * 音视频通话 UTS 插件（iOS）。
 *
 * 直接封装 WFAVEngineKit.xcframework 的 WFAVEngineKit（引擎单例）与 WFAVCallSession
 * （每次通话的会话对象），不经过旧版 nativeplugin 的 WFAVModule（WFAVUniPlugin.xcframework）
 * ——那是给旧版 JS bridge 用的，没有证据表明它已经适配 uts 直接调用；这里改成直接对接
 * 底层引擎，和 Android 侧 index.uts 的思路一致。方法/属性签名已对照 WFAVEngineKit.h 头文件核对。
 *
 * 关于 WFChatClient.xcframework（对应 Android 侧 client-release.aar 的角色）：
 * 本插件 import { WFCCConversation } from 'WFChatClient'，每个 uts 插件的 Swift 编译只看得到自己
 * Frameworks/ 下的 framework，所以本插件 Frameworks/ 下必须带一份 WFChatClient.xcframework
 * （wfc-client / wfc-ptt-client 也各带一份）。这一点看似和 Android 上「client-release 不能在
 * av/ptt 里重复放、否则 Duplicate class」的结论相反，原因是 WFChatClient.xcframework 是
 * **动态 framework**（Mach-O MH_DYLIB，非静态库）：动态库是「链接 + 按 bundle 标识只嵌入一份」，
 * 多个插件同时链接同名动态库不会产生静态库那种 duplicate symbols，Xcode 的 embed 阶段会按 framework
 * 名去重，因此各插件都带一份是 iOS 上的常规做法。Android 的 Duplicate 是静态合并 .class 的概念，
 * 不适用于这里。（曾被我不小心删掉过，已从 wfc-client 那份原样拷回。）
 * 兜底：万一云打包在 embed 阶段报 "multiple commands produce .../WFChatClient.framework" 之类的
 * 重复嵌入错误，再改成「av/ptt 不带 WFChatClient、只 wfc-client 带，靠共享 framework 搜索路径」的
 * 非重复方案。
 *
 * 其余未经 HBuilderX iOS 编译验证的点（如报错优先查这里）：
 * 1. WFAVEngineDelegate/WFAVCallSessionDelegate 的实现用 `class X implements Y`，具体语法
 *    需要以 uni-app x 官方 UTS 原生混编（iOS/Swift）文档为准。
 * 2. Objective-C block 参数（如 successBlock/errorBlock）在 uts 里的闭包写法按 wfc-client
 *    已有代码里的具名参数风格（`ip=ip, port=port`）类推，未逐一验证。
 * 3. 枚举取整数用 `.rawValue`（Swift），对应 Android/Kotlin 的 `.ordinal`——本文件已统一用 rawValue。
 */

import { NativeEventListener } from '../interface.uts'

import { WFAVEngineKit, WFAVEngineDelegate, WFAVCallSession, WFAVCallSessionDelegate, WFAVEngineState, WFAVCallEndReason, WFAVVideoType, WFAVVideoProfile, WFAVParticipantProfile, WFAVVideoScalingType } from 'WFAVEngineKit'
import { RTCVideoTrack } from 'WebRTC'
import { PKPushPayload } from 'PushKit'
import { WFCCConversation, WFCCConversationType } from 'WFChatClient'
import { UIView } from 'UIKit'

let avEngineEventListener: NativeEventListener | null = null
let callSessionEventListener: NativeEventListener | null = null
let initialized = false

// SDK 的 delegate 回调可能来自后台线程（如音量上报来自音频线程），而 UTS 的事件监听最终要
// 调到 JS 引擎，不能跨线程调用，所以所有事件统一派发到主线程再回调。
function emitAVEngineEvent(event: string, argsJson: string): void {
    DispatchQueue.main.async(execute = (): void => {
        avEngineEventListener?.(event, argsJson)
    })
}

function emitCallSessionEvent(event: string, argsJson: string): void {
    DispatchQueue.main.async(execute = (): void => {
        callSessionEventListener?.(event, argsJson)
    })
}

// 页面 <native-view> 元素 -> 绑定到其上的视频容器。重复对同一元素 setup 时复用同一个容器
// （bindIOSView 只能绑一次）。
// 注意：UniNativeViewElement 不是 Hashable，不能用作 Swift Dictionary/Map 的键，所以这里
// 用两个平行数组 + 引用相等（===）线性查找（页面上的 native-view 数量极少，性能无碍）。
let videoContainerElements: UniNativeViewElement[] = []
let videoContainerViews: UIView[] = []

function videoContainerOf(element: UniNativeViewElement): UIView {
    for (let i = 0; i < videoContainerElements.length; i++) {
        if (videoContainerElements[i] === element) {
            return videoContainerViews[i]
        }
    }
    const container = new UIView()
    element.bindIOSView(container)
    videoContainerElements.push(element)
    videoContainerViews.push(container)
    return container
}

function clearVideoContainers(): void {
    videoContainerElements = []
    videoContainerViews = []
}

function jsonArrayString(args: any[]): string {
    // uts 侧没有现成的 JSONSerialization 包装，这里手工拼装数组的 JSON 字符串。
    // 约定：所有字符串元素（含 callSessionToJson/participantProfileToJson 生成的 JSON 文本）
    // 一律作为字符串转义后放进数组——即数组里嵌的是"JSON 字符串"而不是"嵌套 JSON 对象"，
    // 和 Android 侧 org.json.JSONArray(kotlinListOfString) 的行为保持一致，
    // 应用层 wfc/av/engine/avEngineKit.uts 按"数组元素可能是待再次 JSON.parse 的字符串"来处理。
    const parts: string[] = args.map((a: any): string => {
        if (a == null) {
            return "null"
        }
        if (typeof a == "string") {
            // 注意 replace(string, string) 只替换第一处，必须用 split/join 做全局替换
            let s = a as string
            s = s.split("\\").join("\\\\")
            s = s.split("\"").join("\\\"")
            s = s.split("\n").join("\\n")
            s = s.split("\r").join("\\r")
            s = s.split("\t").join("\\t")
            return "\"" + s + "\""
        }
        if (typeof a == "boolean") {
            return (a as boolean) ? "true" : "false"
        }
        // 走到这里 a 只剩数字/null（null 已在开头处理），显式 toString 避免 String+Any 依赖运行时运算符
        return (a as number).toString()
    })
    return "[" + parts.join(",") + "]"
}

function callSessionToJson(session: WFAVCallSession): string {
    const conv = session.conversation!
    // 所有数值字段先单独转成 String（每个转换一条语句），大拼接表达式里就只剩 String+String，
    // 避免混合类型 String+/NSNumber 重载解析导致编译器 "unable to type-check in reasonable time"
    const convTypeStr = Number(conv.type.rawValue).toString()
    const convLineStr = Number(conv.line).toString()
    const convTarget = conv.target!
    const convJson = "{\"type\":" + convTypeStr + ",\"target\":\"" + convTarget + "\",\"line\":" + convLineStr + "}"
    const stateStr = Number(session.state.rawValue).toString()
    const startTimeStr = Number(session.startTime).toString()
    const connectedTimeStr = Number(session.connectedTime).toString()
    const endTimeStr = Number(session.endTime).toString()
    const endReasonStr = Number(session.endReason.rawValue).toString()
    const obj = "{" +
        "\"callId\":\"" + session.callId! + "\"," +
        "\"initiator\":\"" + (session.initiator ?? "") + "\"," +
        "\"inviter\":\"" + (session.inviter ?? "") + "\"," +
        "\"state\":" + stateStr + "," +
        "\"startTime\":" + startTimeStr + "," +
        "\"connectedTime\":" + connectedTimeStr + "," +
        "\"endTime\":" + endTimeStr + "," +
        "\"conversation\":" + convJson + "," +
        "\"audioOnly\":" + (session.isAudioOnly ? "true" : "false") + "," +
        "\"endReason\":" + endReasonStr + "," +
        "\"conference\":" + (session.isConference ? "true" : "false") + "," +
        "\"audience\":" + (session.isAudience ? "true" : "false") + "," +
        "\"defaultAudience\":" + (session.defaultAudience ? "true" : "false") + "," +
        "\"advanced\":" + (session.isAdvanced ? "true" : "false") + "," +
        "\"audioMuted\":" + (session.isAudioMuted ? "true" : "false") + "," +
        "\"videoMuted\":" + (session.isVideoMuted ? "true" : "false") + "," +
        "\"title\":\"" + (session.title ?? "") + "\"," +
        "\"desc\":\"" + (session.desc ?? "") + "\"," +
        "\"pin\":\"" + (session.pin ?? "") + "\"," +
        "\"host\":\"" + (session.host ?? "") + "\"," +
        "\"multiCall\":" + (session.isMultiCall ? "true" : "false") +
        "}"
    return obj
}

function participantProfileToJson(p: WFAVParticipantProfile): string {
    const startTimeStr = Number(p.startTime).toString()
    const stateStr = Number(p.state.rawValue).toString()
    const userId = p.userId!
    return "{" +
        "\"userId\":\"" + userId + "\"," +
        "\"startTime\":" + startTimeStr + "," +
        "\"state\":" + stateStr + "," +
        "\"videoMuted\":" + (p.videoMuted ? "true" : "false") + "," +
        "\"audioMuted\":" + (p.audioMuted ? "true" : "false") + "," +
        "\"audience\":" + (p.audience ? "true" : "false") + "," +
        "\"screenSharing\":" + (p.screeSharing ? "true" : "false") +
        "}"
}

class NativeAVEngineDelegate implements WFAVEngineDelegate {
    didReceiveCall(session: WFAVCallSession): void {
        session.delegate = nativeCallSessionDelegate
        emitAVEngineEvent("onReceiveCall", jsonArrayString([callSessionToJson(session)]))
    }

    shouldStartRing(isIncoming: boolean): void {
        emitAVEngineEvent("shouldStartRing", jsonArrayString([isIncoming]))
    }

    shouldStopRing(): void {
        emitAVEngineEvent("shouldStopRing", jsonArrayString([]))
    }

    didCallEnded(reason: WFAVCallEndReason, @argumentLabel("duration") duration: Int32): void {
        clearVideoContainers()
        emitAVEngineEvent("didCallEnded", jsonArrayString([reason.rawValue, duration]))
    }

    // WFAVEngineDelegate 的必需方法（收到 VoIP push）。dictionaryPayload 是 [AnyHashable: Any]，
    // UTS 里拿不到通用 JSON 序列化，这里只把 push 类型透传给应用层。
    didReceiveIncomingPush(@argumentLabel("with") payload: PKPushPayload, @argumentLabel("forType") type: string): void {
        emitAVEngineEvent("didReceiveIncomingPush", jsonArrayString([type]))
    }
}

class NativeCallSessionDelegate implements WFAVCallSessionDelegate {
    // 协议方法在 Swift 里被改名为 didChange(_:)，事件名仍用 didChangeState 透传，避免动应用层
    didChange(state: WFAVEngineState): void {
        emitCallSessionEvent("didChangeState", jsonArrayString([state.rawValue]))
    }

    didParticipantJoined(userId: string, @argumentLabel("screenSharing") screenSharing: boolean): void {
        emitCallSessionEvent("didParticipantJoined", jsonArrayString([userId, screenSharing]))
    }

    didParticipantConnected(userId: string, @argumentLabel("screenSharing") screenSharing: boolean): void {
        emitCallSessionEvent("didParticipantConnected", jsonArrayString([userId, screenSharing]))
    }

    didParticipantLeft(userId: string, @argumentLabel("screenSharing") screenSharing: boolean, @argumentLabel("with") reason: WFAVCallEndReason): void {
        emitCallSessionEvent("didParticipantLeft", jsonArrayString([userId, reason.rawValue, screenSharing]))
    }

    didChangeInitiator(initiator: string | null): void {
        emitCallSessionEvent("didChangeInitiator", jsonArrayString([initiator ?? ""]))
    }

    // 协议方法在 Swift 里被改名为 didCallEnd(with:)，事件名仍用 didCallEndWithReason 透传
    didCallEnd(@argumentLabel("with") reason: WFAVCallEndReason): void {
        emitCallSessionEvent("didCallEndWithReason", jsonArrayString([reason.rawValue]))
    }

    // didError 的协议签名是 didError(_ error: any Error)，UTS 里没有能映射到 Swift any Error
    // 的参数类型，所以该方法由同目录下的原生 Swift 扩展文件（AVDelegates.swift）补充实现。

    didChangeMode(isAudioOnly: boolean): void {
        emitCallSessionEvent("didChangeMode", jsonArrayString([isAudioOnly]))
    }

    didGetStats(stats: any[]): void {
        // 统计信息内容复杂，暂不转发详细数据
    }

    didCreateLocalVideoTrack(localVideoTrack: RTCVideoTrack): void {
        emitCallSessionEvent("didCreateLocalVideoTrack", jsonArrayString([]))
    }

    didReceiveRemoteVideoTrack(remoteVideoTrack: RTCVideoTrack, @argumentLabel("fromUser") userId: string, @argumentLabel("screenSharing") screenSharing: boolean): void {
        emitCallSessionEvent("didReceiveRemoteVideoTrack", jsonArrayString([userId, screenSharing]))
    }

    didVideoMuted(videoMuted: boolean, @argumentLabel("fromUser") userId: string): void {
        emitCallSessionEvent("didVideoMuted", jsonArrayString([userId, videoMuted]))
    }

    // SDK 声明是 didReportAudioVolume:(NSInteger)volume，参数是标量整数。UTS 的 number 会编译成
    // NSNumber（对象指针），@objc 方法编码变成 v@:@@，SDK 按 v@:q@ 传参时把 int 当指针 → 崩溃。
    // 用 Int64（编码 q，与 NSInteger 一致）才能正确对接。
    didReportAudioVolume(volume: Int64, @argumentLabel("ofUser") userId: string): void {
        emitCallSessionEvent("didReportAudioVolume", jsonArrayString([userId, volume]))
    }

    didChangeType(audience: boolean, @argumentLabel("ofUser") userId: string): void {
        emitCallSessionEvent("didChangeType", jsonArrayString([userId, audience, false]))
    }

    didMuteStateChanged(userIds: string[]): void {
        emitCallSessionEvent("didMuteStateChanged", jsonArrayString([jsonArrayString(userIds)]))
    }
}

const nativeAVEngineDelegate = new NativeAVEngineDelegate()
const nativeCallSessionDelegate = new NativeCallSessionDelegate()

export function onAVEngineEvent(listener: NativeEventListener): void {
    avEngineEventListener = listener
}

export function onCallSessionEvent(listener: NativeEventListener): void {
    callSessionEventListener = listener
}

export function initAVEngineKit(): void {
    if (initialized) {
        return
    }
    initialized = true
    WFAVEngineKit.shared().delegate = nativeAVEngineDelegate
}

export function addICEServer(url: string, name: string, password: string): void {
    WFAVEngineKit.shared().addIceServer(url, userName = name, password = password)
}

export function isSupportMultiCall(): boolean {
    return WFAVEngineKit.shared().supportMultiCall
}

// 和 Android 一样，音视频 SDK 分多人版 / 高级版（会议版）两个包，替换
// Frameworks/WFAVEngineKit.xcframework 切换。多人版里会议接口是「为兼容会议 UI 保留的空实现」
// （见 WFAVEngineKit.h 里的注释），supportConference 返回 false，应用层据此隐藏会议入口。
export function isSupportConference(): boolean {
    return WFAVEngineKit.shared().supportConference
}

export function setVideoProfile(profile: number, swapWidthHeight: boolean): void {
    // profile 数值和 Android VideoProfile 常量、iOS WFAVVideoProfile 枚举原始值保持一致（见头文件注释）。
    // 注意不能写 profile as WFAVVideoProfile：那会编译成 NSNumber as! 枚举，运行时直接崩，必须用 rawValue 初始化。
    WFAVEngineKit.shared().setVideoProfile(WFAVVideoProfile(rawValue = profile.toInt())!, swapWidthHeight = swapWidthHeight)
}

function currentSessionOrNull(): WFAVCallSession | null {
    return WFAVEngineKit.shared().currentSession
}

export function startSingleCall(userId: string, audioOnly: boolean): string | null {
    const conv = WFCCConversation.singleConversation(userId)
    const session = WFAVEngineKit.shared().startCall([userId], audioOnly = audioOnly, callExtra = null, conversation = conv, sessionDelegate = nativeCallSessionDelegate)
    return session == null ? null : callSessionToJson(session!)
}

export function startMultiCall(groupId: string, participants: string[], audioOnly: boolean): string | null {
    const conv = WFCCConversation.groupConversation(groupId)
    const session = WFAVEngineKit.shared().startCall(participants, audioOnly = audioOnly, callExtra = null, conversation = conv, sessionDelegate = nativeCallSessionDelegate)
    return session == null ? null : callSessionToJson(session!)
}

/** 发起会议（仅会议版 xcframework 有效）。SDK 头文件标注 startConference 返回 _Nonnull，无需判空 */
export function startConference(callId: string, audioOnly: boolean, pin: string, host: string, title: string, desc: string, audience: boolean, advance: boolean, record: boolean, callExtra: string): string {
    // maxParticipants 传 0 表示不限制，与 Android 的 startConference（无该入参）行为一致
    const session = WFAVEngineKit.shared().startConference(callId, audioOnly = audioOnly, pin = pin, host = host, title = title, desc = desc, callExtra = callExtra, audience = audience, advanced = advance, record = record, maxParticipants = 0, sessionDelegate = nativeCallSessionDelegate)
    session.autoSwitchVideoType = false
    return callSessionToJson(session)
}

/** 加入会议（仅会议版 xcframework 有效）。SDK 头文件标注 joinConference 返回 _Nonnull，无需判空 */
export function joinConference(callId: string, audioOnly: boolean, pin: string, host: string, title: string, desc: string, audience: boolean, advance: boolean, muteAudio: boolean, muteVideo: boolean, callExtra: string): string {
    const session = WFAVEngineKit.shared().joinConference(callId, audioOnly = audioOnly, pin = pin, host = host, title = title, desc = desc, callExtra = callExtra, audience = audience, advanced = advance, muteAudio = muteAudio, muteVideo = muteVideo, sessionDelegate = nativeCallSessionDelegate)
    session.autoSwitchVideoType = false
    return callSessionToJson(session)
}

export function leaveConference(callId: string, destroyRoom: boolean): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.leaveConference(destroyRoom)
    }
}

export function canSwitchAudience(callId: string): boolean {
    const session = currentSessionOrNull()
    return session != null && session!.callId == callId && session!.canSwitchAudience()
}

export function switchAudience(callId: string, audience: boolean): boolean {
    const session = currentSessionOrNull()
    return session != null && session!.callId == callId && session!.switchAudience(audience)
}

export function currentCallSession(): string | null {
    const session = currentSessionOrNull()
    return session == null ? null : callSessionToJson(session!)
}

export function answerCall(callId: string, audioOnly: boolean): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.answerCall(audioOnly, callExtra = "")
    }
}

export function endCall(callId: string): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.endCall()
    }
}

export function muteAudio(callId: string, mute: boolean): boolean {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        return session!.muteAudio(mute)
    }
    return false
}

export function muteVideo(callId: string, mute: boolean): boolean {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        return session!.muteVideo(mute)
    }
    return false
}

export function downgrade2Voice(callId: string): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.isAudioOnly = true
    }
}

export function switchCamera(callId: string): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.switchCamera()
    }
}

export function setSpeakerOn(callId: string, speakerOn: boolean): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.enableSpeaker(speakerOn)
    }
}

export function inviteNewParticipant(callId: string, userIds: string[]): void {
    const session = currentSessionOrNull()
    if (session != null && session!.callId == callId) {
        session!.inviteNewParticipants(userIds)
    }
}

export function kickoffParticipant(callId: string, userId: string, successCB: () => void, failCB: (error: number) => void): void {
    const session = currentSessionOrNull()
    if (session == null || session!.callId != callId) {
        failCB(-1)
        return
    }
    session!.kickoffParticipant(userId, success = (): void => {
        successCB()
    }, error = (code: Int32): void => {
        // SDK 的 error 回调参数是 (Int32) -> Void，Number() 把 Int32 转成 number 再回传给应用层
        failCB(Number(code))
    })
}

export function getParticipantProfiles(callId: string): string {
    const session = currentSessionOrNull()
    if (session == null || session!.callId != callId) {
        return "[]"
    }
    // 头文件里 participants 是 NSArray<WFAVParticipantProfile *>，Swift 导入后是 NSArray 而不是
    // [WFAVParticipantProfile]，需要显式 as 转换后才能 map
    const profiles = session!.participants as WFAVParticipantProfile[]
    const items = profiles.map((p: WFAVParticipantProfile): string => participantProfileToJson(p))
    return "[" + items.join(",") + "]"
}

export function getParticipantProfile(callId: string, userId: string, screenSharing: boolean): string | null {
    const session = currentSessionOrNull()
    if (session == null || session!.callId != callId) {
        return null
    }
    // SDK 把 profileOfUser(_:isScreenSharing:) 在 Swift 里改名为 profile(ofUser:isScreenSharing:)
    const p = session!.profile(ofUser = userId, isScreenSharing = screenSharing)
    return p == null ? null : participantProfileToJson(p!)
}

export function getMyProfile(callId: string): string | null {
    const session = currentSessionOrNull()
    if (session == null || session!.callId != callId) {
        return null
    }
    const p = session!.myProfile
    return p == null ? null : participantProfileToJson(p!)
}

// iOS 由系统在首次实际使用摄像头/麦克风时自动弹出授权对话框，这里不做额外的预检查，
// 直接放行；如果之前被拒绝过，SDK 内部调用会失败，通话会以 didError/didCallEndWithReason 结束。
export function requestVoipPermissions(audioOnly: boolean, successCB: () => void, failCB: () => void): void {
    successCB()
}

export function checkOverlayPermission(): boolean {
    // iOS 没有 Android 悬浮窗的概念，通话继续在原生层进行，返回 true 表示无需额外授权
    return true
}

export function minimize(callId: string, focusVideoUser: string): void {
    // no-op：iOS 下由调用方（uts 应用层）自行处理返回上一页
}

export function setLocalVideoView(callId: string, element: UniNativeViewElement): void {
    const session = currentSessionOrNull()
    if (session == null || session!.callId != callId) {
        return
    }
    session!.setupLocalVideoView(videoContainerOf(element), scalingType = WFAVVideoScalingType.aspectFill)
}

export function setRemoteVideoView(callId: string, userId: string, screenSharing: boolean, element: UniNativeViewElement): void {
    const session = currentSessionOrNull()
    if (session == null || session!.callId != callId) {
        return
    }
    session!.setupRemoteVideoView(videoContainerOf(element), scalingType = WFAVVideoScalingType.aspectFill, forUser = userId, screenSharing = screenSharing)
}

export function setParticipantVideoType(callId: string, userId: string, screenSharing: boolean, videoType: number): void {
    // WFAVEngineKit 中该接口仅为兼容专业版 UI 保留，免费版多人通话没有实际效果
}

// 仅鸿蒙需要：鸿蒙版音视频引擎跑在 ArkTS 侧，收不到原生消息流，得由应用层把原始 proto 消息转发过去。
// iOS 的 WFAVEngineKit 自己就挂在 SDK 的消息回调上，这里空实现即可。
export function dispatchReceivedMessages(messagesJson: string, hasMore: boolean): void {
}

// 同上，仅鸿蒙需要：高级版音视频引擎靠会议事件知道谁发布了媒体流，进而去订阅。
export function dispatchConferenceEvent(event: string): void {
}
