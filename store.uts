/**
 * 媒体预览项
 */
export class PreviewMediaItem {
    src = '';
    thumb = '';
    autoplay = true;

    constructor(src: string, thumb: string, autoplay: boolean = true) {
        this.src = src;
        this.thumb = thumb;
        this.autoplay = autoplay;
    }
}

/**
 * 消息发送/下载进度
 */
export class MediaProgress {
    messageId = 0;
    progress = 0;
    total = 0;

    constructor(messageId: number, progress: number, total: number) {
        this.messageId = messageId;
        this.progress = progress;
        this.total = total;
    }
}

export class ConversationState {
    private _currentConversationInfo = ref<ConversationInfo | null>(null);
    get currentConversationInfo(): ConversationInfo | null { return this._currentConversationInfo.value }
    set currentConversationInfo(value: ConversationInfo | null) { this._currentConversationInfo.value = value }

    private _conversationInfoList = ref<ConversationInfo[]>([]);
    get conversationInfoList(): ConversationInfo[] { return this._conversationInfoList.value }
    set conversationInfoList(value: ConversationInfo[]) { this._conversationInfoList.value = value }

    private _currentConversationMessageList = ref<Message[]>([]);
    get currentConversationMessageList(): Message[] { return this._currentConversationMessageList.value }
    set currentConversationMessageList(value: Message[]) { this._currentConversationMessageList.value = value }

    private _currentConversationOldestMessageId = ref<number>(0);
    get currentConversationOldestMessageId(): number { return this._currentConversationOldestMessageId.value }
    set currentConversationOldestMessageId(value: number) { this._currentConversationOldestMessageId.value = value }

    private _currentConversationOldestMessageUid = ref<string>('0');
    get currentConversationOldestMessageUid(): string { return this._currentConversationOldestMessageUid.value }
    set currentConversationOldestMessageUid(value: string) { this._currentConversationOldestMessageUid.value = value }

    // 消息定位模式下，已加载的最新一条消息 id；用于向下翻页
    private _currentConversationNewestMessageId = ref<number>(0);
    get currentConversationNewestMessageId(): number { return this._currentConversationNewestMessageId.value }
    set currentConversationNewestMessageId(value: number) { this._currentConversationNewestMessageId.value = value }

    // 为 true 表示当前消息列表底部之后还有更新的消息（消息定位后进入的状态）
    private _hasMoreNewMessages = ref<boolean>(false);
    get hasMoreNewMessages(): boolean { return this._hasMoreNewMessages.value }
    set hasMoreNewMessages(value: boolean) { this._hasMoreNewMessages.value = value }

    // 需要高亮的消息 id，0 表示无
    private _highlightMessageId = ref<number>(0);
    get highlightMessageId(): number { return this._highlightMessageId.value }
    set highlightMessageId(value: number) { this._highlightMessageId.value = value }

    // 待定位的消息 id（如从搜索结果跳转过来），会话页 onShow 时消费
    private _pendingLocateMessageId = ref<number>(0);
    get pendingLocateMessageId(): number { return this._pendingLocateMessageId.value }
    set pendingLocateMessageId(value: number) { this._pendingLocateMessageId.value = value }

    // 进入会话时的未读数，用于顶部「N 条未读」提示条
    private _enterUnreadCount = ref<number>(0);
    get enterUnreadCount(): number { return this._enterUnreadCount.value }
    set enterUnreadCount(value: number) { this._enterUnreadCount.value = value }

    private _enterUnreadMentionCount = ref<number>(0);
    get enterUnreadMentionCount(): number { return this._enterUnreadMentionCount.value }
    set enterUnreadMentionCount(value: number) { this._enterUnreadMentionCount.value = value }

    private _currentConversationRead = ref<Map<string, number> | null>(null);
    get currentConversationRead(): Map<string, number> | null { return this._currentConversationRead.value }
    set currentConversationRead(value: Map<string, number> | null) { this._currentConversationRead.value = value }

    private _isMessageReceiptEnable = ref<boolean>(false);
    get isMessageReceiptEnable(): boolean { return this._isMessageReceiptEnable.value }
    set isMessageReceiptEnable(value: boolean) { this._isMessageReceiptEnable.value = value }

    private _inputtingUser = ref<UserInfo | null>(null);
    get inputtingUser(): UserInfo | null { return this._inputtingUser.value }
    set inputtingUser(value: UserInfo | null) { this._inputtingUser.value = value }

    private _inputtingTypingType = ref<number>(0);
    get inputtingTypingType(): number { return this._inputtingTypingType.value }
    set inputtingTypingType(value: number) { this._inputtingTypingType.value = value }

    private _inputClearTimer = ref<number>(0);
    get inputClearTimer(): number { return this._inputClearTimer.value }
    set inputClearTimer(value: number) { this._inputClearTimer.value = value }

    private _shouldAutoScrollToBottom = ref<boolean>(true);
    get shouldAutoScrollToBottom(): boolean { return this._shouldAutoScrollToBottom.value }
    set shouldAutoScrollToBottom(value: boolean) { this._shouldAutoScrollToBottom.value = value }

    private _previewMediaItems = ref<PreviewMediaItem[]>([]);
    get previewMediaItems(): PreviewMediaItem[] { return this._previewMediaItems.value }
    set previewMediaItems(value: PreviewMediaItem[]) { this._previewMediaItems.value = value }

    private _previewMediaIndex = ref<number>(0);
    get previewMediaIndex(): number { return this._previewMediaIndex.value }
    set previewMediaIndex(value: number) { this._previewMediaIndex.value = value }

    private _enableMessageMultiSelection = ref<boolean>(false);
    get enableMessageMultiSelection(): boolean { return this._enableMessageMultiSelection.value }
    set enableMessageMultiSelection(value: boolean) { this._enableMessageMultiSelection.value = value }

    private _showChannelMenu = ref<boolean>(false);
    get showChannelMenu(): boolean { return this._showChannelMenu.value }
    set showChannelMenu(value: boolean) { this._showChannelMenu.value = value }

    private _quotedMessage = ref<Message | null>(null);
    get quotedMessage(): Message | null { return this._quotedMessage.value }
    set quotedMessage(value: Message | null) { this._quotedMessage.value = value }

    private _downloadingMessages = ref<MediaProgress[]>([]);
    get downloadingMessages(): MediaProgress[] { return this._downloadingMessages.value }
    set downloadingMessages(value: MediaProgress[]) { this._downloadingMessages.value = value }

    private _sendingMessages = ref<MediaProgress[]>([]);
    get sendingMessages(): MediaProgress[] { return this._sendingMessages.value }
    set sendingMessages(value: MediaProgress[]) { this._sendingMessages.value = value }

    private _floatingConversations = ref<Conversation[]>([]);
    get floatingConversations(): Conversation[] { return this._floatingConversations.value }
    set floatingConversations(value: Conversation[]) { this._floatingConversations.value = value }

    private _currentVoiceMessage = ref<Message | null>(null);
    get currentVoiceMessage(): Message | null { return this._currentVoiceMessage.value }
    set currentVoiceMessage(value: Message | null) { this._currentVoiceMessage.value = value }

    private _contextMenuConversationInfo = ref<ConversationInfo | null>(null);
    get contextMenuConversationInfo(): ConversationInfo | null { return this._contextMenuConversationInfo.value }
    set contextMenuConversationInfo(value: ConversationInfo | null) { this._contextMenuConversationInfo.value = value }

    _reset(): void {
        this.currentConversationInfo = null;
        this.conversationInfoList = [];
        this.currentConversationMessageList = [];
        this.currentConversationOldestMessageId = 0;
        this.currentConversationOldestMessageUid = '0';
        this.currentConversationNewestMessageId = 0;
        this.hasMoreNewMessages = false;
        this.highlightMessageId = 0;
        this.pendingLocateMessageId = 0;
        this.enterUnreadCount = 0;
        this.enterUnreadMentionCount = 0;
        this.currentConversationRead = null;
        this.isMessageReceiptEnable = false;
        this.inputtingUser = null;
        this.inputtingTypingType = 0;
        this.inputClearTimer = 0;
        this.shouldAutoScrollToBottom = true;
        this.previewMediaItems = [];
        this.previewMediaIndex = 0;
        this.enableMessageMultiSelection = false;
        this.showChannelMenu = false;
        this.quotedMessage = null;
        this.downloadingMessages = [];
        this.sendingMessages = [];
        this.floatingConversations = [];
        this.currentVoiceMessage = null;
        this.contextMenuConversationInfo = null;
    }
}

