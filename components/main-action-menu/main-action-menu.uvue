<template>
    <!--
        整个遮罩就是这一个 fixed 节点，tap 直接挂在它自己身上：
        鸿蒙上嵌套的 fixed 节点会被提到独立层，事件不一定冒泡回父节点，
        所以不能再让外层节点代收「点击空白关闭」的手势。
        菜单本身也不用 fixed/absolute，纯 flex 靠右排，少踩一个定位差异。
    -->
    <view v-if="isActive" class="main-action-menu-root"
        :style="{ width: maskWidth + 'px', height: maskHeight + 'px' }" @tap="hide">
        <view class="main-action-menu" :style="{ marginTop: (height + 50) + 'px' }" @tap.stop="onMenuTap">
            <view class="main-action-menu-top-arrow"></view>
            <view class="menu-list">
                <view class="menu-item" @tap="go2CreateGroup">
                    <text class="customicons menu-item-icon">&#xe69e;</text>
                    <text class="text solid-bottom" :style="{ fontSize: fontPx(16) }">发起群聊</text>
                </view>
                <view class="menu-item" @tap="go2SearchFriend">
                    <text class="customicons menu-item-icon">&#xe657;</text>
                    <text class="text solid-bottom" :style="{ fontSize: fontPx(16) }">添加朋友</text>
                </view>
                <view class="menu-item" @tap="go2ScanQrCode">
                    <text class="customicons menu-item-icon">&#xe60a;</text>
                    <text class="text" :style="{ fontSize: fontPx(16) }">扫一扫</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import Config from "../../config.uts";
import store, { contactState } from "../../store.uts";
import WfcScheme from "../../wfcScheme.uts";
import wfc from "../../wfc/client/wfc.uts";
import UserInfo from "../../wfc/model/userInfo.uts";
import Conversation from "../../wfc/model/conversation.uts";
import { pickUsers, PickUsersOptions } from "../../common/picker.uts";
import { go2ConversationPage } from "../../common/nav.uts";
import { fontPx } from "../../common/layoutScale.uts";
import { t, t1 } from "../../i18n/i18n.uts";
import { toast } from "../../common/prompt.uts";

defineOptions({
    name: "MainActionMenu",
    styleIsolation: 'app'
})

const height = ref<number>(0) //距离顶部高度
// 遮罩尺寸用绝对像素给，不用 100%：fixed 节点的百分比在鸿蒙上不一定能解析出来，
// 解析成 0 的话遮罩没有尺寸，点击空白就永远收不到 tap
const maskWidth = ref<number>(0)
const maskHeight = ref<number>(0)
const isActive = ref<boolean>(false)

onMounted(() => {
    const sysInfo = uni.getSystemInfoSync();
    height.value = sysInfo.statusBarHeight;
    maskWidth.value = sysInfo.screenWidth;
    maskHeight.value = sysInfo.screenHeight;
})

const go2CreateGroup = () => {
    hide();
    let users = contactState.favContactList.concat(contactState.friendList);
    users = users.filter((u: UserInfo): boolean => {
        return u.uid != Config.FILE_HELPER_ID
    });
    const options = new PickUsersOptions()
    options.title = t('pick.start_chat')
    options.users = users
    options.successCB = (pickedUsers: UserInfo[]) => {
        store.createConversation(pickedUsers, (conversation: Conversation) => {
            // 不加延时的话，不能正常切换页面
            setTimeout(() => {
                go2ConversationPage();
            }, 50)
        }, (err: number) => {
            console.log('createConversation error', err)
        })
    }
    pickUsers(options);
}

const go2SearchFriend = () => {
    hide();
    uni.navigateTo({
        url: '/pages/contact/SearchUserPage',
        fail: (err) => {
            console.log('nav to SearchUserPage err', err)
        }
    } as NavigateToOptions)
}

const go2ScanQrCode = () => {
    hide();
    uni.scanCode({
        success: (res) => {
            console.log('条码内容：' + res.result);
            if (res.result != '') {
                onScanQrCode(res.result)
            }
        },
        fail: (err) => {
            console.log('scan code err', err)
        }
    } as ScanCodeOptions);
}

// 点在菜单面板上不关闭菜单，只有菜单项自己会关闭
const onMenuTap = () => {
}

const toggle = () => {
    if (isActive.value) {
        hide();
    } else {
        show();
    }
}

const show = () => {
    isActive.value = true
}

const hide = () => {
    if (isActive.value) {
        isActive.value = false
    }
}

/**
 * 扫码结果分支。对齐 flutter `home.dart` 的 `_handleQrCode`：
 * 用户 / 群 / PC 扫码登录 / 频道 / 会议，各走各的页面，识别不了的原样提示。
 *
 * 原来这里只处理用户二维码，其余一律「不支持该二维码」。
 */
const onScanQrCode = (qrcode: string) => {
    const parsed = WfcScheme.parse(qrcode)
    if (parsed == null) {
        toast(t1('qrcode.invalid', qrcode))
        return
    }
    switch (parsed.prefix) {
        case WfcScheme.QR_CODE_PREFIX_USER:
            wfc.getUserInfoEx(parsed.value, false, (userInfo: UserInfo) => {
                store.setCurrentFriend(userInfo);
                uni.navigateTo({
                    url: '/pages/contact/UserDetailPage',
                    fail: (err) => {
                        console.log('nav to UserDetailPage err', err);
                    }
                } as NavigateToOptions)
            }, (err: number) => {
                console.log('getUserInfoEx error', err)
            })
            break;
        case WfcScheme.QR_CODE_PREFIX_GROUP: {
            // from 是邀请人，加群时要带给服务端
            const from = WfcScheme.queryParam(qrcode, 'from')
            uni.navigateTo({
                url: '/pages/conversation/GroupConversationInfoPage?groupId=' + parsed.value + '&from=' + from,
                fail: (err) => {
                    console.log('nav to GroupConversationInfoPage err', err);
                }
            } as NavigateToOptions)
            break;
        }
        case WfcScheme.QR_CODE_PREFIX_PC_SESSION:
            uni.navigateTo({
                url: '/pages/me/PcLoginConfirmPage?token=' + parsed.value,
                fail: (err) => {
                    console.log('nav to PcLoginConfirmPage err', err);
                }
            } as NavigateToOptions)
            break;
        case WfcScheme.QR_CODE_PREFIX_CHANNEL:
            uni.navigateTo({
                url: '/pages/contact/ChannelDetailPage?channelId=' + parsed.value,
                fail: (err) => {
                    console.log('nav to ChannelDetailPage err', err);
                }
            } as NavigateToOptions)
            break;
        case WfcScheme.QR_CODE_PREFIX_CONFERENCE:
            // 会议属于 M7，SDK 侧的会议能力还没接，先如实提示而不是装作能进
            toast(t('qrcode.conference_not_support'))
            break;
        default:
            toast(t1('qrcode.invalid', qrcode))
            break;
    }
}

defineExpose({
    toggle,
    show,
    hide
})
</script>
<style scoped>
.main-action-menu-root {
    position: fixed;
    top: 0;
    left: 0;
    /* width/height 由 :style 以绝对像素给 */
    z-index: 9997;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    /* 鸿蒙上完全透明的节点可能不参与命中测试，用极低的不透明度保证能收到 tap */
    background-color: rgba(0, 0, 0, 0.01);
}

.main-action-menu {
    width: 150px;
    margin-right: 8px;
    display: flex;
    flex-direction: column;
}

.main-action-menu-top-arrow {
    width: 0px;
    height: 0px;
    border-top: 10px solid transparent;
    border-left: 10px solid transparent;
    border-right: 10px solid transparent;
    border-bottom: 10px solid #4C4C4C;
    margin-left: 110px;
}

.menu-list {
    width: 100%;
    background-color: #4C4C4C;
    border-radius: 5px;
}

.menu-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 18px;
    padding-right: 0;
}

.menu-item-icon {
    width: 19px;
    height: 19px;
    margin-right: 14px;
    color: #ffffff;
    font-size: 20px;
}

.text {
    color: #ffffff;
    padding: 15px 0;
    flex: 1;
}

.solid-bottom {
    border-bottom: 1px solid #535353;
}
</style>
