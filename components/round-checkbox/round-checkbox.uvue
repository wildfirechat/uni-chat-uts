<template>
    <view class="round-checkbox" :style="boxStyle">
        <text v-if="checked" class="check-icon" :style="{ color: c.onAccent }">&#xf122;</text>
    </view>
</template>

<script setup lang="uts">

import { colors, AppColors } from "@/common/theme.uts";
/**
 * 圆形复选框，替代内置的方形 checkbox。
 * 内置 checkbox 在各端样式不统一，且无法改成圆形，这里用 view 自绘。
 */
defineOptions({
    name: 'round-checkbox',
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = withDefaults(defineProps<{
    checked?: boolean
    disabled?: boolean
}>(), {
    checked: false,
    disabled: false
})

// 四个状态的底色/描边都要跟主题走，所以合成一个 :style 而不是切 class
const boxStyle = computed<Map<string, string>>((): Map<string, string> => {
    const colorSet = colors()
    let bg = colorSet.surface
    let border = colorSet.hairline
    if (props.disabled) {
        bg = props.checked ? colorSet.textTertiary : colorSet.buttonSecondaryBg
        border = colorSet.hairline
    } else if (props.checked) {
        bg = colorSet.accent
        border = colorSet.accent
    }
    const style = new Map<string, string>()
    style.set('backgroundColor', bg)
    style.set('borderColor', border)
    return style
})
</script>

<style scoped>
.round-checkbox {
    width: 22px;
    height: 22px;
    /* 放在 flex-row 里不能被压扁，否则圆会变成椭圆 */
    flex-shrink: 0;
    border-radius: 11px;
    border-width: 1px;
    border-style: solid;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* 组件引用不到全局 class，字体要在这里自己声明 */
.check-icon {
    font-family: "icomoon";
    font-size: 13px;
    line-height: 13px;
}
</style>
