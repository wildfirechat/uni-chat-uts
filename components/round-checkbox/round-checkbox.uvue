<template>
    <view class="round-checkbox" :class="boxClass">
        <text v-if="checked" class="icomoon check-icon">&#xf122;</text>
    </view>
</template>

<script lang="uts">
/**
 * 圆形复选框，替代内置的方形 checkbox。
 * 内置 checkbox 在各端样式不统一，且无法改成圆形，这里用 view 自绘。
 */
export default {
    name: 'round-checkbox',
    props: {
        checked: {
            type: Boolean,
            default: false
        },
        disabled: {
            type: Boolean,
            default: false
        },
    },
    computed: {
        // uni-app x 不支持 .a.b 这种复合选择器，这里把状态合成一个 class
        boxClass(): string {
            if (this.disabled) {
                return this.checked ? 'box-disabled-checked' : 'box-disabled'
            }
            return this.checked ? 'box-checked' : 'box-normal'
        },
    },
}
</script>

<style scoped>
.round-checkbox {
    width: 22px;
    height: 22px;
    /* 放在 flex-row 里不能被压扁，否则圆会变成椭圆 */
    flex-shrink: 0;
    border-radius: 11px;
    border: 1px solid #d1d1d1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.box-normal {
    background-color: #ffffff;
    border-color: #d1d1d1;
}

/* 主题色，与 pages.json tabBar selectedColor、登录主按钮一致 */
.box-checked {
    background-color: #3B62E0;
    border-color: #3B62E0;
}

.box-disabled {
    background-color: #ebebeb;
    border-color: #dcdcdc;
}

.box-disabled-checked {
    background-color: #c4c4c4;
    border-color: #c4c4c4;
}

.check-icon {
    color: #ffffff;
    font-size: 13px;
    line-height: 13px;
}
</style>
