<template>
    <view class="root">
        <view v-if="items.length == 0 && !loading" class="empty">
            <text :style="{ fontSize: fontPx(FONT_LG), color: c.textTertiary }">{{ t('search.no_result') }}</text>
        </view>
        <scroll-view v-else class="list" direction="vertical" @scrolltolower="loadMore">
            <view class="grid">
                <view v-for="item in items" :key="item.messageUid" class="cell"
                    :style="{ width: cellSize + 'px', height: cellSize + 'px' }" @tap="preview(item)">
                    <image class="thumb" :style="{ backgroundColor: c.sectionGap }" :src="item._thumbnail" mode="aspectFill" />
                    <text v-if="item.isVideo" class="wxfont play-badge" :style="{ color: c.onAccent }">&#xe6a6;</text>
                </view>
            </view>
            <view v-if="hasMore" class="footer">
                <text :style="{ fontSize: fontPx(FONT_SM), color: c.textTertiary }">{{ t('common.loading') }}</text>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
/**
 * 会话图片与视频网格。对齐 flutter `search/conversation_media_grid_screen.dart` 的 ConversationMediaGridView。
 *
 * 三列方形缩略图，滚到底翻页。缩略图优先用消息里的 base64 缩略图（本地就有，不发网络请求），
 * 没有才退回 remotePath。
 *
 * ## 预览
 *
 * 图片和视频走同一个 [PreviewMediaPage](../../pages/misc/PreviewMediaPage.uvue)，
 * 已加载出来的媒体串成一个序列左右滑动，和 flutter 的 `MMPreviewView` 一致
 * （手势细节仍有差异：没有下拉关闭、翻到两端不会继续翻页）。
 *
 * 用 `scroll-view` 而不是 `list-view`：见 [conversation-links](../conversation-links/conversation-links.uvue) 的说明。
 *
 * 方格是**算出来的像素宽高**，不是 `aspect-ratio` —— uni-app x 三端都不支持 aspect-ratio
 * （`node scripts/check-uvue-css.js` 会报），百分比宽也撑不出正方形。
 */
import store, { PreviewMediaItem } from "@/store.uts";
import Config from "@/config.uts";
import Conversation from "@/wfc/model/conversation.uts";
import Message from "@/wfc/messages/message.uts";
import MessageContentType from "@/wfc/messages/messageContentType.uts";
import ImageMessageContent from "@/wfc/messages/imageMessageContent.uts";
import VideoMessageContent from "@/wfc/messages/videoMessageContent.uts";
import { colors, AppColors } from "@/common/theme.uts";
import { fontPx, FONT_SM, FONT_LG } from "@/common/layoutScale.uts";
import { t } from "@/i18n/i18n.uts";

defineOptions({
    name: "conversation-media-grid",
    // 播放角标借全局的 wxfont 字体类，组件默认样式隔离吃不到
    styleIsolation: 'app'
})

const PAGE_SIZE = 30
/** 网格容器左右各留的边距，要和 `.grid` 的 padding 对上 */
const GRID_PADDING = 2

const props = defineProps<{
    conversation: Conversation
}>()

const c = computed<AppColors>((): AppColors => colors())

class MediaItem {
    messageUid = ''
    isVideo = false
    /** 原图/视频地址，预览用 */
    remoteUrl = ''
    /** 网格里显示的缩略图 */
    _thumbnail = ''
    /** 对应的消息，预览页要用它做保存/转发 */
    message: Message | null = null
}

/** 三列方格的边长：(屏宽 - 容器左右 padding) / 3，随屏幕宽度算一次。 */
const cellSize = ref<number>(0)

const items = ref<MediaItem[]>([] as MediaItem[])
const loading = ref<boolean>(false)
const hasMore = ref<boolean>(true)

let offset = 0

const toItem = (message: Message): MediaItem => {
    const item = new MediaItem()
    item.messageUid = message.messageUid
    item.message = message
    const content = message.messageContent
    let thumbnail = ''
    if (content instanceof VideoMessageContent) {
        const c = content as VideoMessageContent
        item.isVideo = true
        item.remoteUrl = c.remotePath
        thumbnail = c.thumbnail
    } else if (content instanceof ImageMessageContent) {
        const c = content as ImageMessageContent
        item.remoteUrl = c.remotePath
        thumbnail = c.thumbnail
    }
    if (thumbnail != '') {
        item._thumbnail = 'data:image/jpeg;base64,' + thumbnail
    } else if (item.remoteUrl != '') {
        item._thumbnail = item.remoteUrl
    } else {
        item._thumbnail = Config.DEFAULT_THUMBNAIL_URL
    }
    return item
}

const load = () => {
    if (loading.value || !hasMore.value) {
        return
    }
    loading.value = true
    const messages = store.getMessagesInTypesAndTimes(props.conversation as Conversation,
        [MessageContentType.Image, MessageContentType.Video], 0, new Date().getTime(), PAGE_SIZE, offset)
    const page: MediaItem[] = []
    for (let i = 0; i < messages.length; i++) {
        page.push(toItem(messages[i]))
    }
    items.value = items.value.concat(page)
    offset += messages.length
    hasMore.value = messages.length >= PAGE_SIZE
    loading.value = false
}

const loadMore = () => {
    load()
}

const preview = (item: MediaItem) => {
    if (item.remoteUrl == '') {
        return
    }
    // 已加载的图片和视频串成一组，支持左右滑动切换（与会话页媒体气泡的行为一致）
    const medias: PreviewMediaItem[] = []
    // 显式标 number：数组 length 在 android 上是 Int，不标类型后面参与 Number 运算会不匹配
    let current: number = 0
    const list = items.value
    for (let i = 0; i < list.length; i++) {
        const it = list[i]
        if (it.remoteUrl == '') {
            continue
        }
        if (it.messageUid == item.messageUid) {
            current = medias.length
        }
        medias.push(new PreviewMediaItem(it.remoteUrl, it._thumbnail, true, it.isVideo, it.message))
    }
    store.previewMedias(medias, current)
}

onMounted(() => {
    const windowInfo = uni.getWindowInfo()
    cellSize.value = Math.floor((windowInfo.windowWidth - GRID_PADDING * 2) / 3)
    load()
})
</script>

<style scoped>
.wxfont {
    font-family: "wxfont";
}

.root {
    width: 100%;
    flex: 1;
    display: flex;
    flex-direction: column;
}

.list {
    flex: 1;
}

.empty {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
}

.grid {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    padding: 2px;
}

/* 三列，宽高由 JS 算好后走 :style 下发 */
.cell {
    padding: 2px;
    position: relative;
}

.thumb {
    width: 100%;
    height: 100%;
}

.play-badge {
    position: absolute;
    right: 8px;
    bottom: 8px;
    font-size: 20px;
}

.footer {
    width: 100%;
    padding: 16px 0;
    display: flex;
    align-items: center;
    justify-content: center;
}
</style>
