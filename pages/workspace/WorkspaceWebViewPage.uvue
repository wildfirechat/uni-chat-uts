<template>
    <web-view id="workspace-child-webview" class="webview" :src="url" @message="onPostMessage" @loaded="onLoaded"></web-view>
</template>

<script lang="uts">
import { WorkspaceBridge } from './bridgeServerImpl.uts'

export default {
    name: "WorkspaceWebViewPage",
    data() {
        return {
            url: '',
            bridge: new WorkspaceBridge(),
        }
    },

    onLoad(options: OnLoadOptions) {
        const url = options['url'] ?? ''
        console.log('onLoad option url', decodeURIComponent(url));
        this.url = decodeURIComponent(url) ?? '';
    },

    onReady() {
        const webviewContext = uni.createWebviewContext('workspace-child-webview', this)
        this.bridge.init(webviewContext);
    },

    methods: {
        onPostMessage(event: UniWebViewMessageEvent) {
            const dataArr = event.detail.data
            if (dataArr.length > 0) {
                const obj = dataArr[0].getString('obj')
                if (obj != null) {
                    this.bridge.messageFromWebView(obj)
                }
            }
        },
        onLoaded(_event: UniWebViewLoadEvent) {
            // uni-app x 暂无 receivedtitle 事件，标题保持 pages.json 配置
        }
    }
}
</script>

<style scoped>
.webview {
    flex: 1;
}
</style>
