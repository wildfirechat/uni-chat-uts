<template>
    <web-view id="workspace-child-webview" class="webview" :src="url" @message="onPostMessage" @loaded="onLoaded"></web-view>
</template>

<script setup lang="uts">
import { WorkspaceBridge } from './bridgeServerImpl.uts'
import { webViewMessageObjs } from './webViewMessage.uts'

const url = ref<string>('')
const bridge = ref<WorkspaceBridge>(new WorkspaceBridge())

onLoad((options: OnLoadOptions) => {
    const urlValue = options['url'] ?? ''
    console.log('onLoad option url', decodeURIComponent(urlValue));
    url.value = decodeURIComponent(urlValue) ?? '';
})

onReady(() => {
    const webviewContext = uni.createWebviewContext('workspace-child-webview', getCurrentInstance()!.proxy!)
    bridge.value.init(webviewContext);
})

const onPostMessage = (event: UniWebViewMessageEvent) => {
    webViewMessageObjs(event).forEach((obj: string) => {
        bridge.value.messageFromWebView(obj)
    })
}

const onLoaded = (_event: UniWebViewLoadEvent) => {
    // uni-app x 暂无 receivedtitle 事件，标题保持 pages.json 配置
}
</script>

<style scoped>
.webview {
    flex: 1;
}
</style>
