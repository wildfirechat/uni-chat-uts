<template>
    <list-item v-for="(item, itemIndex) in visibleFlatItems" :key="itemIndex" class="user-row-item">
        <view v-if="item.isLabel" class="label" :style="{ paddingLeft: paddingLeft }">
            <text class="label-text">{{ item.category.toUpperCase() }}</text>
        </view>
        <view v-else class="content" :style="{ paddingLeft: paddingLeft }" @tap="clickUserItem(item.user as UserInfo)">
            <image class="avatar" :src="(item.user as UserInfo).portrait" />
            <view class="name-container">
                <text class="single-line user-name">{{ displayNameOf(item.user as UserInfo) }}</text>
                <text v-if="(item.user as UserInfo)._userOnlineStatusDesc != ''" class="single-line user-online-status">{{ (item.user as UserInfo)._userOnlineStatusDesc }}</text>
            </view>
        </view>
    </list-item>
    <list-item v-if="hasMore" class="loading-row" @appear="appendNextBatch" @tap="appendNextBatch">
        <text class="loading-text">加载中...</text>
    </list-item>
</template>

<script setup lang="uts">
import store from "../../store.uts";
import UserInfo from "../../wfc/model/userInfo.uts";

class FlatUserListItem {
    category = ''
    isLabel = false
    user: UserInfo | null = null
}

defineOptions({
    name: "UserListView"
})

const props = withDefaults(defineProps<{
    users: UserInfo[]
    showCategoryLabel?: boolean
    // 为 true 时点击项时触发 userClick 事件，否则默认跳转用户详情
    emitClickEvent?: boolean
    paddingLeft?: string
}>(), {
    showCategoryLabel: true,
    emitClickEvent: false,
    paddingLeft: '5px'
})

const emit = defineEmits(['userClick'])

const INITIAL_RENDER_USER_COUNT = 180
const RENDER_BATCH_USER_COUNT = 220

const renderUserCount = ref<number>(0)

const hasMore = computed<boolean>((): boolean => {
    return renderUserCount.value < props.users.length
})

const displayNameOf = (user: UserInfo): string => {
    if (user._displayName != '') {
        return user._displayName
    }
    if (user.friendAlias != '') {
        return user.friendAlias
    }
    if (user.displayName != '') {
        return user.displayName
    }
    return '用户'
}

const visibleFlatItems = computed<FlatUserListItem[]>((): FlatUserListItem[] => {
    const items: FlatUserListItem[] = []
    const total = renderUserCount.value < props.users.length ? renderUserCount.value : props.users.length
    let lastCategory = ''

    for (let i = 0; i < total; i++) {
        const user = props.users[i]
        const category = user._category
        if (props.showCategoryLabel && lastCategory != category) {
            lastCategory = category
            const label = new FlatUserListItem()
            label.category = category
            label.isLabel = true
            items.push(label)
        }

        const row = new FlatUserListItem()
        row.category = category
        row.user = user
        items.push(row)
    }
    return items
})

const appendNextBatch = () => {
    if (!hasMore.value) {
        return
    }
    const next = renderUserCount.value + RENDER_BATCH_USER_COUNT
    renderUserCount.value = next < props.users.length ? next : props.users.length
}

const resetRenderWindow = () => {
    if (props.users.length == 0) {
        renderUserCount.value = 0
        return
    }
    renderUserCount.value = props.users.length < INITIAL_RENDER_USER_COUNT ? props.users.length : INITIAL_RENDER_USER_COUNT
}

watch(() => props.users, (_newValue, _oldValue) => {
    resetRenderWindow()
}, { immediate: true })

watch(() => props.showCategoryLabel, (_newValue, _oldValue) => {
    resetRenderWindow()
})

const clickUserItem = (user: UserInfo) => {
    if (props.emitClickEvent) {
        emit('userClick', user);
    } else {
        store.setCurrentFriend(user)
        uni.navigateTo({
            url: '/pages/contact/UserDetailPage',
            fail: (err) => {
                console.log('nav to UserDetailPage err', err);
            }
        } as NavigateToOptions);
    }
}
</script>

<style scoped>
.user-list {
    width: 100%;
}

.user-row-item {
    background-color: #ffffff;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 3px;
}

.label {
    width: 100%;
    background-color: #fafafa;
}

.label-text {
    padding: 5px 5px 5px 0;
    font-size: 13px;
    color: #333333;
}

.content {
    padding: 10px 5px 10px 0;
    display: flex;
    flex-direction: row;
    width: 100%;
    align-items: center;
    position: relative;
    border-bottom: 1px solid #f4f4f4;
}

.name-container {
    padding-left: 10px;
    flex: 1;
}

/* 不要叫 .name：其他页面也有 .name，scoped 没能隔离住 */
.user-name {
    font-size: 15px;
    text-align: left;
}

.user-online-status {
    color: #808080;
    font-size: 10px;
    text-align: left;
}

.loading-row {
    height: 40px;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
}

.loading-text {
    color: #808080;
    font-size: 12px;
}
</style>
