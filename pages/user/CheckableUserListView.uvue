<template>
    <list-item v-for="(item, itemIndex) in visibleFlatItems" :key="itemIndex" class="checkable-user-row-item">
        <view v-if="item.isLabel" class="label" :style="{ paddingLeft: paddingLeft }">
            <text class="label-text">{{ item.category.toUpperCase() }}</text>
        </view>
        <view v-else class="content" :style="{ paddingLeft: paddingLeft }" :class="{ disabled: isUserUncheckable(item.user as UserInfo) }"
            @tap="clickUserItem(item.user as UserInfo)">
            <round-checkbox class="checkbox" :disabled="isUserUncheckable(item.user as UserInfo)" :checked="isUserChecked(item.user as UserInfo)" />
            <image class="avatar" :src="(item.user as UserInfo).portrait" />
            <text class="user-name single-line">{{ displayNameOf(item.user as UserInfo) }}</text>
        </view>
    </list-item>
    <list-item v-if="hasMore" class="loading-row" @appear="appendNextBatch" @tap="appendNextBatch">
        <text class="loading-text">加载中...</text>
    </list-item>
</template>

<script setup lang="uts">
import store, { pickState } from "../../store.uts";
import UserInfo from "../../wfc/model/userInfo.uts";

class FlatUserListItem {
    category = ''
    isLabel = false
    user: UserInfo | null = null
}

defineOptions({
    name: "CheckableUserListView",
    styleIsolation: 'app'
})

const props = withDefaults(defineProps<{
    users: UserInfo[]
    initialCheckedUsers?: UserInfo[]
    uncheckableUsers?: UserInfo[]
    showCategoryLabel?: boolean
    paddingLeft?: string
}>(), {
    initialCheckedUsers: (): UserInfo[] => [] as UserInfo[],
    uncheckableUsers: (): UserInfo[] => [] as UserInfo[],
    showCategoryLabel: true,
    paddingLeft: '5px'
})

const displayNameOf = (user: UserInfo): string => {
    if (user._displayName != '') {
        return user._displayName
    }
    if (user.groupAlias != '') {
        return user.groupAlias
    }
    if (user.friendAlias != '') {
        return user.friendAlias
    }
    if (user.displayName != '') {
        return user.displayName
    }
    return '用户'
}

const clickUserItem = (user: UserInfo) => {
    if (isUserUncheckable(user)) {
        return;
    }
    store.pickOrUnpickUser(user)
}

const isUserUncheckable = (user: UserInfo): boolean => {
    return props.uncheckableUsers.findIndex((u: UserInfo): boolean => u.uid == user.uid) >= 0;
}

const isUserChecked = (user: UserInfo): boolean => {
    return store.isUserPicked(user);
}

const INITIAL_RENDER_USER_COUNT = 180
const RENDER_BATCH_USER_COUNT = 220

const renderUserCount = ref<number>(0)

const hasMore = computed<boolean>((): boolean => {
    return renderUserCount.value < props.users.length
})

const visibleFlatItems = computed<FlatUserListItem[]>((): FlatUserListItem[] => {
    const items: FlatUserListItem[] = []
    const total = renderUserCount.value < props.users.length ? renderUserCount.value : props.users.length
    let lastCategory = ''

    for (let i = 0; i < total; i++) {
        const user = props.users[i]
        const category = user._category
        if (props.showCategoryLabel && lastCategory != category) {
            lastCategory = category
            const label = new FlatUserListItem()
            label.category = category
            label.isLabel = true
            items.push(label)
        }

        const row = new FlatUserListItem()
        row.category = category
        row.user = user
        items.push(row)
    }
    return items
})

const appendNextBatch = () => {
    if (!hasMore.value) {
        return
    }
    const next = renderUserCount.value + RENDER_BATCH_USER_COUNT
    renderUserCount.value = next < props.users.length ? next : props.users.length
}

const resetRenderWindow = () => {
    if (props.users.length == 0) {
        renderUserCount.value = 0
        return
    }
    renderUserCount.value = props.users.length < INITIAL_RENDER_USER_COUNT ? props.users.length : INITIAL_RENDER_USER_COUNT
}

watch(() => props.users, (_newValue, _oldValue) => {
    resetRenderWindow()
}, { immediate: true })

watch(() => props.showCategoryLabel, (_newValue, _oldValue) => {
    resetRenderWindow()
})

onMounted(() => {
    if (props.initialCheckedUsers.length > 0) {
        const oriCUs = props.users.filter((u: UserInfo): boolean => props.initialCheckedUsers.findIndex((iu: UserInfo): boolean => iu.uid == u.uid) > -1);
        for (let i = 0; i < oriCUs.length; i++) {
            store.pickOrUnpickUser(oriCUs[i])
        }
    }
})
</script>

<style scoped>
.checkable-user-row-item {
    background-color: #ffffff;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 3px;
}

.checkbox {
    margin-right: 10px;
}

.label {
    width: 100%;
    background-color: #fafafa;
}

.label-text {
    padding: 5px 5px 5px 0;
    font-size: 13px;
}

.content {
    padding: 5px 5px 5px 0;
    display: flex;
    flex-direction: row;
    width: 100%;
    align-items: center;
}

/* 不要叫 .name：PickUserPage 里也有个 .name 是 text-align: center 的，scoped 没能隔离住 */
.user-name {
    margin-left: 10px;
    font-size: 14px;
    flex: 1;
    text-align: left;
}

.disabled {
    opacity: 0.6;
}

.loading-row {
    height: 40px;
    align-items: center;
    justify-content: center;
    background-color: #ffffff;
}

.loading-text {
    color: #808080;
    font-size: 12px;
}
</style>
