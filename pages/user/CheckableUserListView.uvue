<template>
    <list-item v-for="(item, itemIndex) in visibleFlatItems" :key="itemIndex" :id="item.anchorId"
        class="checkable-user-row-item">
        <view v-if="item.isLabel" class="label" :style="{ paddingLeft: paddingLeft, backgroundColor: c.sectionGap }">
            <text class="label-text" :class="fs13" :style="{ color: c.textSecondary, paddingRight: paddingRight }">{{ item.category.toUpperCase() }}</text>
        </view>
        <view v-else class="content" :style="{ paddingLeft: paddingLeft, paddingRight: paddingRight, backgroundColor: c.surface }"
            :class="{ disabled: isUserUncheckable(item.user as UserInfo) }"
            :hover-class="isUserUncheckable(item.user as UserInfo) ? '' : pressedClass" hover-stay-time="80"
            @tap="clickUserItem(item.user as UserInfo)">
            <round-checkbox class="checkbox" :disabled="isUserUncheckable(item.user as UserInfo)" :checked="isUserChecked(item.user as UserInfo)" />
            <image class="avatar" :src="(item.user as UserInfo).portrait" :style="{ backgroundColor: c.inputBg }" />
            <text class="user-name single-line" :class="fs14" :style="{ color: c.textPrimary }">{{ displayNameOf(item.user as UserInfo) }}</text>
        </view>
    </list-item>
    <list-item v-if="hasMore" class="loading-row" @appear="appendNextBatch" @tap="appendNextBatch">
        <text class="loading-text" :class="fs12" :style="{ color: c.textSecondary }">加载中...</text>
    </list-item>
</template>

<script setup lang="uts">
import store, { pickState } from "../../store.uts";
import UserInfo from "../../wfc/model/userInfo.uts";

import { colors, AppColors, pressedRowClass } from "@/common/theme.uts";
import { fontClass } from "@/common/layoutScale.uts";
import { anchorIdForCategory } from "@/common/pinyin.uts";
class FlatUserListItem {
    category = ''
    /** 分类标签行的锚点 id，供外层 list-view 的 scroll-into-view 用；用户行为空串 */
    anchorId = ''
    isLabel = false
    user: UserInfo | null = null
}

defineOptions({
    name: "CheckableUserListView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const pressedClass = computed<string>((): string => pressedRowClass())

// list-item 内部字号只能切静态 class，不能走 :style，见 common/layoutScale.uts
const fs12 = computed<string>((): string => fontClass(12))
const fs13 = computed<string>((): string => fontClass(13))
const fs14 = computed<string>((): string => fontClass(14))
const props = withDefaults(defineProps<{
    users: UserInfo[]
    initialCheckedUsers?: UserInfo[]
    uncheckableUsers?: UserInfo[]
    showCategoryLabel?: boolean
    paddingLeft?: string
    /** 页面右侧压着字母索引条时传 '32px'，否则长昵称会钻到字母下面 */
    paddingRight?: string
    /**
     * 非空时给分类标签行加上 `anchorPrefix + 归一化后的分类名` 作为 id，
     * 外层用 list-view 的 scroll-into-view 跳转（右侧字母索引条要用）。
     * 归一化规则必须与调用方一致，见 [anchorIdForCategory]。
     */
    anchorPrefix?: string
    /** 最多可勾选人数；超出时不勾上并回调 maxExceeded，由页面提示 */
    maxCheckedCount?: number
}>(), {
    initialCheckedUsers: (): UserInfo[] => [] as UserInfo[],
    uncheckableUsers: (): UserInfo[] => [] as UserInfo[],
    showCategoryLabel: true,
    paddingLeft: '5px',
    paddingRight: '5px',
    anchorPrefix: '',
    maxCheckedCount: 1024
})

const emit = defineEmits(['maxExceeded'])

const displayNameOf = (user: UserInfo): string => {
    if (user._displayName != '') {
        return user._displayName
    }
    if (user.groupAlias != '') {
        return user.groupAlias
    }
    if (user.friendAlias != '') {
        return user.friendAlias
    }
    if (user.displayName != '') {
        return user.displayName
    }
    return '用户'
}

const isUserUncheckable = (user: UserInfo): boolean => {
    const uncheckableUsers = props.uncheckableUsers as UserInfo[]
    return uncheckableUsers.findIndex((u: UserInfo): boolean => u.uid == user.uid) >= 0;
}

const isUserChecked = (user: UserInfo): boolean => {
    return store.isUserPicked(user);
}

const clickUserItem = (user: UserInfo) => {
    if (isUserUncheckable(user)) {
        return;
    }
    // 只有「从未选到选中」这一个方向要卡上限，取消勾选任何时候都放行
    if (!isUserChecked(user) && pickState.users.length >= props.maxCheckedCount) {
        emit('maxExceeded')
        return
    }
    store.pickOrUnpickUser(user)
}

const INITIAL_RENDER_USER_COUNT = 180
const RENDER_BATCH_USER_COUNT = 220
// 索引条跳到某分类时，连带把那一段往后多渲染一批，免得跳过去只有一个标签行
const QUICK_INDEX_PRELOAD_COUNT = 120

const renderUserCount = ref<number>(0)

const hasMore = computed<boolean>((): boolean => {
    const users = props.users as UserInfo[]
    return renderUserCount.value < users.length
})

const visibleFlatItems = computed<FlatUserListItem[]>((): FlatUserListItem[] => {
    const users = props.users as UserInfo[]
    const items: FlatUserListItem[] = []
    const total = renderUserCount.value < users.length ? renderUserCount.value : users.length
    let lastCategory = ''

    for (let i = 0; i < total; i++) {
        const user = users[i]
        const category = user._category
        if (props.showCategoryLabel && lastCategory != category) {
            lastCategory = category
            const label = new FlatUserListItem()
            label.category = category
            label.isLabel = true
            if (props.anchorPrefix != '') {
                label.anchorId = anchorIdForCategory(props.anchorPrefix, category)
            }
            items.push(label)
        }

        const row = new FlatUserListItem()
        row.category = category
        row.user = user
        items.push(row)
    }
    return items
})

const appendNextBatch = () => {
    if (!hasMore.value) {
        return
    }
    const users = props.users as UserInfo[]
    const next = renderUserCount.value + RENDER_BATCH_USER_COUNT
    renderUserCount.value = next < users.length ? next : users.length
}

const resetRenderWindow = () => {
    const users = props.users as UserInfo[]
    if (users.length == 0) {
        renderUserCount.value = 0
        return
    }
    renderUserCount.value = users.length < INITIAL_RENDER_USER_COUNT ? users.length : INITIAL_RENDER_USER_COUNT
}

watch((): UserInfo[] => props.users, (_newValue: UserInfo[], _oldValue: UserInfo[]) => {
    resetRenderWindow()
}, { immediate: true })

watch((): boolean => props.showCategoryLabel, (_newValue: boolean, _oldValue: boolean) => {
    resetRenderWindow()
})

/**
 * 保证 [category] 这一段已经渲染出来 —— 分批渲染下，还没进渲染窗口的分类
 * 根本没有锚点节点，scroll-into-view 会静默失败。
 * 索引条跳转前先调它，同 ContactListPage 的 QUICK_INDEX_PRELOAD_COUNT 处理。
 */
const ensureCategoryRendered = (category: string) => {
    const users = props.users as UserInfo[]
    let firstIndex = -1
    for (let i = 0; i < users.length; i++) {
        if (users[i]._category == category) {
            firstIndex = i
            break
        }
    }
    if (firstIndex < 0) {
        return
    }
    const need = firstIndex + QUICK_INDEX_PRELOAD_COUNT
    const target = need < users.length ? need : users.length
    if (target > renderUserCount.value) {
        renderUserCount.value = target
    }
}

defineExpose({
    ensureCategoryRendered
})

onMounted(() => {
    const users = props.users as UserInfo[]
    const initialCheckedUsers = props.initialCheckedUsers as UserInfo[]
    if (initialCheckedUsers.length > 0) {
        const oriCUs = users.filter((u: UserInfo): boolean => initialCheckedUsers.findIndex((iu: UserInfo): boolean => iu.uid == u.uid) > -1);
        for (let i = 0; i < oriCUs.length; i++) {
            store.pickOrUnpickUser(oriCUs[i])
        }
    }
})
</script>

<style scoped>
/* 底色画在内层 label/content 上：list-item 走复用渲染，不给它动态绑定 */
.avatar {
    width: 40px;
    height: 40px;
    border-radius: 3px;
}

.checkbox {
    margin-right: 10px;
}

.label {
    width: 100%;
}

/* 右侧内边距由 paddingRight 走 :style 覆盖，这里只留上下与左侧 */
.label-text {
    padding: 5px 0 5px 0;
}

.content {
    padding: 5px 0 5px 0;
    display: flex;
    flex-direction: row;
    width: 100%;
    align-items: center;
}

/* 不要叫 .name：PickUserPage 里也有个 .name 是 text-align: center 的，scoped 没能隔离住 */
.user-name {
    margin-left: 10px;
    flex: 1;
    text-align: left;
}

.disabled {
    opacity: 0.6;
}

.loading-row {
    height: 40px;
    align-items: center;
    justify-content: center;
}

</style>
