<template>
    <view class="voip-page" v-if="session != null">
        <!--audio-->
        <view v-if="audioOnly" class="content-container">
            <view class="local-media-container local-corner">
                <image class="avatar avatar-small" :src="selfUserInfo.portrait" />
            </view>
            <view class="remote-media-container">
                <image class="avatar avatar-large" :src="participantUserInfo.portrait" />
                <text class="desc" :style="{ fontSize: fontPx(15) }">{{ participantUserInfo.displayName }}</text>
                <text class="desc" :style="{ fontSize: fontPx(15) }" v-if="callState == 1">等待对方接听</text>
                <text class="desc" :style="{ fontSize: fontPx(15) }" v-else-if="callState == 2">邀请你语音聊天</text>
                <text class="desc" :style="{ fontSize: fontPx(15) }" v-else-if="callState == 3">接听中...</text>
            </view>
        </view>

        <!--video-->
        <view v-else class="content-container">
            <view class="remote-media-container">
                <native-view v-if="callState == 4" class="video" @init="onRemoteVideoViewInit"
                    @tap="switchVideoType"></native-view>
                <view v-if="callState != 4" class="remote-placeholder">
                    <image class="avatar avatar-large" :src="participantUserInfo.portrait" />
                    <text class="desc" :style="{ fontSize: fontPx(15) }">{{ participantUserInfo.displayName }}</text>
                    <text class="desc" :style="{ fontSize: fontPx(15) }" v-if="callState == 1">等待对方接听</text>
                    <text class="desc" :style="{ fontSize: fontPx(15) }" v-else-if="callState == 2">邀请你视频聊天</text>
                    <text class="desc" :style="{ fontSize: fontPx(15) }" v-else-if="callState == 3">接听中...</text>
                </view>
            </view>
            <view class="local-media-container" :class="callState == 4 ? 'local-corner-connected' : 'local-corner'">
                <native-view v-if="callState == 4 && !videoMuted" class="localVideo"
                    @init="onLocalVideoViewInit"></native-view>
                <image v-else class="avatar" :class="callState == 4 ? 'avatar-muted' : 'avatar-small'"
                    :src="selfUserInfo.portrait" />
            </view>
        </view>

        <!--incoming-->
        <view v-if="callState == 2" class="action-container">
            <view class="action" @tap="hangup">
                <image class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">挂断</text>
            </view>
            <view class="action" @tap="answer">
                <image class="action-img" src="/static/image/av/av_video_answer.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">接听</text>
            </view>
        </view>

        <!--outgoing / connecting-->
        <view v-if="callState == 1 || callState == 3" class="action-container">
            <view class="action" @tap="hangup">
                <image class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">挂断</text>
            </view>
        </view>

        <!--connected-->
        <view v-if="callState == 4" class="action-container">
            <view class="action" @tap="mute">
                <image v-if="!audioMuted" class="action-img" src="/static/image/av/av_mute.png" />
                <image v-else class="action-img" src="/static/image/av/av_mute_hover.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">静音</text>
            </view>
            <view v-if="!audioOnly" class="action" @tap="switchCamera">
                <image class="action-img" src="/static/image/av/av_camera.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">切换摄像头</text>
            </view>
            <view class="action" @tap="hangup">
                <image class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">挂断</text>
            </view>
        </view>

        <view class="voip-title-container">
            <text class="duration-text" :style="{ fontSize: fontPx(15) }" v-if="callState == 4">{{ duration }}</text>
            <view class="title-action" @tap="minimize">
                <image class="minimize-img" src="/static/image/av/av_minimize.png" />
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import avEngineKit from "@/wfc/av/engine/avEngineKit.uts";
import CallSessionCallback from "@/wfc/av/engine/callSessionCallback.uts";
import CallSession from "@/wfc/av/engine/callSession.uts";
import CallState from "@/wfc/av/engine/callState.uts";
import VideoType from "@/wfc/av/engine/videoType.uts";
import checkVoipPermissions from "@/wfc/av/voipUtil.uts";
import { getUserInfo } from "@/wfc/client/userBrief.uts";
import wfc from "@/wfc/client/wfc.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import { takePageOptions } from "@/common/nav.uts";
import { fontPx } from "@/common/layoutScale.uts";

defineOptions({
    name: "Single"
})

const session = ref<CallSession | null>(null as CallSession | null)
const audioOnly = ref<boolean>(false)
const audioMuted = ref<boolean>(false)
const videoMuted = ref<boolean>(false)
const callState = ref<number>(0)
const startTimestamp = ref<number>(0)
const currentTimestamp = ref<number>(0)
const timer = ref<number>(0)
const localVideoElement = ref<UniNativeViewElement | null>(null as UniNativeViewElement | null)
const remoteVideoElement = ref<UniNativeViewElement | null>(null as UniNativeViewElement | null)

const participantUserInfo = computed<UserInfo>((): UserInfo => {
    const callSession = session.value
    if (callSession == null) {
        return new UserInfo()
    }
    return getUserInfo(callSession.conversation.target, false)
})
const selfUserInfo = computed<UserInfo>((): UserInfo => {
    return getUserInfo(wfc.getUserId(), false)
})
const duration = computed<string>((): string => {
    if (currentTimestamp.value <= 0) {
        return '00:00'
    }
    const elapsed = Math.floor((currentTimestamp.value - startTimestamp.value) / 1000)
    const min = Math.floor(elapsed / 60)
    const sec = elapsed % 60
    const minStr = min < 10 ? ('0' + min) : ('' + min)
    const secStr = sec < 10 ? ('0' + sec) : ('' + sec)
    return minStr + ':' + secStr
})

const setupLocalVideoView = () => {
    const callSession = session.value
    const element = localVideoElement.value
    if (callSession == null || element == null) {
        return
    }
    avEngineKit.setLocalVideoView(callSession.callId, element)
}

const setupRemoteVideoView = () => {
    const callSession = session.value
    const element = remoteVideoElement.value
    if (callSession == null || element == null) {
        return
    }
    avEngineKit.setRemoteVideoView(callSession.callId, callSession.conversation.target, element)
}

const onVoipConnected = () => {
    if (timer.value == 0) {
        if (startTimestamp.value == 0) {
            startTimestamp.value = new Date().getTime()
        }
        timer.value = setInterval((): void => {
            currentTimestamp.value = new Date().getTime()
        }, 1000)
    }
    if (!audioOnly.value) {
        setTimeout((): void => {
            setupLocalVideoView()
            setupRemoteVideoView()
        }, 100)
    }
}

const setupSessionCallback = () => {
    const callback = new CallSessionCallback()
    callback.didChangeState = (state: number): void => {
        callState.value = state
        if (state == CallState.STATUS_CONNECTED) {
            onVoipConnected()
        } else if (state == CallState.STATUS_IDLE) {
            if (timer.value != 0) {
                clearInterval(timer.value)
                timer.value = 0
            }
        }
    }
    callback.didChangeMode = (isAudioOnly: boolean): void => {
        audioOnly.value = isAudioOnly
    }
    callback.didReceiveRemoteVideoTrack = (_userId: string, _screenSharing: boolean): void => {
        if (session.value == null) {
            return
        }
        setupRemoteVideoView()
    }
    callback.didCallEndWithReason = (_reason: number): void => {
        session.value = null
    }
    callback.didVideoMuted = (userId: string, muted: boolean): void => {
        if (userId == wfc.getUserId()) {
            videoMuted.value = muted
            if (!muted) {
                nextTick((): void => {
                    setupLocalVideoView()
                })
            }
        } else if (!muted) {
            nextTick((): void => {
                setupRemoteVideoView()
            })
        }
    }
    avEngineKit.setSessionCallback(callback)
}

// native-view 创建后（v-if 首次满足或重新满足时）触发，元素随即用于挂载视频画面
const onLocalVideoViewInit = (e: UniNativeViewInitEvent) => {
    localVideoElement.value = e.detail.element
    setupLocalVideoView()
}

const onRemoteVideoViewInit = (e: UniNativeViewInitEvent) => {
    remoteVideoElement.value = e.detail.element
    setupRemoteVideoView()
}

const switchVideoType = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.setParticipantVideoType(callSession.callId, callSession.conversation.target, false, VideoType.BIG_STREAM)
}

const answer = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    checkVoipPermissions(audioOnly.value).then((granted: boolean): void => {
        if (!granted) {
            return
        }
        avEngineKit.answerCall(callSession.callId, false)
    })
}

const hangup = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.endCall(callSession.callId)
    session.value = null
}

const switchCamera = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.switchCamera(callSession.callId)
}

const mute = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    audioMuted.value = !audioMuted.value
    avEngineKit.muteAudio(callSession.callId, audioMuted.value)
}

const minimize = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    if (avEngineKit.checkOverlayPermission()) {
        avEngineKit.minimize(callSession.callId)
        uni.navigateBack({
            delta: 1,
            fail: (err) => {
                console.log('nav back err', err)
            }
        } as NavigateBackOptions)
    } else {
        uni.showToast({
            title: '需要悬浮窗权限',
            icon: 'none',
        } as ShowToastOptions)
    }
}

onLoad((_options: OnLoadOptions) => {
    const pageOptions = takePageOptions()
    if (pageOptions != null && pageOptions instanceof CallSession) {
        const callSession = pageOptions as CallSession
        session.value = callSession
        callState.value = callSession.state
        audioOnly.value = callSession.audioOnly
        if (callSession.connectedTime > 0) {
            startTimestamp.value = callSession.connectedTime
        }
    }
})

onMounted(() => {
    const curSession = avEngineKit.currentCallSession()
    if (curSession == null || curSession.state == CallState.STATUS_IDLE) {
        uni.navigateBack({
            delta: 1,
            fail: (err) => {
                console.log('nav back err', err)
            }
        } as NavigateBackOptions)
        return
    }
    session.value = curSession
    callState.value = curSession.state
    audioOnly.value = curSession.audioOnly
    audioMuted.value = curSession.audioMuted
    videoMuted.value = curSession.videoMuted

    setupSessionCallback()

    if (callState.value == CallState.STATUS_CONNECTED) {
        onVoipConnected()
    }
})

onBackPress((event: OnBackPressOptions): boolean => {
    // minimize 触发的返回，不阻止；其他情况（手势/物理返回键）阻止直接退出通话页面
    return event.from != 'navigateBack'
})

onBeforeUnmount(() => {
    if (timer.value != 0) {
        clearInterval(timer.value)
        timer.value = 0
    }
})
</script>

<style scoped>
/* 顶部标题栏、底部操作栏都用 padding 给它们留出真实空间，不要让 content-container 铺满整页、
 * 再把两个栏绝对定位盖在上面：Android 上视频用的 native-view 是真正的原生 View（内部是 SurfaceView），
 * 画在页面画布之上，会把压在它下面的按钮挡住（音频通话没有 native-view，则是 content-container
 * 把点击吞掉，按钮看得见点不动）。鸿蒙渲染层级不同所以看不出问题。与 ConferencePage 的做法保持一致。
 * 绝对定位的子节点按 border box 定位（不受父节点 padding 影响），所以两个栏正好落在留白里。 */
.voip-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    padding-top: 132rpx;
    padding-bottom: 140px;
    background-color: #292929;
}

.content-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
}

.remote-media-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.remote-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.video {
    flex: 1;
    width: 750rpx;
}

.avatar {
    border-radius: 4px;
}

.avatar-large {
    width: 200px;
    height: 200px;
    border-radius: 6px;
}

.avatar-small {
    width: 60px;
    height: 60px;
}

.avatar-muted {
    width: 150px;
    height: 200px;
    border-radius: 6px;
}

.desc {
    color: #ffffff;
    padding: 5px 0;
}

.local-media-container {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
}

.local-corner {
    top: 88rpx;
    left: 20px;
}

.local-corner-connected {
    top: 88rpx;
    right: 20px;
}

.localVideo {
    width: 150px;
    height: 200px;
    border-radius: 6px;
}

.action-container {
    width: 750rpx;
    height: 140px;
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
    align-items: center;
}

.action {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
}

.action-img {
    width: 60px;
    height: 60px;
}

.action-desc {
    color: #ffffff;
    padding-top: 5px;
}

.voip-title-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 750rpx;
    z-index: 2;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 44rpx;
    height: 88rpx;
}

.duration-text {
    color: #ffffff;
}

.title-action {
    position: absolute;
    right: 24rpx;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
}

.minimize-img {
    width: 30px;
    height: 30px;
}
</style>
