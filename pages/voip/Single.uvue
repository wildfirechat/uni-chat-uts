<template>
    <view class="voip-page" v-if="session != null">
        <!--audio-->
        <view v-if="audioOnly" class="content-container">
            <view class="local-media-container local-corner">
                <image class="avatar avatar-small" :src="selfUserInfo.portrait" />
            </view>
            <view class="remote-media-container">
                <image class="avatar avatar-large" :src="participantUserInfo.portrait" />
                <text class="desc">{{ participantUserInfo.displayName }}</text>
                <text class="desc" v-if="callState === 1">等待对方接听</text>
                <text class="desc" v-else-if="callState === 2">邀请你语音聊天</text>
                <text class="desc" v-else-if="callState === 3">接听中...</text>
            </view>
        </view>

        <!--video-->
        <view v-else class="content-container">
            <view class="remote-media-container">
                <native-view v-if="callState === 4" class="video" @init="onRemoteVideoViewInit"
                    @tap="switchVideoType"></native-view>
                <view v-if="callState !== 4" class="remote-placeholder">
                    <image class="avatar avatar-large" :src="participantUserInfo.portrait" />
                    <text class="desc">{{ participantUserInfo.displayName }}</text>
                    <text class="desc" v-if="callState === 1">等待对方接听</text>
                    <text class="desc" v-else-if="callState === 2">邀请你视频聊天</text>
                    <text class="desc" v-else-if="callState === 3">接听中...</text>
                </view>
            </view>
            <view class="local-media-container" :class="callState === 4 ? 'local-corner-connected' : 'local-corner'">
                <native-view v-if="callState === 4 && !videoMuted" class="localVideo"
                    @init="onLocalVideoViewInit"></native-view>
                <image v-else class="avatar" :class="callState === 4 ? 'avatar-muted' : 'avatar-small'"
                    :src="selfUserInfo.portrait" />
            </view>
        </view>

        <!--incoming-->
        <view v-if="callState === 2" class="action-container">
            <view class="action">
                <image @tap="hangup" class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc">挂断</text>
            </view>
            <view class="action">
                <image @tap="answer" class="action-img" src="/static/image/av/av_video_answer.png" />
                <text class="action-desc">接听</text>
            </view>
        </view>

        <!--outgoing / connecting-->
        <view v-if="callState === 1 || callState === 3" class="action-container">
            <view class="action">
                <image @tap="hangup" class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc">挂断</text>
            </view>
        </view>

        <!--connected-->
        <view v-if="callState === 4" class="action-container">
            <view class="action">
                <image v-if="!audioMuted" @tap="mute" class="action-img" src="/static/image/av/av_mute.png" />
                <image v-else @tap="mute" class="action-img" src="/static/image/av/av_mute_hover.png" />
                <text class="action-desc">静音</text>
            </view>
            <view v-if="!audioOnly" class="action">
                <image @tap="switchCamera" class="action-img" src="/static/image/av/av_camera.png" />
                <text class="action-desc">切换摄像头</text>
            </view>
            <view class="action">
                <image @tap="hangup" class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc">挂断</text>
            </view>
        </view>

        <view class="voip-title-container">
            <text class="duration-text" v-if="callState === 4">{{ duration }}</text>
            <image @tap="minimize" class="minimize-img" src="/static/image/av/av_minimize.png" />
        </view>
    </view>
</template>

<script lang="uts">
import avEngineKit from "@/wfc/av/engine/avEngineKit.uts";
import CallSessionCallback from "@/wfc/av/engine/callSessionCallback.uts";
import CallSession from "@/wfc/av/engine/callSession.uts";
import CallState from "@/wfc/av/engine/callState.uts";
import VideoType from "@/wfc/av/engine/videoType.uts";
import checkVoipPermissions from "@/wfc/av/voipUtil.uts";
import { getUserInfo } from "@/wfc/client/userBrief.uts";
import wfc from "@/wfc/client/wfc.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import { takePageOptions } from "@/common/nav.uts";

export default {
    name: "Single",
    data() {
        return {
            session: null as CallSession | null,
            audioOnly: false,
            audioMuted: false,
            videoMuted: false,
            callState: 0,
            startTimestamp: 0,
            currentTimestamp: 0,
            timer: 0,
            localVideoElement: null as UniNativeViewElement | null,
            remoteVideoElement: null as UniNativeViewElement | null,
        }
    },

    onLoad(_options: OnLoadOptions) {
        const pageOptions = takePageOptions()
        if (pageOptions != null && pageOptions instanceof CallSession) {
            const session = pageOptions as CallSession
            this.session = session
            this.callState = session.state
            this.audioOnly = session.audioOnly
            if (session.connectedTime > 0) {
                this.startTimestamp = session.connectedTime
            }
        }
    },

    mounted() {
        const curSession = avEngineKit.currentCallSession()
        if (curSession == null || curSession.state == CallState.STATUS_IDLE) {
            uni.navigateBack({
                delta: 1,
                fail: (err) => {
                    console.log('nav back err', err)
                }
            } as NavigateBackOptions)
            return
        }
        this.session = curSession
        this.callState = curSession.state
        this.audioOnly = curSession.audioOnly
        this.audioMuted = curSession.audioMuted
        this.videoMuted = curSession.videoMuted

        this.setupSessionCallback()

        if (this.callState == CallState.STATUS_CONNECTED) {
            this.onVoipConnected()
        }
    },

    onBackPress(event: OnBackPressOptions): boolean {
        // minimize 触发的返回，不阻止；其他情况（手势/物理返回键）阻止直接退出通话页面
        return event.from != 'navigateBack'
    },

    beforeUnmount() {
        if (this.timer != 0) {
            clearInterval(this.timer)
            this.timer = 0
        }
    },

    methods: {
        setupSessionCallback() {
            const callback = new CallSessionCallback()
            callback.didChangeState = (state: number): void => {
                this.callState = state
                if (state == CallState.STATUS_CONNECTED) {
                    this.onVoipConnected()
                } else if (state == CallState.STATUS_IDLE) {
                    if (this.timer != 0) {
                        clearInterval(this.timer)
                        this.timer = 0
                    }
                }
            }
            callback.didChangeMode = (audioOnly: boolean): void => {
                this.audioOnly = audioOnly
            }
            callback.didReceiveRemoteVideoTrack = (userId: string, _screenSharing: boolean): void => {
                const session = this.session
                if (session == null) {
                    return
                }
                this.setupRemoteVideoView()
            }
            callback.didCallEndWithReason = (_reason: number): void => {
                this.session = null
            }
            callback.didVideoMuted = (userId: string, muted: boolean): void => {
                if (userId == wfc.getUserId()) {
                    this.videoMuted = muted
                    if (!muted) {
                        this.$nextTick((): void => {
                            this.setupLocalVideoView()
                        })
                    }
                } else if (!muted) {
                    this.$nextTick((): void => {
                        this.setupRemoteVideoView()
                    })
                }
            }
            avEngineKit.setSessionCallback(callback)
        },

        // native-view 创建后（v-if 首次满足或重新满足时）触发，元素随即用于挂载视频画面
        onLocalVideoViewInit(e: UniNativeViewInitEvent) {
            this.localVideoElement = e.detail.element
            this.setupLocalVideoView()
        },

        onRemoteVideoViewInit(e: UniNativeViewInitEvent) {
            this.remoteVideoElement = e.detail.element
            this.setupRemoteVideoView()
        },

        setupLocalVideoView() {
            const session = this.session
            const element = this.localVideoElement
            if (session == null || element == null) {
                return
            }
            avEngineKit.setLocalVideoView(session.callId, element)
        },

        setupRemoteVideoView() {
            const session = this.session
            const element = this.remoteVideoElement
            if (session == null || element == null) {
                return
            }
            avEngineKit.setRemoteVideoView(session.callId, session.conversation.target, element)
        },

        switchVideoType() {
            const session = this.session
            if (session == null) {
                return
            }
            avEngineKit.setParticipantVideoType(session.callId, session.conversation.target, false, VideoType.BIG_STREAM)
        },

        answer() {
            const session = this.session
            if (session == null) {
                return
            }
            checkVoipPermissions(session.audioOnly).then((granted: boolean): void => {
                if (!granted) {
                    return
                }
                avEngineKit.answerCall(session.callId, false)
            })
        },

        hangup() {
            const session = this.session
            if (session == null) {
                return
            }
            avEngineKit.endCall(session.callId)
            this.session = null
        },

        switchCamera() {
            const session = this.session
            if (session == null) {
                return
            }
            avEngineKit.switchCamera(session.callId)
        },

        mute() {
            const session = this.session
            if (session == null) {
                return
            }
            this.audioMuted = !this.audioMuted
            avEngineKit.muteAudio(session.callId, this.audioMuted)
        },

        onVoipConnected() {
            if (this.timer == 0) {
                if (this.startTimestamp == 0) {
                    this.startTimestamp = new Date().getTime()
                }
                this.timer = setInterval((): void => {
                    this.currentTimestamp = new Date().getTime()
                }, 1000)
            }
            if (!this.audioOnly) {
                setTimeout((): void => {
                    this.setupLocalVideoView()
                    this.setupRemoteVideoView()
                }, 100)
            }
        },

        minimize() {
            const session = this.session
            if (session == null) {
                return
            }
            if (avEngineKit.checkOverlayPermission()) {
                avEngineKit.minimize(session.callId)
                uni.navigateBack({
                    delta: 1,
                    fail: (err) => {
                        console.log('nav back err', err)
                    }
                } as NavigateBackOptions)
            } else {
                uni.showToast({
                    title: '需要悬浮窗权限',
                    icon: 'none',
                } as ShowToastOptions)
            }
        },
    },

    computed: {
        participantUserInfo(): UserInfo {
            const session = this.session!
            return getUserInfo(session.conversation.target, false)
        },
        selfUserInfo(): UserInfo {
            return getUserInfo(wfc.getUserId(), false)
        },
        duration(): string {
            if (this.currentTimestamp <= 0) {
                return '00:00'
            }
            const elapsed = Math.floor((this.currentTimestamp - this.startTimestamp) / 1000)
            const min = Math.floor(elapsed / 60)
            const sec = elapsed % 60
            const minStr = min < 10 ? ('0' + min) : ('' + min)
            const secStr = sec < 10 ? ('0' + sec) : ('' + sec)
            return minStr + ':' + secStr
        },
    },
}
</script>

<style scoped>
.voip-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    background-color: #292929;
}

.content-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
}

.remote-media-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.remote-placeholder {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.video {
    flex: 1;
    width: 750rpx;
}

.avatar {
    border-radius: 4px;
}

.avatar-large {
    width: 200px;
    height: 200px;
    border-radius: 6px;
}

.avatar-small {
    width: 60px;
    height: 60px;
}

.avatar-muted {
    width: 150px;
    height: 200px;
    border-radius: 6px;
}

.desc {
    color: #ffffff;
    font-size: 15px;
    padding: 5px 0;
}

.local-media-container {
    position: absolute;
    display: flex;
    justify-content: center;
    align-items: center;
}

.local-corner {
    top: 88rpx;
    left: 20px;
}

.local-corner-connected {
    top: 88rpx;
    right: 20px;
}

.localVideo {
    width: 150px;
    height: 200px;
    border-radius: 6px;
}

.action-container {
    width: 750rpx;
    position: absolute;
    bottom: 40px;
    left: 0;
    display: flex;
    flex-direction: row;
    justify-content: space-around;
}

.action {
    display: flex;
    flex-direction: column;
    align-items: center;
}

.action-img {
    width: 60px;
    height: 60px;
}

.action-desc {
    color: #ffffff;
    font-size: 12px;
    padding-top: 5px;
}

.voip-title-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 750rpx;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 44rpx;
    height: 88rpx;
}

.duration-text {
    color: #ffffff;
    font-size: 15px;
}

.minimize-img {
    position: absolute;
    right: 40rpx;
    width: 30px;
    height: 30px;
}
</style>
