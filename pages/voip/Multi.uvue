<template>
    <view class="voip-page" v-if="session != null">
        <view class="content-container">
            <!--self-->
            <view class="participant-container" :class="manyParticipants ? 'participant-small' : 'participant-large'">
                <view v-if="audioOnly || callState != 4 || selfVideoMuted"
                    class="participant-item" :class="manyParticipants ? 'participant-small' : 'participant-large'">
                    <image class="avatar" :class="manyParticipants ? 'participant-small' : 'participant-large'"
                        :src="selfUserInfo.portrait" />
                    <text class="desc" :style="{ fontSize: fontPx(13) }">我</text>
                </view>
                <native-view v-else class="video"
                    :class="manyParticipants ? 'participant-small' : 'participant-large'"
                    @init="onLocalVideoViewInit"></native-view>
            </view>

            <!--participants-->
            <view v-for="p in participants" :key="p.userId" class="participant-container"
                :class="manyParticipants ? 'participant-small' : 'participant-large'">
                <view v-if="audioOnly || callState != 4 || p.videoMuted || p.state != 4"
                    class="participant-item" :class="manyParticipants ? 'participant-small' : 'participant-large'">
                    <image class="avatar" :class="manyParticipants ? 'participant-small' : 'participant-large'"
                        :src="userInfoOf(p.userId).portrait" />
                    <text class="desc" :style="{ fontSize: fontPx(13) }">{{ userInfoOf(p.userId).displayName }}</text>
                </view>
                <native-view v-else class="video"
                    :class="manyParticipants ? 'participant-small' : 'participant-large'"
                    @init="onRemoteVideoViewInit($event as UniNativeViewInitEvent, p.userId)" @tap="switchVideoType(p.userId)"></native-view>
            </view>
        </view>

        <!--incoming-->
        <view v-if="callState == 2" class="action-container">
            <view class="action" @tap="hangup">
                <image class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">挂断</text>
            </view>
            <view class="action" @tap="answer">
                <image class="action-img" src="/static/image/av/av_video_answer.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">接听</text>
            </view>
        </view>

        <!--outgoing / connecting-->
        <view v-if="callState == 1 || callState == 3" class="action-container">
            <view class="action" @tap="hangup">
                <image class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">挂断</text>
            </view>
        </view>

        <!--connected-->
        <view v-if="callState == 4" class="action-container">
            <view class="action" @tap="mute">
                <image v-if="!selfAudioMuted" class="action-img" src="/static/image/av/av_mute.png" />
                <image v-else class="action-img" src="/static/image/av/av_mute_hover.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">静音</text>
            </view>
            <view v-if="!audioOnly" class="action" @tap="switchCamera">
                <image class="action-img" src="/static/image/av/av_camera.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">切换摄像头</text>
            </view>
            <view v-if="!audioOnly" class="action" @tap="muteVideo">
                <image v-if="!selfVideoMuted" class="action-img"
                    src="/static/image/av/av_conference_video.png" />
                <image v-else class="action-img"
                    src="/static/image/av/av_conference_video_mute.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">关闭摄像头</text>
            </view>
            <view class="action" @tap="hangup">
                <image class="action-img" src="/static/image/av/av_hang_up.png" />
                <text class="action-desc" :style="{ fontSize: fontPx(12) }">挂断</text>
            </view>
        </view>

        <view class="voip-title-container">
            <text class="duration-text" :style="{ fontSize: fontPx(15) }" v-if="callState == 4">{{ duration }}</text>
            <view class="title-action" @tap="minimize">
                <image class="minimize-img" src="/static/image/av/av_minimize.png" />
            </view>
            <view v-if="callState == 4" class="title-action" @tap="invite">
                <image class="invite-img" src="/static/image/av/add.png" />
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import avEngineKit from "@/wfc/av/engine/avEngineKit.uts";
import CallSessionCallback from "@/wfc/av/engine/callSessionCallback.uts";
import CallSession from "@/wfc/av/engine/callSession.uts";
import CallState from "@/wfc/av/engine/callState.uts";
import VideoType from "@/wfc/av/engine/videoType.uts";
import ParticipantProfile from "@/wfc/av/engine/participantProfile.uts";
import MultiCallOngoingMessageContent from "@/wfc/av/messages/multiCallOngoingMessageContent.uts";
import checkVoipPermissions from "@/wfc/av/voipUtil.uts";
import { getUserInfo } from "@/wfc/client/userBrief.uts";
import wfc from "@/wfc/client/wfc.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import { takePageOptions } from "@/common/nav.uts";
import { pickUsers, PickUsersOptions } from "@/common/picker.uts";
import store from "@/store.uts";
import Config from "@/config.uts";
import { fontPx } from "@/common/layoutScale.uts";

defineOptions({
    name: "Multi"
})

const session = ref<CallSession | null>(null as CallSession | null)
const audioOnly = ref<boolean>(false)
const callState = ref<number>(0)
const initiatorId = ref<string>('')
const participants = ref<ParticipantProfile[]>([] as ParticipantProfile[])
const selfAudioMuted = ref<boolean>(false)
const selfVideoMuted = ref<boolean>(false)
const startTimestamp = ref<number>(0)
const currentTimestamp = ref<number>(0)
const timer = ref<number>(0)
const broadcastTimer = ref<number>(0)
// 本端已经收到过谁的视频流。SDK 里远端 participant 的 videoMuted 初值是 true、只靠对端的静音信令更新，
// 收到视频轨才是「对方摄像头开着」最可靠的信号，单独记一份，syncParticipants 时用它纠正。
const videoTrackUsers = ref<Set<string>>(new Set<string>())

const selfUserInfo = computed<UserInfo>((): UserInfo => {
    return getUserInfo(wfc.getUserId(), false)
})
const manyParticipants = computed<boolean>((): boolean => {
    return participants.value.length >= 4
})
const duration = computed<string>((): string => {
    if (currentTimestamp.value <= 0) {
        return '00:00'
    }
    const elapsed = Math.floor((currentTimestamp.value - startTimestamp.value) / 1000)
    const min = Math.floor(elapsed / 60)
    const sec = elapsed % 60
    const minStr = min < 10 ? ('0' + min) : ('' + min)
    const secStr = sec < 10 ? ('0' + sec) : ('' + sec)
    return minStr + ':' + secStr
})

const broadcastMultiCallOngoing = () => {
    const callSession = session.value
    if (callSession == null || callState.value != CallState.STATUS_CONNECTED) {
        return
    }
    const selfId = wfc.getUserId()
    const targets: string[] = []
    participants.value.forEach((p: ParticipantProfile): void => {
        if (p.userId != selfId) {
            targets.push(p.userId)
        }
    })
    const content = new MultiCallOngoingMessageContent()
    content.callId = callSession.callId
    content.initiator = callSession.initiator
    content.audioOnly = callSession.audioOnly
    content.targets = targets
    wfc.sendConversationMessage(callSession.conversation, content)
}

const onVoipConnected = () => {
    if (timer.value == 0) {
        if (startTimestamp.value == 0) {
            startTimestamp.value = new Date().getTime()
        }
        timer.value = setInterval((): void => {
            currentTimestamp.value = new Date().getTime()
        }, 1000)
    }
    // 视频画面不在这里挂：connected 后模板会渲染出 native-view，挂载统一在 @init 里做
}

const userInfoOf = (userId: string): UserInfo => {
    return getUserInfo(userId, false)
}

/**
 * 参与者列表一律从 SDK 重新拉全量，不在本地做增删改。两个原因：
 *
 * 1. ParticipantProfile 是普通 UTS class，改它的字段**不会**触发重渲染（uni-app x 只对
 *    UTSJSONObject/Array/Map/Set 做响应式包装，见 store.uts 开头），必须整体换数组引用。
 *    迁移前的 Multi.nvue 直接改字段能生效，是因为 web 运行时对普通对象也是响应式的。
 * 2. 只靠 didParticipantJoined 往本地列表塞人很脆：漏一次（邀请新成员、重进页面、
 *    事件早于回调注册）那个人就永远不出现。每个事件重拉一遍就能自愈。
 */
const syncParticipants = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    const profiles = avEngineKit.getParticipantProfiles(callSession.callId)
    profiles.forEach((p: ParticipantProfile): void => {
        if (videoTrackUsers.value.has(p.userId)) {
            p.state = CallState.STATUS_CONNECTED
            p.videoMuted = false
        }
    })
    participants.value = profiles
}

const switchVideoType = (userId: string) => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.setParticipantVideoType(callSession.callId, userId, false, VideoType.BIG_STREAM)
}

const hangup = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.endCall(callSession.callId)
    session.value = null
}

const answer = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    checkVoipPermissions(audioOnly.value).then((granted: boolean): void => {
        if (!granted) {
            hangup()
            return
        }
        avEngineKit.answerCall(callSession.callId, false)
    })
}

const switchCamera = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.switchCamera(callSession.callId)
}

const mute = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    selfAudioMuted.value = !selfAudioMuted.value
    avEngineKit.muteAudio(callSession.callId, selfAudioMuted.value)
}

const muteVideo = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    selfVideoMuted.value = !selfVideoMuted.value
    avEngineKit.muteVideo(callSession.callId, selfVideoMuted.value)
}

const invite = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    const groupMemberUserInfos = store.getGroupMemberUserInfos(callSession.conversation.target, false)
    const excluded: UserInfo[] = [selfUserInfo.value]
    participants.value.forEach((p: ParticipantProfile): void => {
        excluded.push(userInfoOf(p.userId))
    })
    const options = new PickUsersOptions()
    options.users = groupMemberUserInfos
    options.initialCheckedUsers = excluded
    options.uncheckableUsers = excluded
    options.confirmTitle = '确定'
    options.successCB = (users: UserInfo[]): void => {
        const ids: string[] = []
        for (let i = 0; i < users.length; i++) {
            ids.push(users[i].uid)
        }
        if (ids.length == 0) {
            return
        }
        // 引擎要等邀请消息发送成功才会建 PeerConnectionClient 并回调 didParticipantJoined，
        // 新成员的格子由那个回调驱动，这里不用自己往列表里加
        avEngineKit.inviteNewParticipant(callSession.callId, ids)
    }
    pickUsers(options)
}

// ⚠️ native-view 的挂载必须在 @init 里**同步**完成。Android 运行时的
// UniNativeViewComponent.initComponentView 是「同步派发 init 事件 → 立刻把 bindAndroidView
// 绑进来的 View 当组件宿主 View 返回」，回调里没同步绑，组件就按 null 宿主 View 建好了，
// 之后再绑也没用：画面永远不显示，元素过桥还会报
// “Parameter specified as non-null is null: ... parameter element”。
// setLocal/RemoteVideoView 内部做的正是 bindAndroidView，所以只能用 e.detail.element 直接同步调，
// 不能套 nextTick/setTimeout，也不能把 element 存起来后面复用（格子在头像/视频间切换时元素会被销毁）。
//
// 视频轨晚于视图到达不用管：引擎收到视频轨时会检查容器是否已登记，已登记就自己挂渲染器，反之亦然。
const onLocalVideoViewInit = (e: UniNativeViewInitEvent) => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.setLocalVideoView(callSession.callId, e.detail.element)
}

const onRemoteVideoViewInit = (e: UniNativeViewInitEvent, userId: string) => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    avEngineKit.setRemoteVideoView(callSession.callId, userId, e.detail.element)
}

const setupSessionCallback = () => {
    const callback = new CallSessionCallback()
    callback.didChangeState = (state: number): void => {
        callState.value = state
        syncParticipants()
        if (state == CallState.STATUS_CONNECTED) {
            onVoipConnected()
            if (Config.ENABLE_MULTI_CALL_AUTO_JOIN && initiatorId.value == wfc.getUserId() && broadcastTimer.value == 0) {
                broadcastTimer.value = setInterval((): void => {
                    broadcastMultiCallOngoing()
                }, 1000)
            }
        } else if (state == CallState.STATUS_IDLE) {
            if (timer.value != 0) {
                clearInterval(timer.value)
                timer.value = 0
            }
        }
    }
    callback.didChangeMode = (isAudioOnly: boolean): void => {
        audioOnly.value = isAudioOnly
    }
    callback.didParticipantJoined = (_userId: string, _screenSharing: boolean): void => {
        syncParticipants()
    }
    callback.didParticipantConnected = (_userId: string, _screenSharing: boolean): void => {
        syncParticipants()
    }
    callback.didParticipantLeft = (userId: string, _reason: number, _screenSharing: boolean): void => {
        videoTrackUsers.value.delete(userId)
        syncParticipants()
    }
    callback.didReceiveRemoteVideoTrack = (userId: string, _screenSharing: boolean): void => {
        videoTrackUsers.value.add(userId)
        syncParticipants()
    }
    callback.didRemoveRemoteVideoTrack = (userId: string): void => {
        videoTrackUsers.value.delete(userId)
        syncParticipants()
    }
    callback.didCallEndWithReason = (_reason: number): void => {
        session.value = null
    }
    callback.didVideoMuted = (userId: string, muted: boolean): void => {
        if (userId == wfc.getUserId()) {
            selfVideoMuted.value = muted
            return
        }
        // 对方关摄像头后原来那条视频轨就不作数了；重新打开时等 didReceiveRemoteVideoTrack 再点亮
        if (muted) {
            videoTrackUsers.value.delete(userId)
        }
        syncParticipants()
    }
    callback.didChangeInitiator = (initiator: string): void => {
        initiatorId.value = initiator
        if (initiator == wfc.getUserId() && broadcastTimer.value == 0) {
            broadcastTimer.value = setInterval((): void => {
                broadcastMultiCallOngoing()
            }, 1000)
        }
    }
    avEngineKit.setSessionCallback(callback)
}

const minimize = () => {
    const callSession = session.value
    if (callSession == null) {
        return
    }
    if (avEngineKit.checkOverlayPermission()) {
        avEngineKit.minimize(callSession.callId)
        uni.navigateBack({
            delta: 1,
            fail: (err) => {
                console.log('nav back err', err)
            }
        } as NavigateBackOptions)
    } else {
        uni.showToast({
            title: '需要悬浮窗权限',
            icon: 'none',
        } as ShowToastOptions)
    }
}

onLoad((_options: OnLoadOptions) => {
    const pageOptions = takePageOptions()
    if (pageOptions != null && pageOptions instanceof CallSession) {
        const callSession = pageOptions as CallSession
        session.value = callSession
        callState.value = callSession.state
        audioOnly.value = callSession.audioOnly
        initiatorId.value = callSession.initiator
        if (callSession.connectedTime > 0) {
            startTimestamp.value = callSession.connectedTime
        }
    }
})

onMounted(() => {
    const curSession = avEngineKit.currentCallSession()
    if (curSession == null || curSession.state == CallState.STATUS_IDLE) {
        uni.navigateBack({
            delta: 1,
            fail: (err) => {
                console.log('nav back err', err)
            }
        } as NavigateBackOptions)
        return
    }
    session.value = curSession
    callState.value = curSession.state
    audioOnly.value = curSession.audioOnly
    selfAudioMuted.value = curSession.audioMuted
    selfVideoMuted.value = curSession.videoMuted
    initiatorId.value = curSession.initiator

    setupSessionCallback()

    syncParticipants()

    if (callState.value == CallState.STATUS_CONNECTED) {
        onVoipConnected()
    }
})

onBackPress((event: OnBackPressOptions): boolean => {
    return event.from != 'navigateBack'
})

onBeforeUnmount(() => {
    if (timer.value != 0) {
        clearInterval(timer.value)
        timer.value = 0
    }
    if (broadcastTimer.value != 0) {
        clearInterval(broadcastTimer.value)
        broadcastTimer.value = 0
    }
})
</script>

<style scoped>
/* 底部操作栏用 padding-bottom 给它留出真实空间，不要让 content-container 铺到页面底部、
 * 再把操作栏绝对定位盖在上面：Android 上视频用的 native-view 是真正的原生 View（内部是 SurfaceView），
 * 画在页面画布之上，会把压在它下面的按钮挡住（音频通话没有 native-view，则是 content-container
 * 把点击吞掉，按钮看得见点不动）。与 ConferencePage、Single 的做法保持一致。 */
.voip-page {
    flex: 1;
    display: flex;
    flex-direction: column;
    position: relative;
    padding-top: 132rpx;
    padding-bottom: 140px;
    background-color: #292929;
}

.content-container {
    flex: 1;
    position: relative;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    align-items: flex-start;
}

.participant-container {
    display: flex;
    position: relative;
    flex-direction: column;
    justify-content: center;
    align-items: center;
}

.participant-item {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 2rpx;
}

.participant-large {
    width: 375rpx;
    height: 375rpx;
}

.participant-small {
    width: 250rpx;
    height: 250rpx;
}

.avatar {
    border-radius: 4px;
}

.desc {
    position: absolute;
    left: 0;
    bottom: 0;
    background-color: rgba(211, 211, 211, 0.8);
    color: #000000;
    padding: 4px 8px;
}

.video {
    display: flex;
}

/* 本地预览不要加 transform: scaleX(-1) 做镜像（迁移前 Multi.nvue 是这么写的）：引擎自己已经对
 * 本地渲染器调过 setMirror（切前后摄像头还会跟着翻），再翻一次是把镜像抵消掉；而且这个 transform
 * 会落到 SurfaceViewRenderer 的父 View 上，SurfaceView 不跟随负向缩放。Single 页面也没有。 */

.duration-text {
    color: #ffffff;
    padding: 5px 0;
}

.action-container {
    width: 750rpx;
    height: 140px;
    position: absolute;
    bottom: 0;
    left: 0;
    z-index: 1;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-around;
    align-items: center;
}

.action {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding: 10px 0;
}

.action-img {
    width: 60px;
    height: 60px;
}

.action-desc {
    color: #ffffff;
    padding-top: 5px;
}

.voip-title-container {
    position: absolute;
    left: 0;
    top: 0;
    width: 750rpx;
    z-index: 2;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 44rpx;
    padding: 0 40rpx;
    height: 88rpx;
}

.title-action {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 8px;
}

.minimize-img {
    width: 30px;
    height: 30px;
}

.invite-img {
    width: 30px;
    height: 30px;
}
</style>
