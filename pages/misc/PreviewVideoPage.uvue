<template>
    <view class="video-container">
        <video class="video" :src="url" :autoplay="true" :controls="true"></video>
        <view class="action-bar">
            <view class="action" @tap="saveToAlbum">
                <text class="action-text" :style="{ fontSize: fontPx(14) }">保存到相册</text>
            </view>
            <view v-if="message != null" class="action" @tap="forwardVideo">
                <text class="action-text" :style="{ fontSize: fontPx(14) }">转发</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import { conversationState } from "@/store.uts";
import { forward } from "@/common/forward.uts";
import ForwardType from "@/pages/conversation/message/forward/ForwardType.uts";
import VideoMessageContent from "@/wfc/messages/videoMessageContent.uts";
import { saveMessageMediaToAlbum } from "@/common/mediaSaver.uts";
import { fontPx } from "@/common/layoutScale.uts";

const url = ref<string>('')
// 从会话消息列表里反查对应的视频消息，用于转发/保存
const message = ref<Message | null>(null)

const findVideoMessage = (remotePath: string): Message | null => {
    if (remotePath == '') {
        return null
    }
    const msgs = conversationState.currentConversationMessageList
    for (let i = msgs.length - 1; i >= 0; i--) {
        const content = msgs[i].messageContent
        if (content instanceof VideoMessageContent && (content as VideoMessageContent).remotePath == remotePath) {
            return msgs[i]
        }
    }
    return null
}

onLoad((options: OnLoadOptions) => {
    const urlValue = options['url'] ?? ''
    console.log('onLoad option url', decodeURIComponent(urlValue));
    url.value = decodeURIComponent(urlValue) ?? '';
    message.value = findVideoMessage(url.value)
})

const saveToAlbum = () => {
    const msg = message.value
    if (msg != null) {
        saveMessageMediaToAlbum(msg)
        return
    }
    if (url.value == '') {
        return
    }
    uni.showLoading({
        title: '保存中...',
    } as ShowLoadingOptions)
    uni.downloadFile({
        url: url.value,
        success: (res) => {
            uni.saveVideoToPhotosAlbum({
                filePath: res.tempFilePath,
                success: (_) => {
                    uni.hideLoading()
                    uni.showToast({ title: '已保存到相册', icon: 'none' } as ShowToastOptions)
                },
                fail: (err) => {
                    uni.hideLoading()
                    console.log('saveVideoToPhotosAlbum fail', err)
                    uni.showToast({ title: '保存失败', icon: 'none' } as ShowToastOptions)
                }
            } as SaveVideoToPhotosAlbumOptions)
        },
        fail: (err) => {
            uni.hideLoading()
            console.log('download video fail', err)
            uni.showToast({ title: '下载失败', icon: 'none' } as ShowToastOptions)
        }
    } as DownloadFileOptions)
}

const forwardVideo = () => {
    const msg = message.value
    if (msg == null) {
        return
    }
    forward(ForwardType.NORMAL, [msg])
}
</script>

<style scoped>
.video-container {
    flex: 1;
    background-color: #000000;
}

.video {
    width: 100%;
    flex: 1;
}

.action-bar {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    padding: 12px 0;
}

.action {
    padding: 8px 20px;
    margin: 0 10px;
    border-radius: 16px;
    background-color: rgba(255, 255, 255, 0.15);
}

.action-text {
    color: #ffffff;
}
</style>
