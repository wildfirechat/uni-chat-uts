<template>
    <web-view class="web-view" :src="url"></web-view>
</template>

<script setup lang="uts">
const url = ref<string>('')

onLoad((options: OnLoadOptions) => {
    const urlValue = options['url'] ?? ''
    console.log('onLoad option url', decodeURIComponent(urlValue));
    url.value = decodeURIComponent(urlValue) ?? '';
})
</script>

<style scoped>
.web-view {
    flex: 1;
}
</style>
