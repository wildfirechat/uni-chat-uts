<template>
    <scroll-view class="page" direction="vertical" :style="{ backgroundColor: c.primaryBackground }">
        <view class="head-gap"></view>

        <form-card>
            <option-item :title="t('setting.privacy_settings')" @tap="open('/pages/me/PrivacySettingsPage')" />
            <option-item :title="t('setting.lang')" :desc="langDesc" @tap="langSheetVisible = true" />
            <option-item :title="t('setting.font_size')" @tap="open('/pages/me/FontSizeSettingsPage')" />
            <option-item :title="t('setting.theme')" :desc="themeDesc" :show-bottom-divider="false"
                @tap="themeSheetVisible = true" />
        </form-card>

        <section-divider />

        <form-card>
            <option-item :title="t('setting.about')" :show-bottom-divider="false" @tap="showAbout" />
        </form-card>

        <section-divider />

        <form-card>
            <option-item :title="t('setting.user_agreement')" @tap="openWebView(USER_AGREEMENT_URL)" />
            <option-item :title="t('setting.privacy_policy')" @tap="openWebView(PRIVACY_POLICY_URL)" />
            <option-item :title="t('setting.report')" :show-bottom-divider="false" @tap="report" />
        </form-card>

        <section-divider />

        <form-card>
            <view class="logout" hover-class="logout-pressed" hover-stay-time="80" @tap="logoutSheetVisible = true">
                <text :style="{ color: c.danger, fontSize: fontPx(FONT_LG) }">{{ t('setting.logout') }}</text>
            </view>
        </form-card>

        <view class="tail"></view>

        <bottom-action-sheet v-model="langSheetVisible" :items="langItems" @select="onLangSelect" />
        <bottom-action-sheet v-model="themeSheetVisible" :items="themeItems" @select="onThemeSelect" />
        <bottom-action-sheet v-model="logoutSheetVisible" :items="logoutItems" @select="onLogoutSelect" />
    </scroll-view>
</template>

<script setup lang="uts">
/**
 * 通用设置。对齐 flutter `settings/general_settings.dart`。
 *
 * 与 flutter 的两处差异：
 * - 语言 / 主题 / 退出 flutter 用 AlertDialog + ListTile，这里用 bottom-action-sheet
 *   —— 移动端底部弹层更顺手，也是本项目已有的通用件。
 * - flutter 有「诊断」入口但点了只弹「暂未实现」，这里索性不放。
 *
 * 语言切换是**半生效**的：i18n 的 `t()` 不是响应式的（见 i18n/i18n.uts），
 * 换语言后当前页面栈上已渲染的文案不会变，重启才全量生效，所以切完给一条提示。
 */
import wfc from "@/wfc/client/wfc.uts";
import store from "@/store.uts";
import { clear } from "@/pages/util/storageHelper.uts";
import { colors, AppColors, themeMode, setThemeMode, THEME_MODE_SYSTEM, THEME_MODE_LIGHT, THEME_MODE_DARK } from "@/common/theme.uts";
import { fontPx, FONT_LG } from "@/common/layoutScale.uts";
import { t, getLocale, setLocale } from "@/i18n/i18n.uts";
import { report } from "@/common/report.uts";
import { ActionSheetItem } from "@/components/bottom-action-sheet/actionSheetItem.uts";

defineOptions({
    name: "GeneralSettingsPage"
})

const USER_AGREEMENT_URL = 'https://static.wildfirechat.cn/agreement.html'
const PRIVACY_POLICY_URL = 'https://static.wildfirechat.cn/privacy.html'

const c = computed<AppColors>((): AppColors => colors())

const langSheetVisible = ref<boolean>(false)
const themeSheetVisible = ref<boolean>(false)
const logoutSheetVisible = ref<boolean>(false)

// 语言没有跟随系统档：i18n 只在启动时读一次本地存的 locale，没有接系统语言变化
const langDesc = computed<string>((): string => {
    const locale = getLocale()
    if (locale == 'zh-TW') {
        return t('setting.zh_tw')
    }
    if (locale == 'en') {
        return t('setting.en')
    }
    return t('setting.zh_cn')
})

const themeDesc = computed<string>((): string => {
    const mode = themeMode()
    if (mode == THEME_MODE_LIGHT) {
        return t('setting.theme_light')
    }
    if (mode == THEME_MODE_DARK) {
        return t('setting.theme_dark')
    }
    return t('setting.follow_system')
})

const langItems = computed<ActionSheetItem[]>((): ActionSheetItem[] => {
    return [
        new ActionSheetItem(t('setting.zh_cn'), 'zh-CN'),
        new ActionSheetItem(t('setting.zh_tw'), 'zh-TW'),
        new ActionSheetItem(t('setting.en'), 'en')
    ]
})

const themeItems = computed<ActionSheetItem[]>((): ActionSheetItem[] => {
    return [
        new ActionSheetItem(t('setting.follow_system'), THEME_MODE_SYSTEM),
        new ActionSheetItem(t('setting.theme_light'), THEME_MODE_LIGHT),
        new ActionSheetItem(t('setting.theme_dark'), THEME_MODE_DARK)
    ]
})

const logoutItems = computed<ActionSheetItem[]>((): ActionSheetItem[] => {
    const logout = new ActionSheetItem(t('setting.logout'), 'logout')
    const destroy = new ActionSheetItem(t('setting.destroy_account'), 'destroy')
    destroy.danger = true
    return [logout, destroy]
})

const open = (url: string) => {
    uni.navigateTo({
        url: url,
        fail: (e) => {
            console.log('nav fail', url, e)
        }
    } as NavigateToOptions)
}

const openWebView = (url: string) => {
    open('/pages/misc/WebViewPage?url=' + encodeURIComponent(url))
}

const showAbout = () => {
    openWebView('https://wildfirechat.cn/')
}

const onLangSelect = (tag: string) => {
    if (tag == getLocale()) {
        return
    }
    setLocale(tag)
    uni.showToast({
        title: t('setting.lang_restart_tip'),
        icon: 'none'
    } as ShowToastOptions)
}

const onThemeSelect = (tag: string) => {
    setThemeMode(tag)
}

const onLogoutSelect = (tag: string) => {
    if (tag == 'destroy') {
        open('/pages/me/DestroyAccountPage')
        return
    }
    uni.showModal({
        title: t('setting.logout'),
        content: t('setting.logout_confirm'),
        success: (res) => {
            if (res.confirm) {
                logout()
            }
        }
    } as ShowModalOptions)
}

const logout = () => {
    wfc.disconnect(true, false)
    clear()
    uni.reLaunch({
        url: '/pages/login/LoginPage'
    } as ReLaunchOptions)
}

</script>

<style scoped>
.page {
    width: 100%;
    flex: 1;
}

/* flutter 侧首个分组上方留 10，不是 SectionDivider 的 18 */
.head-gap {
    width: 100%;
    height: 10px;
}

.logout {
    width: 100%;
    height: 50px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

/* hover-class 只认静态类名，色值对应 theme.uts 的 pressedOverlay */
.logout-pressed {
    background-color: #0000000A;
}

.tail {
    width: 100%;
    height: 18px;
}
</style>
