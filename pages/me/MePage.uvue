<template>
    <view class="me-container" :style="{ backgroundColor: c.primaryBackground }">
        <view class="user-info" :style="{ backgroundColor: c.surface }" hover-class="user-info-pressed"
            hover-stay-time="80" @tap="showUserInfo">
            <image class="portrait" :src="portrait" :style="{ width: iconPx(60), height: iconPx(60) }"
                @tap.stop="updatePortrait"></image>
            <text class="name" :style="{ color: c.textPrimary, fontSize: fontPx(FONT_XL) }">{{ displayName }}</text>
        </view>

        <section-divider />

        <form-card>
            <option-item :title="t('me.about')" @tap="showAbout" />
            <option-item :title="t('me.api_test')" :show-bottom-divider="false" @tap="showApiTest" />
        </form-card>

        <section-divider />

        <view class="logout" :style="{ backgroundColor: c.surface }" hover-class="logout-pressed" hover-stay-time="80"
            @tap="logout">
            <text :style="{ color: c.danger, fontSize: fontPx(FONT_LG) }">{{ t('me.logout') }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import wfc from "../../wfc/client/wfc.uts";
import { clear } from "../util/storageHelper.uts";
import store, { contactState } from "../../store.uts";
import Config from "../../config.uts";
import MessageContentMediaType from "../../wfc/messages/messageContentMediaType.uts";
import ModifyMyInfoType from "../../wfc/model/modifyMyInfoType.uts";
import ModifyMyInfoEntry from "../../wfc/model/modifyMyInfoEntry.uts";
import { toLocalFilePath } from "../../common/filePath.uts";
import { colors, AppColors } from "../../common/theme.uts";
import { fontPx, iconPx, FONT_LG, FONT_XL } from "../../common/layoutScale.uts";
import { t } from "../../i18n/i18n.uts";

const c = computed<AppColors>((): AppColors => colors())

const portrait = computed<string>((): string => {
    const user = contactState.selfUserInfo
    const portrait = user != null ? user.portrait : ''
    return portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
})

const displayName = computed<string>((): string => {
    const user = contactState.selfUserInfo
    return user != null ? user.displayName : ''
})

const showUserInfo = () => {
    const user = contactState.selfUserInfo
    if (user == null) {
        return
    }
    store.setCurrentFriend(user)
    uni.navigateTo({
        url: '/pages/contact/UserDetailPage',
        fail: (err) => {
            console.log('nav to UserDetailPage err', err);
        }
    } as NavigateToOptions)
}

const logout = () => {
    wfc.disconnect(true, false);
    clear();
    uni.reLaunch({
        url: '/pages/login/LoginPage'
    } as ReLaunchOptions);
}

const showAbout = () => {
    uni.navigateTo({
        url: '/pages/misc/WebViewPage?url=https://wildfirechat.cn/',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}

const showApiTest = () => {
    uni.navigateTo({
        url: '/pages/misc/ApiTestPage',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}

const updatePortrait = () => {
    uni.chooseImage({
        count: 1,
        sourceType: ['album', 'camera'],
        sizeType: ['original', 'compressed'],
        success: (e) => {
            console.log('choose image', e.tempFilePaths.length);
            for (let i = 0; i < e.tempFilePaths.length; i++) {
                const filePath = toLocalFilePath(e.tempFilePaths[i]);
                wfc.uploadMediaFile(filePath, MessageContentMediaType.Portrait, (remoteUrl: string) => {
                    console.log('upload success', remoteUrl);
                    wfc.modifyMyInfo([new ModifyMyInfoEntry(ModifyMyInfoType.Modify_Portrait, remoteUrl)], () => {
                        console.log('modifyMyInfo success', remoteUrl);
                        const user = contactState.selfUserInfo
                        if (user != null) {
                            user.portrait = remoteUrl;
                        }
                        uni.showToast({
                            title: t('me.portrait_update_success'),
                            icon: 'none'
                        } as ShowToastOptions);
                    }, (error: number) => {
                        console.error('modifyMyInfo error', error);
                        uni.showToast({
                            title: t('me.portrait_update_fail') + ': ' + error,
                            icon: 'none'
                        } as ShowToastOptions);
                    });
                }, (error: number) => {
                    console.error('upload error', error);
                }, (current: number, total: number) => {
                    console.log('upload progress', current, total);
                });
            }
        },
        fail: (err) => {
            console.log('choose image fail', err)
        }
    } as ChooseImageOptions);
}
</script>

<style scoped>
.me-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    flex: 1;
}

.user-info {
    width: 100%;
    padding: 20px 15px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

/* 按下态的色值对应 theme.uts 的 pressedOverlay，hover-class 拿不到 :style 绑定 */
.user-info-pressed {
    background-color: #F5F5F5;
}

.portrait {
    border-radius: 5px;
}

/* flex: 1 不能省：text 带了 overflow: hidden 又没有确定宽度时，鸿蒙上会被压成 0 宽，
 * 整个昵称塌成省略号（与 option-item 的 .title 同一个坑） */
.name {
    flex: 1;
    margin-left: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.logout {
    width: 100%;
    height: 50px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.logout-pressed {
    background-color: #F5F5F5;
}
</style>
