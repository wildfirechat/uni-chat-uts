<template>
    <view class="page" :style="{ backgroundColor: c.primaryBackground }">
        <form-card :radius="8">
            <view class="field" :style="{ borderBottomColor: c.hairlineSoft }">
                <text class="label" :style="{ color: c.textSecondary, fontSize: fontPx(FONT_XS) }">{{ t('setting.old_password') }}</text>
                <input class="input" type="text" :password="true" :placeholder="t('setting.input_old_password')"
                    :placeholder-style="placeholderStyle" :style="{ color: c.textPrimary, fontSize: fontPx(FONT_LG) }"
                    @input="onOldInput" />
            </view>
            <view class="field" :style="{ borderBottomColor: c.hairlineSoft }">
                <text class="label" :style="{ color: c.textSecondary, fontSize: fontPx(FONT_XS) }">{{ t('setting.new_password') }}</text>
                <input class="input" type="text" :password="true" :placeholder="t('setting.input_new_password')"
                    :placeholder-style="placeholderStyle" :style="{ color: c.textPrimary, fontSize: fontPx(FONT_LG) }"
                    @input="onNewInput" />
            </view>
            <view class="field field-last">
                <text class="label" :style="{ color: c.textSecondary, fontSize: fontPx(FONT_XS) }">{{ t('setting.confirm_password') }}</text>
                <input class="input" type="text" :password="true" :placeholder="t('setting.input_new_password_again')"
                    :placeholder-style="placeholderStyle" :style="{ color: c.textPrimary, fontSize: fontPx(FONT_LG) }"
                    @input="onConfirmInput" />
            </view>
        </form-card>

        <view class="submit" :style="{ backgroundColor: submitting ? c.accentPressed : c.accent }" @tap="submit">
            <text :style="{ color: c.onAccent, fontSize: fontPx(FONT_LG) }">{{ t('setting.confirm_modify') }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
/**
 * 修改密码。对齐 flutter `account_safety_screen.dart` 里的 ChangePasswordScreen。
 *
 * 与 flutter 的差异：flutter 提交中把按钮换成转圈，uni-app x 没有等价的按钮内 spinner，
 * 这里改成按钮压暗 + 重复点击直接忽略。
 */
import appServerApi from "@/api/appServerApi.uts";
import { colors, AppColors } from "@/common/theme.uts";
import { fontPx, FONT_XS, FONT_LG } from "@/common/layoutScale.uts";
import { t, t1 } from "@/i18n/i18n.uts";

defineOptions({
    name: "ChangePasswordPage"
})

const c = computed<AppColors>((): AppColors => colors())

const oldPassword = ref<string>('')
const newPassword = ref<string>('')
const confirmPassword = ref<string>('')
const submitting = ref<boolean>(false)

// placeholder 只吃整段样式串（框架会 parse 成对象再下发），拿不到单独的 :style 绑定
const placeholderStyle = computed<string>((): string => 'color: ' + colors().textTertiary)

const onOldInput = (e: UniInputEvent) => {
    oldPassword.value = e.detail.value
}

const onNewInput = (e: UniInputEvent) => {
    newPassword.value = e.detail.value
}

const onConfirmInput = (e: UniInputEvent) => {
    confirmPassword.value = e.detail.value
}

const toast = (title: string) => {
    uni.showToast({
        title: title,
        icon: 'none'
    } as ShowToastOptions)
}

const submit = () => {
    if (submitting.value) {
        return
    }
    const oldPwd = oldPassword.value.trim()
    const newPwd = newPassword.value.trim()
    const confirmPwd = confirmPassword.value.trim()

    if (oldPwd == '' || newPwd == '' || confirmPwd == '') {
        toast(t('setting.password_incomplete'))
        return
    }
    if (newPwd != confirmPwd) {
        toast(t('setting.password_not_match'))
        return
    }
    if (newPwd.length < 6) {
        toast(t('setting.password_too_short'))
        return
    }

    submitting.value = true
    appServerApi.changePassword(oldPwd, newPwd)
        .then((_) => {
            submitting.value = false
            toast(t('setting.modify_success'))
            uni.navigateBack({} as NavigateBackOptions)
        })
        .catch((reason) => {
            submitting.value = false
            console.log('change password fail', reason)
            toast(t1('setting.modify_fail', '' + reason))
        })
}
</script>

<style scoped>
.page {
    width: 100%;
    flex: 1;
    padding: 16px;
}

.field {
    width: 100%;
    padding: 10px 12px;
    display: flex;
    flex-direction: column;
    border-bottom-width: 0.5px;
    border-bottom-style: solid;
}

/* 卡片最后一行不画线，否则会和圆角边界叠出双线 */
.field-last {
    border-bottom-width: 0;
}

.input {
    width: 100%;
    height: 36px;
    margin-top: 2px;
}

.label {
    width: 100%;
}

.submit {
    width: 100%;
    height: 44px;
    margin-top: 32px;
    border-radius: 6px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}
</style>
