/**
 * 朋友圈名单页（「不让他(她)看」/「不看他(她)」）的入参。
 *
 * 与 [pages/moment/publishState.uts](../moment/publishState.uts) 同一套模块级暂存的做法。
 * `isBlock` 为 true 是 blockList（不看他的朋友圈），false 是 blackList（不让他看我的），
 * 两者语义相反 —— 见 `wfc/moment/momentClient.uts` 的 `updateBlackOrBlockList` 注释。
 */

export class MomentBlockListParam {
    isBlock = true;
    userIds: string[] = [];
}

let pending: MomentBlockListParam | null = null;

export function setMomentBlockList(isBlock: boolean, userIds: string[]): void {
    const param = new MomentBlockListParam();
    param.isBlock = isBlock;
    param.userIds = userIds;
    pending = param;
}

export function currentMomentBlockList(): MomentBlockListParam {
    return pending ?? new MomentBlockListParam();
}
