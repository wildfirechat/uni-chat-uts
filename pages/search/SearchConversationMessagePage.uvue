<template>
    <view class="search-conversation-message-container">
        <input class="input" type="text" v-model="query" placeholder="搜索" @input="search" />
        <text class="category">聊天记录</text>
        <scroll-view class="message-list" direction="vertical">
            <view v-for="(msg, index) in messages" :key="index">
                <view class="search-result-item" @tap="onClickMessage(msg)">
                    <image class="item-portrait" :src="portrait" />
                    <view class="title-desc">
                        <text class="item-name">{{ fromNameOf(msg) }}</text>
                        <text class="desc">{{ msg.messageContent.digest(msg) }}</text>
                    </view>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
import store, { searchState } from "@/store.uts";
import Message from "@/wfc/messages/message.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import Config from "@/config.uts";
import { go2ConversationPage } from "@/common/nav.uts";

defineOptions({
    name: "SearchConversationMessagePage"
})

const query = ref<string>(searchState.query as string)
const conversationInfo = ref<ConversationInfo | null>(null as ConversationInfo | null)
const messages = ref<Message[]>([] as Message[])

const portrait = computed<string>((): string => {
    const info = conversationInfo.value
    if (info == null) {
        return Config.DEFAULT_PORTRAIT_URL
    }
    const target = store.ensureConversationTarget(info.conversation)
    const portrait = target != null ? target.portrait : ''
    return portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
})

const fromNameOf = (msg: Message): string => {
    const from = msg._from
    return from != null ? from._displayName : ''
}

const search = () => {
    const info = conversationInfo.value
    if (info != null && query.value.trim() != '') {
        messages.value = store.searchMessage(info.conversation, query.value);
    } else {
        messages.value = [];
    }
}

const onClickMessage = (msg: Message) => {
    store.setCurrentConversation(msg.conversation);
    // 会话页 onShow 时消费，定位并高亮该消息
    store.requestLocateMessage(msg.messageId);
    go2ConversationPage();
}

onMounted(() => {
    const conversation = searchState.conversation
    if (conversation != null) {
        conversationInfo.value = store.getConversationInfo(conversation)
    }
    search();
})

onBeforeUnmount(() => {
    searchState.conversation = null;
})
</script>

<style scoped>
.search-conversation-message-container {
    background-color: #ffffff;
    position: relative;
    flex: 1;
}

.input {
    height: 35px;
    width: 100%;
    padding: 5px 10px;
    margin-bottom: 5px;
    background-color: #ffffff;
    border-bottom: 1px solid #d3d3d3;
}

.category {
    margin-left: 10px;
    color: #b2b2b2;
    font-size: 13px;
}

.message-list {
    flex: 1;
    background-color: #ffffff;
}

.search-result-item {
    background-color: #ffffff;
    padding: 10px 12px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.item-portrait {
    width: 34px;
    height: 34px;
    border-radius: 2px;
}

.item-name {
    font-size: 14px;
    padding-left: 10px;
}

.title-desc {
    display: flex;
    flex-direction: column;
    flex: 1;
}

.desc {
    font-size: 12px;
    color: #808080;
    padding-left: 10px;
    lines: 3;
    text-overflow: ellipsis;
    overflow: hidden;
}
</style>
