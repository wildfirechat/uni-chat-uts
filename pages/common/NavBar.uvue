<template>
    <view class="nav-bar-container" :style="{ backgroundColor: c.surface }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="nav-bar">
            <view class="nav-bar-left" @tap="onBack">
                <text v-if="showBack" class="back-icon" :style="{ color: c.iconPrimary }">‹</text>
            </view>
            <text class="nav-bar-title" :style="{ color: c.textPrimary, fontSize: px(17, ROW_CAP) }">{{ title }}</text>
            <view class="nav-bar-right">
                <text v-if="rightIcon1 != ''" class="wxfont nav-bar-icon" :style="{ color: c.iconPrimary }"
                    @tap="onRight1Tap">{{ rightIcon1 }}</text>
                <text v-if="rightIcon2 != ''" class="wxfont nav-bar-icon" :style="{ color: c.iconPrimary }"
                    @tap="onRight2Tap">{{ rightIcon2 }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
/**
 * 自定义导航栏。
 * uni-app x 不支持原生 titleNView 按钮，原来配置在 pages.json 的标题栏按钮改用本组件实现。
 * rightIcon1/rightIcon2 传 wx_iconfont.ttf 中的 unicode 字符（如 ''）。
 */
import { colors, AppColors } from "../../common/theme.uts"
import { px, ROW_CAP } from "../../common/layoutScale.uts"

defineOptions({
    name: "NavBar",
    styleIsolation: 'app'
})

const c = computed<AppColors>((): AppColors => colors())

const props = withDefaults(defineProps<{
    title?: string
    showBack?: boolean
    rightIcon1?: string
    rightIcon2?: string
}>(), {
    title: '',
    showBack: false,
    rightIcon1: '',
    rightIcon2: ''
})

const emit = defineEmits(['right1Tap', 'right2Tap'])

const statusBarHeight = ref<number>(0)

const sysInfo = uni.getSystemInfoSync()
statusBarHeight.value = sysInfo.statusBarHeight

const onBack = () => {
    if (props.showBack) {
        uni.navigateBack({
            fail: (err) => {
                console.log('nav back err', err)
            }
        } as NavigateBackOptions)
    }
}

const onRight1Tap = () => {
    emit('right1Tap')
}

const onRight2Tap = () => {
    emit('right2Tap')
}
</script>

<style scoped>
/* 颜色和字号走 :style（common/theme.uts、common/layoutScale.uts），尺寸留在这里。
 * 图标字号（back-icon / nav-bar-icon）刻意不跟字号档位放大：它们是图形，
 * 放大只会顶破 44px 的固定栏高。
 * 标题也不完整跟随：栏高固定 44px，所以按 ROW_CAP 封顶（最大档 22.95px），
 * 并且强制单行截断 —— 会话名很长时，换行会把标题顶出标题栏。 */
.nav-bar {
    height: 44px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
}

.nav-bar-left {
    width: 70px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.back-icon {
    font-size: 28px;
}

.nav-bar-title {
    flex: 1;
    text-align: center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.nav-bar-right {
    width: 70px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.nav-bar-icon {
    font-size: 26px;
    margin-left: 16px;
}
</style>
