<template>
    <view class="nav-bar-container" :style="{ backgroundColor: c.surface }">
        <view class="status-bar" :style="{ height: statusBarHeight + 'px' }"></view>
        <view class="nav-bar">
            <view class="nav-bar-left" @tap="onBack">
                <text v-if="showBack" class="back-icon" :style="{ color: c.iconPrimary }">‹</text>
            </view>
            <!-- titleIcon 走嵌套 text 而不是并排的兄弟节点：标题是 flex:1（截断需要，见下面样式块的
                 注释），并排的图标只会被推到中间区域的最右侧，离标题老远。嵌进来才能像 android-chat
                 的 ConversationTitleHelper 那样紧跟在标题文字后面、和标题一起居中。
                 子 text 不继承父样式，所以字号/颜色/字体都要自己写全。 -->
            <text class="nav-bar-title" :style="{ color: c.textPrimary, fontSize: px(17, ROW_CAP) }">{{ title }}<text
                    v-if="titleIcon != ''" class="icomoon nav-bar-title-icon"
                    :style="{ color: c.textTertiary }">{{ ' ' + titleIcon }}</text></text>
            <view class="nav-bar-right" :style="{ width: rightText != '' ? 'auto' : '70px' }">
                <text v-if="rightText != ''" class="nav-bar-text-action"
                    :style="{ color: rightTextDisabled ? c.textTertiary : c.accent, fontSize: px(16, ROW_CAP) }"
                    @tap="onRightTextTap">{{ rightText }}</text>
                <text v-if="rightIcon1 != ''" class="wxfont nav-bar-icon" :style="{ color: c.iconPrimary }"
                    @tap="onRight1Tap">{{ rightIcon1 }}</text>
                <text v-if="rightIcon2 != ''" class="wxfont nav-bar-icon" :style="{ color: c.iconPrimary }"
                    @tap="onRight2Tap">{{ rightIcon2 }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
/**
 * 自定义导航栏。
 * uni-app x 不支持原生 titleNView 按钮，原来配置在 pages.json 的标题栏按钮改用本组件实现。
 * rightIcon1/rightIcon2 传 wx_iconfont.ttf 中的 unicode 字符（如 ''）。
 * titleIcon 传 icomoon 的 unicode 字符（见 static/iconfonts/icomoon/ICONS.md），
 * 显示在标题文字右侧，用来做状态标识（如「听筒播放」）。
 */
import { colors, AppColors } from "../../common/theme.uts"
import { px, ROW_CAP } from "../../common/layoutScale.uts"

defineOptions({
    name: "NavBar",
    styleIsolation: 'app'
})

const c = computed<AppColors>((): AppColors => colors())

const props = withDefaults(defineProps<{
    title?: string
    /** 跟在标题后面的状态标识图标（icomoon 码位），空字符串表示不显示 */
    titleIcon?: string
    showBack?: boolean
    rightIcon1?: string
    rightIcon2?: string
    /** 右上角文字操作（「完成」「发送」「确定(2)」这类），对齐 flutter `widget/app_bar_actions.dart` */
    rightText?: string
    /** 置灰且不响应点击。flutter 那边是 onPressed: null，这里保留节点只改色，避免按钮位置跳动 */
    rightTextDisabled?: boolean
    /**
     * 为 true 时返回键**只**抛 backTap，不自己 navigateBack —— 页面内部有层级要先退
     * （组织架构页在下级部门时先退一级）时用，对齐 flutter 的 PopScope。
     */
    interceptBack?: boolean
}>(), {
    title: '',
    titleIcon: '',
    showBack: false,
    rightIcon1: '',
    rightIcon2: '',
    rightText: '',
    rightTextDisabled: false,
    interceptBack: false
})

const emit = defineEmits(['right1Tap', 'right2Tap', 'rightTextTap', 'backTap'])

const statusBarHeight = ref<number>(0)

const sysInfo = uni.getSystemInfoSync()
statusBarHeight.value = sysInfo.statusBarHeight

const onBack = () => {
    if (!props.showBack) {
        return
    }
    emit('backTap')
    if (props.interceptBack) {
        return
    }
    uni.navigateBack({
        fail: (err) => {
            console.log('nav back err', err)
        }
    } as NavigateBackOptions)
}

const onRight1Tap = () => {
    emit('right1Tap')
}

const onRight2Tap = () => {
    emit('right2Tap')
}

const onRightTextTap = () => {
    if (props.rightTextDisabled) {
        return
    }
    emit('rightTextTap')
}
</script>

<style scoped>
/* 颜色和字号走 :style（common/theme.uts、common/layoutScale.uts），尺寸留在这里。
 * 图标字号（back-icon / nav-bar-icon）刻意不跟字号档位放大：它们是图形，
 * 放大只会顶破 44px 的固定栏高。
 * 标题也不完整跟随：栏高固定 44px，所以按 ROW_CAP 封顶（最大档 22.95px），
 * 并且强制单行截断 —— 会话名很长时，换行会把标题顶出标题栏。 */
.nav-bar {
    height: 44px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 0 12px;
}

.nav-bar-left {
    width: 70px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.back-icon {
    font-size: 28px;
}

.nav-bar-title {
    flex: 1;
    text-align: center;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* 标题里的状态标识图标。嵌套 text 的排版类样式（margin/padding）不生效，
 * 与标题的间距只能靠模板里那个空格；字号也不跟字号档位放大，它是图形。 */
.nav-bar-title-icon {
    font-size: 15px;
}

.nav-bar-right {
    width: 70px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
}

.nav-bar-icon {
    font-size: 26px;
    margin-left: 16px;
}
</style>
