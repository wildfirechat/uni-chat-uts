<template>
    <view class="articles-container">
        <view class="top-article" :style="{ backgroundColor: c.surface }"
            @tap="openArticle(content.topArticle.url)" @longpress="onLongPress">
            <image class="top-cover" mode="aspectFill" :src="content.topArticle.cover" />
            <text class="top-title">{{ content.topArticle.title }}</text>
        </view>
        <view v-for="(sa, si) in content.subArticles" :key="si" class="sub-article"
            :style="{ backgroundColor: c.surface }" @tap="openArticle(sa.url)">
            <text class="sub-title">{{ sa.title }}</text>
            <image class="sub-cover" mode="aspectFill" :src="sa.cover" />
        </view>
    </view>
</template>

<script setup lang="uts">
import Message from "../../../wfc/messages/message.uts";
import ArticlesMessageContent from "../../../wfc/messages/articlesMessageContent.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "ArticlesMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const emit = defineEmits(['longpress'])

const content = computed<ArticlesMessageContent>((): ArticlesMessageContent => {
    return props.message.messageContent as ArticlesMessageContent
})

const onLongPress = (e: UniTouchEvent) => {
    emit('longpress', e)
}

const openArticle = (url: string) => {
    uni.navigateTo({
        url: `/pages/misc/WebViewPage?url=${encodeURIComponent(url)}`,
        fail: (e) => {
            console.log('navigate to WebViewPage error', e)
        }
    } as NavigateToOptions);
}
</script>

<style scoped>
.articles-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 10px 0;
    justify-content: center;
}

.top-article {
    position: relative;
    width: 300px;
    padding: 10px;
    border-radius: 5px;
    margin: 5px 0;
}

.top-cover {
    width: 280px;
    height: 150px;
}

.top-title {
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: 15px;
}

.sub-article {
    width: 300px;
    padding: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sub-title {
    flex: 1;
    font-size: 14px;
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.sub-cover {
    width: 50px;
    height: 50px;
    margin-left: 10px;
}
</style>
