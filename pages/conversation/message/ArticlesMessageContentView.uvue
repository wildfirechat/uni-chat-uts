<template>
    <view class="articles-container">
        <view class="top-article" @tap="openArticle(content.topArticle.url)" @longpress="onLongPress">
            <image class="top-cover" mode="aspectFill" :src="content.topArticle.cover" />
            <text class="top-title">{{ content.topArticle.title }}</text>
        </view>
        <view v-for="(sa, si) in content.subArticles" :key="si" class="sub-article" @tap="openArticle(sa.url)">
            <text class="sub-title">{{ sa.title }}</text>
            <image class="sub-cover" mode="aspectFill" :src="sa.cover" />
        </view>
    </view>
</template>

<script lang="uts">
import Message from "../../../wfc/messages/message.uts";
import ArticlesMessageContent from "../../../wfc/messages/articlesMessageContent.uts";

export default {
    name: "ArticlesMessageContentView",
    props: {
        message: {
            type: Object as PropType<Message>,
            required: true,
        }
    },
    emits: ['longpress'],
    computed: {
        content(): ArticlesMessageContent {
            return this.message.messageContent as ArticlesMessageContent
        }
    },
    methods: {
        onLongPress(e: UniTouchEvent) {
            this.$emit('longpress', e)
        },
        openArticle(url: string) {
            uni.navigateTo({
                url: `/pages/misc/WebViewPage?url=${encodeURIComponent(url)}`,
                fail: (e) => {
                    console.log('navigate to WebViewPage error', e)
                }
            } as NavigateToOptions);
        }
    }
}
</script>

<style scoped>
.articles-container {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 10px 0;
    justify-content: center;
}

.top-article {
    position: relative;
    width: 300px;
    background-color: #ffffff;
    padding: 10px;
    border-radius: 5px;
    margin: 5px 0;
}

.top-cover {
    width: 280px;
    height: 150px;
}

.top-title {
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: 15px;
}

.sub-article {
    width: 300px;
    background-color: #ffffff;
    padding: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
}

.sub-title {
    flex: 1;
    font-size: 14px;
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.sub-cover {
    width: 50px;
    height: 50px;
    margin-left: 10px;
}
</style>
