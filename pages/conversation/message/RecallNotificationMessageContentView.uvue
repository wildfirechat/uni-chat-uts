<template>
    <view class="notification-container">
        <text class="notification" :style="{ fontSize: fontPx(14), color: c.textTertiary }">{{ message.messageContent.digest(message) }}</text>
        <text v-if="reeditable" class="reedit" :style="{ fontSize: fontPx(14), color: c.accent }" @tap="reedit">重新编辑</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import wfc from "@/wfc/client/wfc.uts";
import MessageContentType from "@/wfc/messages/messageContentType.uts";
import RecallMessageNotification from "@/wfc/messages/notification/recallMessageNotification.uts";
import Config from "@/config.uts";
import eventBus from "@/common/eventBus.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "RecallNotificationMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const reeditable = computed<boolean>((): boolean => {
    const delta = wfc.getServerDeltaTime();
    const now = new Date().getTime();
    const content = props.message.messageContent
    if (!(content instanceof RecallMessageNotification)) {
        return false
    }
    const recallMessageContent = content as RecallMessageNotification;
    return recallMessageContent.originalContentType == MessageContentType.Text
        && recallMessageContent.fromSelf
        && now - (props.message.timestamp - delta) < Config.RECALL_REEDIT_TIME_LIMIT * 1000;
})

const reedit = () => {
    const content = props.message.messageContent
    if (content instanceof RecallMessageNotification) {
        // 通过 eventBus 通知会话页把原文本填回输入框
        eventBus.$emit('reeditMessage', (content as RecallMessageNotification).originalSearchableContent)
    }
}
</script>

<style scoped>
.notification-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.notification {
    margin: 20px 0;
}

.reedit {
    margin-left: 10px;
}
</style>
