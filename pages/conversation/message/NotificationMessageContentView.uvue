<template>
    <view class="notification-container">
        <text class="notification" :style="{ fontSize: fontPx(14), color: c.textTertiary }">{{ digest }}</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "NotificationMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const digest = computed<string>((): string => {
    const message = props.message as Message
    return message.messageContent.digest(message)
})
</script>

<style scoped>
.notification-container {
    display: flex;
    flex-direction: row;
    justify-content: center;
}

.notification {
    margin: 20px 10px;
    text-align: center;
}
</style>
