    height: 25px;
    margin: 15px 20px 0 15px;
    flex: 1;
    border-radius: 3px;
    border: 1px solid #ededed;
    background-color: #ffffff;
    padding-left: 10px;
}

.back-pick-conversation {
    background-color: #f7f7f7;
    height: 40px;
    padding-left: 15px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.back-pick-conversation-text {
    font-size: 13px;
}

.user-list-container {
    flex: 1;
}

.checked-user-list-container {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    background-color: #ffffff;
}

.panel-header {
    height: 55px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.panel-title {
    font-size: 16px;
    margin-left: 30px;
}

.panel-desc {
    font-size: 12px;
    margin-right: 20px;
}

.confirm {
    font-size: 12px;
    margin-right: 20px;
    color: #4168e0;
}

.picked-content {
    flex: 1;
    display: flex;
    flex-direction: row;
    padding: 0 30px;
}

.picked-user-container {
    width: 65px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5px 10px;
}

.picked-user {
    position: relative;
    height: 65px;
    width: 65px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.avatar {
    width: 45px;
    height: 45px;
    background-color: #d6d6d6;
    border-radius: 3px;
}

.name {
    width: 100%;
    font-size: 12px;
    text-align: center;
}
</style>
