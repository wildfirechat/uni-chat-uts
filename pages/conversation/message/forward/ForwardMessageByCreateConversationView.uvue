    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
}

.user-list-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background-color: #f7f7f7;
    overflow: hidden;
}

.input-container {
    display: flex;
    flex-direction: row;
    width: 100%;
}

