    padding-left: 15px;
    background-color: #ffffff;
}

.item-header {
    padding: 10px 12px 10px 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.avatar {
    width: 45px;
    height: 45px;
    background-color: #d6d6d6;
    border-radius: 3px;
}

.title {
    font-size: 14px;
    color: #262626;
    padding-right: 10px;
    flex: 1;
}

.checkbox {
    margin-right: 0;
}

.checked-conversation-list-container {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    background-color: #ffffff;
}

.panel-header {
    height: 55px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

