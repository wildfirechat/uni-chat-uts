    background-color: #f7f7f7;
    font-size: 12px;
    color: #888888;
    padding-left: 15px;
}

.conversation-item {
    width: 100%;
    height: 70px;
    display: flex;
    flex-direction: row;
    border-bottom: 1px solid #eeeeee;
    align-items: center;
    justify-content: flex-start;
    padding-left: 15px;
    background-color: #ffffff;
}

.item-header {
    padding: 10px 12px 10px 15px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.avatar {
    width: 45px;
    height: 45px;
    background-color: #d6d6d6;
    border-radius: 3px;
}

.title {
    font-size: 14px;
    color: #262626;
    padding-right: 10px;
    flex: 1;
}

.checkbox {
    margin-right: 0;
}

.checked-conversation-list-container {
    display: flex;
    min-height: 230px;
    flex-direction: column;
    background-color: #ffffff;
}

.panel-header {
    height: 55px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.panel-title {
    font-size: 16px;
    margin-left: 30px;
}

.panel-desc {
    font-size: 12px;
    margin-right: 20px;
}

.confirm {
    font-size: 12px;
    margin-right: 20px;
    color: #4168e0;
}

.picked-content {
    flex: 1;
    display: flex;
    flex-direction: row;
    padding: 0 30px;
}

.picked-user-container {
    width: 65px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5px 10px;
}

.name {
    width: 100%;
    font-size: 12px;
    text-align: center;
}

.picked-user {
    position: relative;
    height: 65px;
    width: 65px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
</style>
