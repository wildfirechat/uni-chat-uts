    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
}

.conversation-list-panel {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background-color: #f7f7f7;
    overflow: hidden;
}

.input-container {
    display: flex;
    flex-direction: row;
    width: 100%;
}

.search-input {
    height: 25px;
    margin: 15px 20px 0 15px;
    flex: 1;
    border-radius: 3px;
    border: 1px solid #ededed;
    background-color: #ffffff;
    padding-left: 10px;
}

.create-group {
    background-color: #f7f7f7;
    height: 40px;
    padding-left: 15px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

