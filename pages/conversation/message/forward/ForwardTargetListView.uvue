<template>
    <list-item v-for="(item, index) in flatItems" :key="index" class="target-row-item">
        <!-- 创建群聊入口 -->
        <view v-if="item.kind == KIND_CREATE_GROUP" class="create-group" :style="{ backgroundColor: c.surface }"
            @tap="onCreateGroupTap">
            <view class="create-group-icon-box" :style="{ backgroundColor: c.accent }">
                <text class="icomoon create-group-icon" :style="{ color: c.onAccent }">&#xf39f;</text>
            </view>
            <text class="create-group-label" :class="fs16" :style="{ color: c.textPrimary }">{{ item.label }}</text>
        </view>

        <!-- 分段标题（最近聊天 / 好友 / 群组） -->
        <view v-else-if="item.kind == KIND_SECTION" class="section" :style="{ backgroundColor: c.sectionGap }">
            <text class="section-label" :class="fs12" :style="{ color: c.textSecondary }">{{ item.label }}</text>
        </view>

        <!-- 搜索无结果 -->
        <view v-else-if="item.kind == KIND_EMPTY" class="empty">
            <text class="empty-label" :class="fs14" :style="{ color: c.textSecondary }">{{ item.label }}</text>
        </view>

        <!-- 会话行 -->
        <view v-else class="row-wrapper" :style="{ backgroundColor: c.surface }" @tap="onRowTap(item)">
            <view class="row">
                <image class="portrait" mode="aspectFill" :src="portraitOf(item)" :style="{ backgroundColor: c.inputBg }" />
                <text class="title" :class="fs16" :style="{ color: c.textPrimary }">{{ titleOf(item) }}</text>
                <round-checkbox v-if="item.showCheckbox" :checked="isItemSelected(item)" />
            </view>
            <view v-if="item.showDivider" class="row-divider" :style="{ backgroundColor: c.hairlineSoft }"></view>
        </view>
    </list-item>
</template>

<script setup lang="uts">
/**
 * 转发目标列表。对齐 `../flutter-chat/chat/lib/conversation/forward/widgets/forward_target_list.dart`。
 *
 * 搜索为空时：「创建群聊」入口 + 「最近聊天」分段；否则：「好友」+「群组」两段搜索结果。
 * 与 flutter 一致，**搜索结果行不带勾选框**，最近聊天行只在多选态带。
 *
 * 本组件的根节点是 list-item，必须放在 list-view 里用（同 CheckableUserListView）。
 * 走鸿蒙 vapor 的复用渲染路径：尺寸、字号一律留在 class 里，只有颜色走 :style，
 * 见 M0「鸿蒙 list-view 是复用渲染」。
 *
 * 最近聊天行的标题/头像**不在 computed 里预解析** —— 2000+ 群会话时全量
 * ensureConversationTarget 会打出几千次远程拉取（见「鸿蒙 ShortLink 线程风暴」），
 * 交给模板方法在真正渲染那一行时才解析，靠 list-view 的懒渲染兜住。
 */
import store from "@/store.uts";
import Config from "@/config.uts";
import Conversation from "@/wfc/model/conversation.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import ConversationType from "@/wfc/model/conversationType.uts";
import GroupInfo from "@/wfc/model/groupInfo.uts";
import UserInfo from "@/wfc/model/userInfo.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontClass } from "@/common/layoutScale.uts";
import { t } from "@/i18n/i18n.uts";

const KIND_CREATE_GROUP = 0
const KIND_SECTION = 1
const KIND_EMPTY = 2
const KIND_ROW = 3

class ForwardTargetItem {
    kind: number = KIND_ROW
    label: string = ''
    conversation: Conversation | null = null
    /** 搜索结果的标题/头像随结果一起返回，直接带过来；最近聊天行留空，渲染时才解析 */
    title: string = ''
    portrait: string = ''
    showCheckbox: boolean = false
    showDivider: boolean = false
}

defineOptions({
    name: "ForwardTargetListView"
})

const c = computed<AppColors>((): AppColors => colors())

// list-item 内部字号只能切静态 class，不能走 :style，见 common/layoutScale.uts
const fs12 = computed<string>((): string => fontClass(12))
const fs14 = computed<string>((): string => fontClass(14))
const fs16 = computed<string>((): string => fontClass(16))

const props = withDefaults(defineProps<{
    conversationInfos: ConversationInfo[]
    /** 非空即搜索态：列表换成好友 + 群组两段结果 */
    searchText?: string
    searchedFriends?: UserInfo[]
    searchedGroups?: GroupInfo[]
    multiSelect?: boolean
    selectedConversations?: Conversation[]
}>(), {
    searchText: '',
    searchedFriends: (): UserInfo[] => [] as UserInfo[],
    searchedGroups: (): GroupInfo[] => [] as GroupInfo[],
    multiSelect: false,
    selectedConversations: (): Conversation[] => [] as Conversation[]
})

const emit = defineEmits(['targetTap', 'createGroupTap'])

const flatItems = computed<ForwardTargetItem[]>((): ForwardTargetItem[] => {
    const items: ForwardTargetItem[] = []

    if (props.searchText == '') {
        const entry = new ForwardTargetItem()
        entry.kind = KIND_CREATE_GROUP
        entry.label = t('forward.create_group_chat')
        items.push(entry)

        const header = new ForwardTargetItem()
        header.kind = KIND_SECTION
        header.label = t('forward.recent_chats')
        items.push(header)

        const infos = props.conversationInfos
        for (let i = 0; i < infos.length; i++) {
            const row = new ForwardTargetItem()
            row.conversation = infos[i].conversation
            row.showCheckbox = props.multiSelect
            row.showDivider = i < infos.length - 1
            items.push(row)
        }
        return items
    }

    const friends = props.searchedFriends
    if (friends.length > 0) {
        const header = new ForwardTargetItem()
        header.kind = KIND_SECTION
        header.label = t('forward.friends')
        items.push(header)
        for (let i = 0; i < friends.length; i++) {
            const user = friends[i]
            const row = new ForwardTargetItem()
            row.conversation = new Conversation(ConversationType.Single, user.uid, 0)
            row.title = user._displayName
            row.portrait = user.portrait
            row.showDivider = i < friends.length - 1
            items.push(row)
        }
    }

    const groups = props.searchedGroups
    if (groups.length > 0) {
        const header = new ForwardTargetItem()
        header.kind = KIND_SECTION
        header.label = t('forward.groups')
        items.push(header)
        for (let i = 0; i < groups.length; i++) {
            const group = groups[i]
            const row = new ForwardTargetItem()
            row.conversation = new Conversation(ConversationType.Group, group.target, 0)
            row.title = group.name
            row.portrait = group.portrait
            row.showDivider = i < groups.length - 1
            items.push(row)
        }
    }

    if (items.length == 0) {
        const empty = new ForwardTargetItem()
        empty.kind = KIND_EMPTY
        empty.label = t('forward.no_search_result')
        items.push(empty)
    }
    return items
})

const titleOf = (item: ForwardTargetItem): string => {
    if (item.title != '') {
        return item.title
    }
    const conversation = item.conversation
    if (conversation == null) {
        return ''
    }
    const target = store.ensureConversationTarget(conversation)
    return target != null ? target._displayName : ''
}

const portraitOf = (item: ForwardTargetItem): string => {
    const conversation = item.conversation
    let portrait = item.portrait
    if (portrait == '' && conversation != null) {
        const target = store.ensureConversationTarget(conversation)
        portrait = target != null ? target.portrait : ''
    }
    if (portrait != '') {
        return portrait
    }
    const isGroup = conversation != null && conversation.type != ConversationType.Single
    return isGroup ? Config.DEFAULT_GROUP_PORTRAIT_URL : Config.DEFAULT_PORTRAIT_URL
}

const isItemSelected = (item: ForwardTargetItem): boolean => {
    const conversation = item.conversation
    if (conversation == null) {
        return false
    }
    return props.selectedConversations.findIndex((conv: Conversation): boolean => conv.equal(conversation)) >= 0
}

const onRowTap = (item: ForwardTargetItem) => {
    const conversation = item.conversation
    if (conversation != null) {
        emit('targetTap', conversation)
    }
}

const onCreateGroupTap = () => {
    emit('createGroupTap')
}
</script>

<style scoped>
/* 组件吃不到全局 class（样式隔离 2.0），图标字体自己声明一份 */
.icomoon {
    font-family: "icomoon";
}

.target-row-item {
    width: 100%;
}

.create-group {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 10px 16px;
}

.create-group-icon-box {
    width: 40px;
    height: 40px;
    border-radius: 4px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
}

/* flutter 用 Icons.group_add_rounded，icomoon(Ionicons) 里取最接近的 ion-android-person-add。
   图标是图形，字号刻意不跟字号档位放大 */
.create-group-icon {
    font-size: 22px;
}

.create-group-label {
    flex: 1;
    margin-left: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

.section {
    width: 100%;
    padding: 8px 16px;
}

.section-label {
    white-space: nowrap;
}

.empty {
    width: 100%;
    padding: 40px 16px;
    display: flex;
    flex-direction: row;
    justify-content: center;
}

.row-wrapper {
    width: 100%;
    display: flex;
    flex-direction: column;
}

.row {
    width: 100%;
    height: 64px;
    display: flex;
    flex-direction: row;
    align-items: center;
    padding: 0 16px;
}

.portrait {
    width: 48px;
    height: 48px;
    border-radius: 4px;
    flex-shrink: 0;
}

/* 要截断的文字自己 flex:1；单行截断用 white-space，lines 在鸿蒙 vapor 下无效 */
.title {
    flex: 1;
    margin-left: 12px;
    margin-right: 12px;
    white-space: nowrap;
    text-overflow: ellipsis;
    overflow: hidden;
}

/* 分隔线缩进 = 16(左边距) + 48(头像) + 12(间距)，对齐 flutter 的 Divider(indent)。
   走正常流排在行下面，不用 position: absolute —— 行本身在复用渲染的 list-item 里，
   少一层定位少一个变量 */
.row-divider {
    height: 0.5px;
    margin-left: 76px;
}
</style>
