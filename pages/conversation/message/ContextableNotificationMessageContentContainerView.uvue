<template>
    <view>
        <view class="message-time-container"
            :style="{ backgroundColor: isMessageChecked ? c.cellSelected : 'transparent' }">
            <text v-if="showTime" class="time"
                :style="{ fontSize: fontPx(10), color: c.textTertiary, backgroundColor: c.conversationBg }">{{ timeStr }}</text>
            <view class="message-content-container">
                <round-checkbox v-if="enableMessageMultiSelection" class="checkbox" :checked="isMessageChecked" />
                <RichNotificationMessageContentView :message="message" v-if="contentType == 12"
                    @longpress="openMessageContextMenu" />
                <ArticlesMessageContentView :message="message" v-else-if="contentType == 13"
                    @longpress="openMessageContextMenu" />
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import RichNotificationMessageContentView from "./RichNotificationMessageContentView.uvue";
import ArticlesMessageContentView from "./ArticlesMessageContentView.uvue";
import Message from "@/wfc/messages/message.uts";
import { conversationState, pickState } from "@/store.uts";
import eventBus from "@/common/eventBus.uts";
import { OpenMessageContextMenuEvent } from "./messageEvents.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "ContextableNotificationMessageContentContainerView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const showTime = computed<boolean>((): boolean => (props.message as Message)._showTime)
const timeStr = computed<string>((): string => (props.message as Message)._timeStr)
const contentType = computed<number>((): number => (props.message as Message).messageContent.type)

const enableMessageMultiSelection = computed<boolean>((): boolean => {
    return conversationState.enableMessageMultiSelection
})

const isMessageChecked = computed<boolean>((): boolean => {
    const message = props.message as Message
    return pickState.messages.findIndex((m: Message): boolean => m.messageId == message.messageId) >= 0;
})

const openMessageContextMenu = (event: UniTouchEvent) => {
    eventBus.$emit('openMessageContextMenu', new OpenMessageContextMenuEvent(event, props.message as Message))
}
</script>

<style scoped>
.message-time-container {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.message-time-container.checked {
}

.time {
    width: 100%;
    text-align: center;
}

.message-content-container {
    width: 100%;
    display: flex;
    flex-direction: row;
    padding: 10px 20px 4px 20px;
    justify-content: center;
    align-items: center;
    position: relative;
}

.checkbox {
    position: absolute;
    left: 0;
    margin-left: 20px;
}
</style>
