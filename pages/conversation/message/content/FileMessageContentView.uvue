<template>
    <view class="file-message-container" @tap="clickFile" :class="{ out: message.direction == 0 }">
        <image class="file-icon" :src="fileIcon" />
        <view class="flex-column flex-align-start file-info">
            <text class="file-name">{{ content.name }}</text>
            <text class="file-size single-line">{{ size }}</text>
        </view>
    </view>
</template>

<script lang="uts">
import Message from "@/wfc/messages/message.uts";
import FileMessageContent from "@/wfc/messages/fileMessageContent.uts";
import { humanSize, getFiletypeIcon } from "@/pages/util/helper.uts";

export default {
    name: "FileMessageContentView",
    props: {
        message: {
            type: Object as PropType<Message>,
            required: true,
        }
    },
    computed: {
        content(): FileMessageContent {
            return this.message.messageContent as FileMessageContent
        },
        size(): string {
            return humanSize(this.content.size)
        },
        fileIcon(): string {
            const fileName = this.content.name;
            const icon = getFiletypeIcon(fileName.substring(fileName.lastIndexOf('.') + 1))
            return "/static/image/filetypes/" + icon;
        },
    },
    methods: {
        clickFile() {
            uni.downloadFile({
                url: this.content.remotePath,
                success: (res) => {
                    const filePath = res.tempFilePath;
                    console.log('download file success', filePath);
                    uni.openDocument({
                        filePath: filePath,
                        success: (_) => {
                            console.log('打开文档成功');
                        },
                        fail: (err) => {
                            console.log('打开文档失败', err);
                            uni.showToast({
                                title: '打开文档失败',
                                icon: 'none',
                            } as ShowToastOptions);
                        }
                    } as OpenDocumentOptions);
                },
                fail: (err) => {
                    console.log('download file fail', err);
                }
            } as DownloadFileOptions);
        },
    },
}
</script>

<style scoped>
.file-message-container {
    margin: 0 10px;
    padding: 10px;
    background-color: #ffffff;
    position: relative;
    border-radius: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    max-width: 220px;
    min-width: 150px;
}

.file-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 3px;
}

.file-info {
    flex: 1;
}

.file-name {
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: 14px;
}

.file-size {
    color: #888888;
    font-size: 13px;
}
</style>
