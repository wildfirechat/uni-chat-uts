<template>
    <view class="file-message-container" @tap="clickFile" :class="{ out: message.direction == 0 }"
        :style="{ backgroundColor: message.direction == 0 ? c.bubbleSent : c.bubbleReceived }">
        <image class="file-icon" :src="fileIcon" />
        <view class="flex-column flex-align-start file-info">
            <text class="file-name" :style="{ color: message.direction == 0 ? c.bubbleSentText : c.bubbleReceivedText }">{{ content.name }}</text>
            <text class="file-size single-line" :style="{ color: c.textSecondary }">{{ size }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import FileMessageContent from "@/wfc/messages/fileMessageContent.uts";
import { humanSize, getFiletypeIcon } from "@/pages/util/helper.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "FileMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const content = computed<FileMessageContent>((): FileMessageContent => {
    return props.message.messageContent as FileMessageContent
})

const size = computed<string>((): string => {
    return humanSize(content.value.size)
})

const fileIcon = computed<string>((): string => {
    const fileName = content.value.name;
    const icon = getFiletypeIcon(fileName.substring(fileName.lastIndexOf('.') + 1))
    return "/static/image/filetypes/" + icon;
})

const clickFile = () => {
    uni.downloadFile({
        url: content.value.remotePath,
        success: (res) => {
            const filePath = res.tempFilePath;
            console.log('download file success', filePath);
            uni.openDocument({
                filePath: filePath,
                success: (_) => {
                    console.log('打开文档成功');
                },
                fail: (err) => {
                    console.log('打开文档失败', err);
                    uni.showToast({
                        title: '打开文档失败',
                        icon: 'none',
                    } as ShowToastOptions);
                }
            } as OpenDocumentOptions);
        },
        fail: (err) => {
            console.log('download file fail', err);
        }
    } as DownloadFileOptions);
}
</script>

<style scoped>
.file-message-container {
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-start;
    max-width: 220px;
    min-width: 150px;
}

.file-icon {
    width: 32px;
    height: 32px;
    margin-right: 10px;
    border-radius: 3px;
}

.file-info {
    flex: 1;
}

.file-name {
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
    font-size: 14px;
}

.file-size {
    font-size: 13px;
}
</style>
