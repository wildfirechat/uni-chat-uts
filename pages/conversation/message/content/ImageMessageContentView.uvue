<template>
    <view class="image-content-container" :style="{ borderColor: c.hairlineSoft }">
        <image class="image" :style="{ width: imageWidth + 'px', height: imageHeight + 'px' }" mode="aspectFill"
            @tap="preview" :src="imageSrc" />
    </view>
</template>

<script setup lang="uts">
import Message from "../../../../wfc/messages/message.uts";
import ImageMessageContent from "../../../../wfc/messages/imageMessageContent.uts";
import Config from "../../../../config.uts";
import { conversationState } from "../../../../store.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "ImageMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = withDefaults(defineProps<{
    message: Message
    isInCompositeView?: boolean
}>(), {
    isInCompositeView: false
})

const emit = defineEmits(['previewCompositeMessage'])

const content = computed<ImageMessageContent>((): ImageMessageContent => {
    const message = props.message as Message
    return message.messageContent as ImageMessageContent
})

const imageWidth = computed<number>((): number => {
    const iw = content.value.imageWidth
    const ih = content.value.imageHeight
    if (iw > 0 && ih > 0) {
        const scale = Math.min(200 / iw, 200 / ih, 1)
        return Math.floor(iw * scale)
    }
    return 120
})

const imageHeight = computed<number>((): number => {
    const iw = content.value.imageWidth
    const ih = content.value.imageHeight
    if (iw > 0 && ih > 0) {
        const scale = Math.min(200 / iw, 200 / ih, 1)
        return Math.floor(ih * scale)
    }
    return 120
})

const imageSrc = computed<string>((): string => {
    const messageContent = content.value
    if (messageContent.remotePath != '') {
        return messageContent.remotePath
    }
    if (messageContent.localPath != '') {
        return messageContent.localPath
    }
    if (messageContent.thumbnail != '') {
        return 'data:image/jpeg;base64,' + messageContent.thumbnail
    }
    return Config.DEFAULT_THUMBNAIL_URL
})

const preview = () => {
    const message = props.message as Message
    if (props.isInCompositeView) {
        emit('previewCompositeMessage', message.messageUid);
        return
    }
    // 会话内的图片消息串成一组，支持左右滑动切换
    const currentUrl = content.value.remotePath
    const urls: string[] = []
    const msgs = conversationState.currentConversationMessageList
    for (let i = 0; i < msgs.length; i++) {
        const c = msgs[i].messageContent
        if (c instanceof ImageMessageContent) {
            const path = (c as ImageMessageContent).remotePath
            if (path != '') {
                urls.push(path)
            }
        }
    }
    // 必须显式标 number：indexOf 在 android 上返回 Int，不标类型后面赋 urls.length - 1（Number）会类型不匹配
    let current: number = urls.indexOf(currentUrl)
    if (current < 0) {
        urls.push(currentUrl)
        current = urls.length - 1
    }
    uni.previewImage({
        urls: urls,
        current: current,
    } as PreviewImageOptions);
}
</script>

<style scoped>
.image-content-container {
    margin: 0 10px;
    position: relative;
    border-width: 1px;
    border-style: solid;
    border-radius: 5px;
}

.image {
    border-radius: 5px;
    overflow: hidden;
}
</style>
