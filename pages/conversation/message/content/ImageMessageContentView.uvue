<template>
    <view class="image-content-container">
        <image class="image" :style="{ width: imageWidth + 'px', height: imageHeight + 'px' }" mode="aspectFill"
            @tap="preview" :src="imageSrc" />
    </view>
</template>

<script setup lang="uts">
import Message from "../../../../wfc/messages/message.uts";
import ImageMessageContent from "../../../../wfc/messages/imageMessageContent.uts";
import Config from "../../../../config.uts";

defineOptions({
    name: "ImageMessageContentView"
})

const props = withDefaults(defineProps<{
    message: Message
    isInCompositeView?: boolean
}>(), {
    isInCompositeView: false
})

const emit = defineEmits(['previewCompositeMessage'])

const content = computed<ImageMessageContent>((): ImageMessageContent => {
    return props.message.messageContent as ImageMessageContent
})

const imageWidth = computed<number>((): number => {
    const iw = content.value.imageWidth
    const ih = content.value.imageHeight
    if (iw > 0 && ih > 0) {
        const scale = Math.min(200 / iw, 200 / ih, 1)
        return Math.floor(iw * scale)
    }
    return 120
})

const imageHeight = computed<number>((): number => {
    const iw = content.value.imageWidth
    const ih = content.value.imageHeight
    if (iw > 0 && ih > 0) {
        const scale = Math.min(200 / iw, 200 / ih, 1)
        return Math.floor(ih * scale)
    }
    return 120
})

const imageSrc = computed<string>((): string => {
    const messageContent = content.value
    if (messageContent.remotePath != '') {
        return messageContent.remotePath
    }
    if (messageContent.localPath != '') {
        return messageContent.localPath
    }
    if (messageContent.thumbnail != '') {
        return 'data:image/jpeg;base64,' + messageContent.thumbnail
    }
    return Config.DEFAULT_THUMBNAIL_URL
})

const preview = () => {
    if (props.isInCompositeView) {
        emit('previewCompositeMessage', props.message.messageUid);
    } else {
        uni.previewImage({
            urls: [content.value.remotePath]
        } as PreviewImageOptions);
    }
}
</script>

<style scoped>
.image-content-container {
    margin: 0 10px;
    position: relative;
    border: 1px solid #efefef;
    border-radius: 5px;
}

.image {
    border-radius: 5px;
    overflow: hidden;
}
</style>
