<template>
    <view class="sticker-content-container" :style="{ borderColor: c.hairlineSoft }">
        <image class="sticker" mode="aspectFit" :src="stickerSrc" />
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import StickerMessageContent from "@/wfc/messages/stickerMessageContent.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "StickerMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const stickerSrc = computed<string>((): string => {
    const content = props.message.messageContent as StickerMessageContent
    if (content.remotePath != '') {
        return content.remotePath
    }
    return content.localPath
})
</script>

<style scoped>
.sticker-content-container {
    margin: 0 10px;
    position: relative;
    border-width: 1px;
    border-style: solid;
    border-radius: 5px;
}

.sticker {
    width: 100px;
    height: 100px;
    border-radius: 5px;
    overflow: hidden;
}
</style>
