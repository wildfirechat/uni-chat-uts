<template>
    <view class="conference-invite-message-container" @tap="showConferenceInfo"
        :class="{ out: isOut }" :style="{ backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }">
        <view class="flex-row flex-align-center">
            <image class="avatar" :src="portrait" :style="{ backgroundColor: c.inputBg }" />
            <view class="flex-1">
                <text class="single-line title" :style="{ fontSize: fontPx(16), color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">{{ content.title }} </text>
                <text class="single-line desc" :style="{ fontSize: fontPx(14), color: c.textSecondary }">{{ content.desc }}</text>
            </view>
        </view>
        <text class="type" :style="{ fontSize: fontPx(14), color: c.textSecondary, borderTopColor: c.hairlineSoft }">会议邀请</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import ConferenceInviteMessageContent from "@/wfc/av/messages/conferenceInviteMessageContent.uts";
import store from "@/store.uts";
import ConversationType from "@/wfc/model/conversationType.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "ConferenceInviteMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const isOut = computed<boolean>((): boolean => (props.message as Message).direction == 0)

const content = computed<ConferenceInviteMessageContent>((): ConferenceInviteMessageContent => {
    const message = props.message as Message
    return message.messageContent as ConferenceInviteMessageContent
})

const portrait = computed<string>((): string => {
    const message = props.message as Message
    const groupId = message.conversation.type == ConversationType.Group ? message.conversation.target : '';
    const userInfos = store.getUserInfos([content.value.host], groupId)
    return userInfos.length > 0 ? userInfos[0].portrait : '';
})

const showConferenceInfo = () => {
    // uni-app x 版本暂不支持音视频会议
    uni.showToast({
        title: '当前版本不支持会议功能',
        icon: 'none',
    } as ShowToastOptions);
}
</script>

<style scoped>
.conference-invite-message-container {
    margin: 0 10px;
    padding: 5px;
    width: 250px;
    position: relative;
    border-radius: 5px;
}

.avatar {
    width: 60px;
    height: 60px;
    border-radius: 3px;
    margin: 5px 10px;
}

.type {
    padding-top: 5px;
    margin: 5px 10px 0 10px;
    border-top-width: 1px;
    border-top-style: solid;
}

</style>
