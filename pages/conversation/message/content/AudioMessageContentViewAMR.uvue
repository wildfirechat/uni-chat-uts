<template>
    <view class="audio-message-wrapper">
        <view class="audio-message-container"
            :style="{ width: containerWidth + 'px', backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }" @tap="playVoice">
            <text v-if="isOut" class="duration" :style="{ fontSize: fontPx(14) }">{{ duration }}"</text>
            <view class="volume-container" :style="{ color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">
                <text v-if="!isPlaying" class="icomoon volume-icon">&#xf3ba;</text>
                <text v-if="isPlaying" class="icomoon volume-icon">&#xf210;</text>
            </view>
            <text v-if="!isOut" class="duration" :style="{ fontSize: fontPx(14) }">{{ duration }}"</text>
        </view>
        <!-- 语音转文字结果贴在气泡下面，与 flutter voice_cell_builder 一致 -->
        <view v-if="speechText != '' || inProgress" class="speech-container"
            :style="{ width: containerWidth + 'px', backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }">
            <text class="speech-text"
                :style="{ fontSize: fontPx(14), color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">{{ inProgress ? t('asr.converting') : speechText }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import SoundMessageContent from "@/wfc/messages/soundMessageContent.uts";
import store from "@/store.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
import { t } from "@/i18n/i18n.uts";
defineOptions({
    name: "AudioMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const isOut = computed<boolean>((): boolean => (props.message as Message).direction == 0)

const content = computed<SoundMessageContent>((): SoundMessageContent => {
    const message = props.message as Message
    return message.messageContent as SoundMessageContent
})

const isPlaying = computed<boolean>((): boolean => {
    return content.value._isPlaying
})

/** 转文字结果。只存在内存里（见 soundMessageContent.uts），杀进程就没了，与 flutter 一致。 */
const speechText = computed<string>((): string => {
    return content.value._speechText
})

const inProgress = computed<boolean>((): boolean => {
    return content.value._speechToTextInProgress
})

const duration = computed<number>((): number => {
    const times = content.value.duration * 1000;
    let seconds: number;
    if (times <= 60 * 1000) {
        seconds = Math.ceil(times / 1000);
    } else {
        seconds = 60;
    }
    return seconds;
})

const containerWidth = computed<number>((): number => {
    let width = Math.ceil(duration.value / 60.0 * 300);
    return width < 100 ? 100 : width;
})

const playVoice = () => {
    const playing = !content.value._isPlaying
    content.value._isPlaying = playing
    if (playing) {
        store.playVoice(props.message as Message)
    } else {
        store.playVoice(null)
    }
}
</script>

<style scoped>
.audio-message-wrapper {
    display: flex;
    flex-direction: column;
}

.audio-message-container {
    margin: 0 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    max-width: 250px;
}

.volume-container {
    flex: 1;
    display: flex;
    flex-direction: row;
    height: 40px;
    min-width: 55px;
    border-radius: 5px;
    padding: 5px 10px;
    align-items: center;
}

.volume-icon {
    font-size: 18px;
}

.duration {
    padding: 8px;
}

.speech-container {
    margin: 4px 10px 0 10px;
    max-width: 250px;
    padding: 8px 10px;
    border-radius: 5px;
}

.speech-text {
    width: 100%;
}
</style>
