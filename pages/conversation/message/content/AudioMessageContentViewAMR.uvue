<template>
    <view class="audio-message-container" :style="{ width: containerWidth + 'px' }" @tap="playVoice">
        <text v-if="message.direction == 0" class="duration">{{ duration }}"</text>
        <view class="volume-container">
            <text v-if="!isPlaying" class="icomoon volume-icon">&#xf3ba;</text>
            <text v-if="isPlaying" class="icomoon volume-icon">&#xf210;</text>
        </view>
        <text v-if="message.direction == 1" class="duration">{{ duration }}"</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import SoundMessageContent from "@/wfc/messages/soundMessageContent.uts";
import store from "@/store.uts";

defineOptions({
    name: "AudioMessageContentView",
    styleIsolation: 'app'
})

const props = defineProps<{
    message: Message
}>()

const content = computed<SoundMessageContent>((): SoundMessageContent => {
    return props.message.messageContent as SoundMessageContent
})

const isPlaying = computed<boolean>((): boolean => {
    return content.value._isPlaying
})

const duration = computed<number>((): number => {
    const times = content.value.duration * 1000;
    let seconds: number;
    if (times <= 60 * 1000) {
        seconds = Math.ceil(times / 1000);
    } else {
        seconds = 60;
    }
    return seconds;
})

const containerWidth = computed<number>((): number => {
    let width = Math.ceil(duration.value / 60.0 * 300);
    return width < 100 ? 100 : width;
})

const playVoice = () => {
    const playing = !content.value._isPlaying
    content.value._isPlaying = playing
    if (playing) {
        store.playVoice(props.message)
    } else {
        store.playVoice(null)
    }
}
</script>

<style scoped>
.audio-message-container {
    margin: 0 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    max-width: 250px;
}

.volume-container {
    flex: 1;
    display: flex;
    flex-direction: row;
    height: 40px;
    min-width: 55px;
    background-color: #ffffff;
    border-radius: 5px;
    padding: 5px 10px;
    align-items: center;
}

.volume-icon {
    color: #888888;
    font-size: 18px;
}

.duration {
    color: #b2b2b2;
    padding: 8px;
    font-size: 14px;
}
</style>
