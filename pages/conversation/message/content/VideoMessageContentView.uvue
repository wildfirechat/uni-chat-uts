<template>
    <view class="video-content-container" :style="{ borderColor: c.hairlineSoft }">
        <image class="thumbnail" mode="aspectFill" @tap="preview" :src="thumbnailUri" />
        <text class="wxfont play-button" :style="{ color: c.onAccent }" @tap="preview">&#xe6a6;</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import MessageStatus from "../../../../wfc/messages/messageStatus.uts";
import VideoMessageContent from "../../../../wfc/messages/videoMessageContent.uts";
import Config from "../../../../config.uts";
import store from "../../../../store.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "VideoMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = withDefaults(defineProps<{
    message: Message
    isInCompositeView?: boolean
}>(), {
    isInCompositeView: false
})

const emit = defineEmits(['previewCompositeMessage'])

const content = computed<VideoMessageContent>((): VideoMessageContent => {
    const message = props.message as Message
    return message.messageContent as VideoMessageContent
})

const thumbnailUri = computed<string>((): string => {
    const message = props.message as Message
    if (message.status == MessageStatus.Sending) {
        return Config.DEFAULT_VIDEO_POSTER;
    } else if (content.value.thumbnail != '') {
        return 'data:image/jpeg;base64,' + content.value.thumbnail;
    }
    return Config.DEFAULT_VIDEO_POSTER;
})

const preview = () => {
    const message = props.message as Message
    if (props.isInCompositeView) {
        emit('previewCompositeMessage', message.messageUid);
    } else {
        // 和图片消息共用一个预览页，会话里的图片/视频串成一组左右滑动（PreviewMediaPage）
        store.previewMessage(message, true)
    }
}
</script>

<style scoped>
.video-content-container {
    margin: 0 10px;
    position: relative;
    border-width: 1px;
    border-style: solid;
    border-radius: 5px;
}

.thumbnail {
    width: 200px;
    height: 150px;
    border-radius: 5px;
    overflow: hidden;
}

.play-button {
    position: absolute;
    left: 70px;
    top: 45px;
    font-size: 60px;
}
</style>
