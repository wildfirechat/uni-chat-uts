<template>
    <view @tap="userInfo" class="user-card-content-container" :style="{ backgroundColor: message.direction == 0 ? c.bubbleSent : c.bubbleReceived }">
        <view class="portrait-name-container" :style="{ borderBottomColor: c.hairlineSoft }">
            <image class="portrait" :src="content.portrait" />
            <text class="display-name" :style="{ fontSize: fontPx(15), color: message.direction == 0 ? c.bubbleSentText : c.bubbleReceivedText }">{{ content.displayName }}</text>
        </view>
        <text class="desc single-line" :style="{ fontSize: fontPx(13), color: c.textTertiary }">个人名片</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import CardMessageContent from "@/wfc/messages/cardMessageContent.uts";
import wfc from "@/wfc/client/wfc.uts";
import store from "@/store.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "UserCardMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const content = computed<CardMessageContent>((): CardMessageContent => {
    return props.message.messageContent as CardMessageContent
})

const userInfo = () => {
    const userInfo = wfc.getUserInfo(content.value.target);
    store.setCurrentFriend(userInfo)
    uni.navigateTo({
        url: '/pages/contact/UserDetailPage',
        fail: (err) => {
            console.log('nav to UserDetailPage err', err);
        }
    } as NavigateToOptions)
}
</script>

<style scoped>
.user-card-content-container {
    width: 230px;
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
}

.portrait-name-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    padding-bottom: 10px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.portrait {
    width: 45px;
    height: 45px;
    border-radius: 3px;
}

.display-name {
    padding-left: 10px;
    padding-right: 10px;
}

.desc {
    padding-top: 8px;
}
</style>
