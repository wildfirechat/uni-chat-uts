<template>
    <view class="text-message-container" :class="{ out: isOut }"
        :style="{ backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }">
        <text class="text"
            :style="{ fontSize: fontPx(16), lineHeight: fontPx(25), color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">{{ textContent }}</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";

defineOptions({
    name: "TextMessageContentView"
})

const c = computed<AppColors>((): AppColors => colors())

const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const isOut = computed<boolean>((): boolean => (props.message as Message).direction == 0)

const textContent = computed<string>((): string => {
    // 原 web 版将 emoji 转为 <img> 走 v-html；native 直接渲染 unicode emoji
    const message = props.message as Message
    return message.messageContent.digest(message);
})
</script>

<style scoped>
.text-message-container {
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
    align-self: flex-start;
    /* uni-app x 不支持 vw/calc，rpx 以 750 为屏幕宽：限制气泡最大宽度约为屏幕的 59%，
       长文本在此宽度内自动换行，避免把气泡撑出屏幕导致左侧被裁剪 */
    max-width: 440rpx;
}

/* .out 只保留布局；两种气泡的底色/文字色由 :style 给（要跟明暗主题走） */
.text-message-container.out {
    align-self: flex-end;
}

.text {
    /* 保留换行符；宽度占满气泡内容区，配合 max-width 实现自动换行 */
    white-space: pre-line;
    width: 100%;
}
</style>
