<template>
    <view class="text-message-container" :class="{ out: message.direction == 0 }">
        <text class="text">{{ textContent }}</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";

defineOptions({
    name: "TextMessageContentView"
})

const props = defineProps<{
    message: Message
}>()

const textContent = computed<string>((): string => {
    // 原 web 版将 emoji 转为 <img> 走 v-html；native 直接渲染 unicode emoji
    return props.message.messageContent.digest(props.message);
})
</script>

<style scoped>
.text-message-container {
    margin: 0 10px;
    padding: 10px;
    background-color: #ffffff;
    position: relative;
    border-radius: 5px;
    align-self: flex-start;
    /* uni-app x 不支持 vw/calc，rpx 以 750 为屏幕宽：限制气泡最大宽度约为屏幕的 59%，
       长文本在此宽度内自动换行，避免把气泡撑出屏幕导致左侧被裁剪 */
    max-width: 440rpx;
}

.text-message-container.out {
    background-color: #98ea70;
    align-self: flex-end;
}

.text {
    color: #050505;
    font-size: 16px;
    line-height: 25px;
    /* 保留换行符；宽度占满气泡内容区，配合 max-width 实现自动换行 */
    white-space: pre-line;
    width: 100%;
}
</style>
