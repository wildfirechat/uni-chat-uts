<template>
    <view class="link-message-container" @tap="openLink" :style="{ backgroundColor: message.direction == 0 ? c.bubbleSent : c.bubbleReceived }">
        <view class="link-info">
            <text class="link-title" :style="{ color: message.direction == 0 ? c.bubbleSentText : c.bubbleReceivedText }">{{ title }}</text>
            <text v-if="content.contentDigest != ''" class="link-digest"
                :style="{ color: c.textTertiary }">{{ content.contentDigest }}</text>
        </view>
        <image v-if="content.thumbnail != ''" class="link-thumbnail" :src="content.thumbnail" mode="aspectFill" />
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import LinkMessageContent from "@/wfc/messages/linkMessageContent.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "LinkMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const content = computed<LinkMessageContent>((): LinkMessageContent => {
    return props.message.messageContent as LinkMessageContent
})

const title = computed<string>((): string => {
    const c = content.value
    return c.title.trim() != '' ? c.title : c.url
})

const openLink = () => {
    const url = content.value.url
    if (url == '') {
        return
    }
    uni.navigateTo({
        url: '/pages/misc/WebViewPage?url=' + encodeURIComponent(url),
        fail: (err) => {
            console.log('nav to WebViewPage err', err)
        }
    } as NavigateToOptions)
}
</script>

<style scoped>
.link-message-container {
    margin: 0 10px;
    padding: 10px;
    border-radius: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    max-width: 230px;
    min-width: 150px;
}

.link-info {
    flex: 1;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}

.link-title {
    font-size: 15px;
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.link-digest {
    margin-top: 6px;
    font-size: 13px;
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.link-thumbnail {
    width: 45px;
    height: 45px;
    margin-left: 10px;
    border-radius: 3px;
}
</style>
