<template>
    <view class="call-start-message-container" :class="{ out: isOut }"
        :style="{ backgroundColor: isOut ? c.bubbleSent : c.bubbleReceived }">
        <text class="icomoon call-icon" :style="{ color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">&#xf2d2;</text>
        <text class="text" :style="{ fontSize: fontPx(16), color: isOut ? c.bubbleSentText : c.bubbleReceivedText }">{{ textContent }}</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import CallStartMessageContent from "@/wfc/av/messages/callStartMessageContent.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "CallStartMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

// class 类型的 props 在 android 上编译成 Any，模板里取不到成员，只能在 script 里转好类型再暴露
const isOut = computed<boolean>((): boolean => (props.message as Message).direction == 0)

const textContent = computed<string>((): string => {
    const message = props.message as Message
    const voip = message.messageContent as CallStartMessageContent;
    let desc: string
    if (voip.status == 0) {
        desc = '未接听';
    } else if (voip.status == 1) {
        desc = '通话中';
    } else {
        if (voip.connectTime > 0 && voip.endTime > voip.connectTime) {
            const duration = Math.round((voip.endTime - voip.connectTime) / 1000);
            desc = `通话时长 : ${duration}s`
        } else {
            desc = voip.audioOnly ? '[语音通话]' : '[视频通话]';
        }
    }
    return desc;
})
</script>

<style scoped>
.call-start-message-container {
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.call-start-message-container.out {
}

.call-icon {
    font-size: 18px;
}

.text {
    padding-left: 5px;
}
</style>
