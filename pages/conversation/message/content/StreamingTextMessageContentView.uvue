<template>
    <view class="text-message-container" :class="{ out: message.direction == 0 }"
        :style="{ backgroundColor: message.direction == 0 ? c.bubbleSent : c.bubbleReceived }">
        <text class="text"
            :style="{ color: message.direction == 0 ? c.bubbleSentText : c.bubbleReceivedText }">{{ textContent }}</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";
import MessageContentType from "@/wfc/messages/messageContentType.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "StreamingTextMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const textContent = computed<string>((): string => {
    let text = props.message.messageContent.digest(props.message);
    if (props.message.messageContent.type == MessageContentType.Streaming_Text_Generating) {
        text += ' ...';
    }
    return text;
})
</script>

<style scoped>
.text-message-container {
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
    align-self: flex-start;
    /* uni-app x 不支持 vw/calc，rpx 以 750 为屏幕宽：限制气泡最大宽度约为屏幕的 59%，
       长文本在此宽度内自动换行，避免把气泡撑出屏幕导致左侧被裁剪 */
    max-width: 440rpx;
}

.text-message-container.out {
    align-self: flex-end;
}

.text {
    font-size: 16px;
    line-height: 25px;
    /* 保留换行符；宽度占满气泡内容区，配合 max-width 实现自动换行 */
    white-space: pre-line;
    width: 100%;
}
</style>
