<template>
    <view class="text-message-container" :class="{ out: message.direction == 0 }"
        :style="{ backgroundColor: message.direction == 0 ? c.bubbleSent : c.bubbleReceived }">
        <text class="text"
            :style="{ color: message.direction == 0 ? c.bubbleSentText : c.bubbleReceivedText }">{{ message.messageContent.digest(message) }}</text>
    </view>
</template>

<script setup lang="uts">
import Message from "@/wfc/messages/message.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "TestCustomMessageContentView"
})


const c = computed<AppColors>((): AppColors => colors())
defineProps<{
    message: Message
}>()
</script>

<style scoped>
.text-message-container {
    margin: 0 10px;
    padding: 10px;
    position: relative;
    border-radius: 5px;
}

.text-message-container.out {
}

.text {
    font-size: 16px;
}
</style>
