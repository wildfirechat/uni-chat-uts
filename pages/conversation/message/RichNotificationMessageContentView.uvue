<template>
    <view class="rich-root">
        <view class="notification-container" :style="{ backgroundColor: c.surface }"
            @tap="onClickRichNotification" @longpress="onLongPress">
            <text class="title" :style="{ fontSize: fontPx(16) }">{{ content.title }}</text>
            <text class="desc" :style="{ fontSize: fontPx(14) }">{{ content.desc }}</text>
            <view v-if="content.datas.length > 0">
                <view v-for="(data, index) in content.datas" :key="index" class="data">
                    <text class="key single-line" :style="{ fontSize: fontPx(14) }">{{ data.getString('key') ?? '' }}</text>
                    <text class="value" :style="{ fontSize: fontPx(14) }">{{ data.getString('value') ?? '' }}</text>
                </view>
            </view>
            <view class="ex-info-container" :style="{ borderTopColor: c.hairline }">
                <text class="exName" :style="{ fontSize: fontPx(14) }">{{ content.exName }}</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import Message from "../../../wfc/messages/message.uts";
import RichNotificationMessageContent from "../../../wfc/messages/notification/richNotificationMessageContent.uts";
import { navigateToPage } from "../../../common/nav.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "RichNotificationMessageContentView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    message: Message
}>()

const emit = defineEmits(['longpress'])

const content = computed<RichNotificationMessageContent>((): RichNotificationMessageContent => {
    const message = props.message as Message
    return message.messageContent as RichNotificationMessageContent
})

const onLongPress = (e: UniTouchEvent) => {
    emit('longpress', e)
}

const onClickRichNotification = () => {
    const targetPageUrl = '/pages/workspace/WorkspaceWebViewPage';
    navigateToPage(`${targetPageUrl}?url=${encodeURIComponent(content.value.exUrl)}`, null);
}
</script>

<style scoped>
.rich-root {
    display: flex;
    flex-direction: row;
    justify-content: center;
}

.notification-container {
    width: 300px;
    padding: 5px 10px;
    border-radius: 5px;
    margin: 5px 0;
}

.title {
    margin: 5px 0;
}

.data {
    display: flex;
    flex-direction: row;
}

.key {
    width: 100px;
}

.value {
    flex: 1;
    lines: 3;
    text-overflow: ellipsis;
    overflow: hidden;
}

.ex-info-container {
    border-top-width: 1px;
    border-top-style: solid;
    padding-top: 5px;
    margin: 5px 0;
}

</style>
