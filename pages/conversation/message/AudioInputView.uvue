<template>
    <view class="TUI-message-input-main" @longpress="handleLongPress" @touchmove="handleTouchMove"
        @touchend="handleTouchEnd">
        <text class="record-text" :style="{ fontSize: fontPx(15), backgroundColor: c.surface, color: c.textPrimary }">{{ text }}</text>
        <view class="record-modal" v-if="popupToggle" :style="{ backgroundColor: c.scrim }">
            <view class="wrapper">
                <view class="modal-loading" :style="{ backgroundColor: c.accent }"></view>
            </view>
            <text class="modal-title" :style="{ fontSize: fontPx(14), color: c.onAccent }">{{ title }}</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import wfc from "../../../wfc/client/wfc.uts";
import ConversationInfo from "../../../wfc/model/conversationInfo.uts";
import SoundMessageContent from "../../../wfc/messages/soundMessageContent.uts";
import { toLocalFilePath } from "../../../common/filePath.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: 'AudioInputView'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    conversationInfo: ConversationInfo
}>()

const popupToggle = ref<boolean>(false)
const isRecording = ref<boolean>(false)
const canSend = ref<boolean>(true)
const text = ref<string>('按住说话')
const title = ref<string>(' ')
const recordTime = ref<number>(0)
const recordTimer = ref<number>(0)
const longPressClientY = ref<number>(0)

onMounted(() => {
    const recorderManager = uni.getRecorderManager();
    recorderManager.onStop((res) => {
        if (recordTimer.value != 0) {
            clearInterval(recordTimer.value);
            recordTimer.value = 0;
        }
        uni.hideLoading();
        if (canSend.value) {
            if (recordTime.value < 1) {
                uni.showToast({
                    title: '录音时间太短',
                    icon: 'none'
                } as ShowToastOptions);
            } else {
                const filePath = toLocalFilePath(res.tempFilePath);
                const soundMessageContent = new SoundMessageContent(filePath, '', recordTime.value)
                let conversationInfo = props.conversationInfo as ConversationInfo
                wfc.sendConversationMessage(conversationInfo.conversation, soundMessageContent);
            }
        }
        popupToggle.value = false;
        isRecording.value = false;
        canSend.value = true;
        title.value = ' ';
        text.value = '按住说话'
    });
    recorderManager.onError((res) => {
        console.log('recorderManager.onError', res);
    })
})

const handleLongPress = (e: UniTouchEvent) => {
    console.log('to start record');
    if (e.changedTouches.length > 0) {
        longPressClientY.value = e.changedTouches[e.changedTouches.length - 1].clientY;
    }
    popupToggle.value = true;
    const recorderManager = uni.getRecorderManager();
    recorderManager.start({
        duration: 60000,
        sampleRate: 44100,
        format: 'mp3'
    } as RecorderManagerStartOptions);
    title.value = '正在录音';
    isRecording.value = true;
    recordTime.value = 0;
    recordTimer.value = setInterval(() => {
        recordTime.value++;
    }, 1000);
}

// 录音时的手势上划移动距离对应文案变化
const handleTouchMove = (e: UniTouchEvent) => {
    if (isRecording.value && e.changedTouches.length > 0) {
        const clientY = e.changedTouches[e.changedTouches.length - 1].clientY
        if (Math.abs(longPressClientY.value - clientY) > 100) {
            text.value = '抬起停止';
            title.value = '松开手指，取消发送';
            canSend.value = false;
        } else if (Math.abs(longPressClientY.value - clientY) > 20) {
            text.value = '抬起停止';
            title.value = '上划可取消';
            canSend.value = true;
        } else {
            text.value = '抬起停止';
            title.value = '正在录音';
            canSend.value = true;
        }
    }
}

// 手指离开页面滑动
const handleTouchEnd = () => {
    isRecording.value = false;
    popupToggle.value = false;
    text.value = '按住说话';
    uni.hideLoading();
    uni.getRecorderManager().stop();
}
</script>

<style scoped>
.TUI-message-input-main {
    flex: 1;
    height: 33px;
    margin: 0 5px;
    padding: 0 3px;
    border-radius: 3px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.record-modal {
    height: 150px;
    width: 220px;
    position: fixed;
    top: 300px;
    z-index: 9999;
    left: 70px;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
}

.wrapper {
    display: flex;
    flex-direction: row;
    height: 100px;
    padding: 35px;
}

.modal-loading {
    width: 20px;
    height: 8px;
    border-radius: 2px;
}

.modal-title {
    text-align: center;
}
</style>
