<template>
    <view class="quoted-message-container">
        <view class="quoted-message" :style="{ backgroundColor: c.bubbleQuoted }">
            <view class="media-content" v-if="isMediaQuoted">
                <text class="quoted-name single-line" :style="{ fontSize: fontPx(13), color: c.bubbleQuotedText }">{{ quotedFromName }}</text>
                <image class="quoted-image" mode="aspectFit" :src="mediaSrc" @tap="onMessageClick" />
            </view>
            <text v-else class="quoted-text" :style="{ fontSize: fontPx(13), color: c.bubbleQuotedText }"
                @tap="onMessageClick">{{ quotedMessageStr }}</text>
        </view>
        <text v-if="showCloseButton" @tap="cancelQuoteMessage" class="icomoon close-icon"
            :style="{ color: c.textSecondary }">&#xf12a;</text>
    </view>
</template>

<script setup lang="uts">
import store from "@/store.uts";
import MessageContentType from "@/wfc/messages/messageContentType.uts";
import Message from "@/wfc/messages/message.uts";
import ImageMessageContent from "@/wfc/messages/imageMessageContent.uts";
import VideoMessageContent from "@/wfc/messages/videoMessageContent.uts";
import StickerMessageContent from "@/wfc/messages/stickerMessageContent.uts";
import eventBus from "@/common/eventBus.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";

defineOptions({
    name: "QuoteMessageView",
    styleIsolation: 'app'
})

const c = computed<AppColors>((): AppColors => colors())

const props = withDefaults(defineProps<{
    showCloseButton?: boolean
    // 被引用的消息
    quotedMessage: Message
    quotedMessageDigest?: string
}>(), {
    showCloseButton: false,
    quotedMessageDigest: ''
})

const emit = defineEmits(['cancelQuoteMessage'])

const isMediaQuoted = computed<boolean>((): boolean => {
    const quotedMessage = props.quotedMessage as Message
    const type = quotedMessage.messageContent.type
    return type == MessageContentType.Image || type == MessageContentType.Video || type == MessageContentType.Sticker
})

const quotedFromName = computed<string>((): string => {
    const quotedMessage = props.quotedMessage as Message
    const from = quotedMessage._from
    return (from != null ? from._displayName : '') + ':'
})

const quotedMessageStr = computed<string>((): string => {
    const quotedMessage = props.quotedMessage as Message
    let str = '';
    const from = quotedMessage._from
    str = (from != null ? from._displayName : '') + ':';
    str += quotedMessage.messageContent.digest(quotedMessage);
    if (MessageContentType.RecallMessage_Notification == quotedMessage.messageContent.type) {
        str = "引用内容已撤回"
    }
    return str;
})

const mediaSrc = computed<string>((): string => {
    const quotedMessage = props.quotedMessage as Message
    const msgCnt = quotedMessage.messageContent;
    let thumbnail = ''
    let remotePath = ''
    if (msgCnt instanceof ImageMessageContent) {
        thumbnail = (msgCnt as ImageMessageContent).thumbnail
        remotePath = (msgCnt as ImageMessageContent).remotePath
    } else if (msgCnt instanceof VideoMessageContent) {
        thumbnail = (msgCnt as VideoMessageContent).thumbnail
        remotePath = (msgCnt as VideoMessageContent).remotePath
    } else if (msgCnt instanceof StickerMessageContent) {
        remotePath = (msgCnt as StickerMessageContent).remotePath
    }
    return thumbnail != '' ? 'data:image/jpeg;base64,' + thumbnail : remotePath;
})

const cancelQuoteMessage = () => {
    emit('cancelQuoteMessage')
}

const onMessageClick = () => {
    const quotedMessage = props.quotedMessage as Message
    switch (quotedMessage.messageContent.type) {
        case MessageContentType.Video:
        case MessageContentType.Image:
            store.previewMessage(quotedMessage, false);
            break;
        case MessageContentType.RecallMessage_Notification:
            break;
        default:
            // 定位到被引用的原消息
            if (quotedMessage.messageId > 0) {
                eventBus.$emit('locateMessage', quotedMessage.messageId)
            }
            break
    }
}
</script>

<style scoped>
.quoted-message-container {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.quoted-message {
    display: flex;
    flex-direction: row;
    width: 100%;
    border-radius: 5px;
    padding: 5px 10px;
    margin-right: 10px;
}

.quoted-text {
    width: 100%;
    lines: 2;
    text-overflow: ellipsis;
    overflow: hidden;
}

.media-content {
    width: 100%;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.quoted-name {
    width: 100px;
    max-width: 100px;
}

.quoted-image {
    margin-left: 10px;
    border-radius: 3px;
    width: 60px;
    height: 60px;
}

.close-icon {
    font-size: 16px;
}
</style>
