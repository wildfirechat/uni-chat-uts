<template>
    <view class="conversation-page">
        <NavBar :title="navTitle" :showBack="true" :rightIcon1="conversationInfo != null ? moreIcon : ''"
            @right1Tap="showConversationInfo" />
        <view v-if="conversationInfo == null" class="conversation-empty-container">
            <text>^~^</text>
        </view>
        <view v-else class="conversation-content-container">
            <view class="message-list-container">
                <scroll-view class="message-list" direction="vertical" :scroll-top="scrollTop"
                    :scroll-into-view="scrollIntoView" :refresher-enabled="true" :refresher-triggered="triggered"
                    :refresher-threshold="45" @refresherrefresh="onRefresh" @refresherrestore="onRestore"
                    @refresherabort="onAbort" @scrolltolower="onScrollToLower" @touchstart="onTouchStart"
                    @touchmove="onTouchMove">
                    <view v-for="(message, index) in messageList" :id="'id-' + message.messageId" :key="index"
                        class="message-item" :class="{ highlight: message.messageId == highlightMessageId }"
                        @tap="clickMessageItem(message)">
                        <NotificationMessageContentView :message="message" v-if="isNotificationMessage(message)" />
                        <RecallNotificationMessageContentView :message="message"
                            v-else-if="isRecallNotificationMessage(message)" />
                        <ContextableNotificationMessageContentContainerView :message="message"
                            v-else-if="isContextableNotificationMessage(message)" />
                        <NormalOutMessageContentView :message="message" v-else-if="message.direction == 0" />
                        <NormalInMessageContentView :message="message" v-else />
                    </view>
                </scroll-view>
                <view v-if="showUnreadLabel" class="unread-label-container">
                    <view v-if="unreadMentionCount > 0" class="unread-label" @tap="locateFirstUnreadMention">
                        <text class="unread-label-text">有 {{ unreadMentionCount }} 条@我的消息</text>
                    </view>
                    <view v-if="showUnreadCountLabel" class="unread-label" @tap="locateFirstUnread">
                        <text class="unread-label-text">{{ unreadCount }} 条未读消息</text>
                    </view>
                    <text class="unread-label-close icomoon" @tap="hideUnreadLabel">&#xf12a;</text>
                </view>
                <view v-if="hasMoreNewMessages" class="back-to-latest" @tap="backToLatest">
                    <text class="back-to-latest-text">回到最新消息</text>
                </view>
            </view>
            <chunLei-popups v-model="showContextMenu" :popData="contextMenuItems" @tapPopup="onContextMenuItemSelect"
                :x="contextMenuX" :y="contextMenuY" direction="column" theme="dark" :triangle="false" :dynamic="true" />
            <MessageInputView v-if="!enableMessageMultiSelection" :conversationInfo="conversationInfo"
                class="message-input-container" ref="messageInputView" />
            <MultiSelectActionView v-if="enableMessageMultiSelection" />
        </view>
    </view>
</template>

<script setup lang="uts">
import NavBar from "@/pages/common/NavBar.uvue";
import MessageInputView from "@/pages/conversation/MessageInputView.uvue";
import NormalOutMessageContentView from "@/pages/conversation/message/NormalOutMessageContentContainerView.uvue";
import NormalInMessageContentView from "@/pages/conversation/message/NormalInMessageContentContainerView.uvue";
import NotificationMessageContentView from "@/pages/conversation/message/NotificationMessageContentView.uvue";
import RecallNotificationMessageContentView from "@/pages/conversation/message/RecallNotificationMessageContentView.uvue";
import ContextableNotificationMessageContentContainerView from "./message/ContextableNotificationMessageContentContainerView.uvue";
import MultiSelectActionView from "@/pages/conversation/MessageMultiSelectActionView.uvue";
import NotificationMessageContent from "@/wfc/messages/notification/notificationMessageContent.uts";
import RichNotificationMessageContent from "../../wfc/messages/notification/richNotificationMessageContent.uts";
import ArticlesMessageContent from "../../wfc/messages/articlesMessageContent.uts";
import TextMessageContent from "@/wfc/messages/textMessageContent.uts";
import SoundMessageContent from "@/wfc/messages/soundMessageContent.uts";
import TypingMessageContent from "@/wfc/messages/typingMessageContent.uts";
import MessageContentType from "@/wfc/messages/messageContentType.uts";
import Message from "@/wfc/messages/message.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import ConversationType from "@/wfc/model/conversationType.uts";
import GroupMemberType from "@/wfc/model/groupMemberType.uts";
import store, { conversationState } from "@/store.uts";
import wfc from "../../wfc/client/wfc.uts";
import Config from "../../config.uts";
import { getItem, setItem } from "../util/storageHelper.uts";
import { copyText } from "@/pages/util/clipboard.uts";
import { PopupMenuItem } from "@/components/chunLei-popups/popupMenu.uts";
import { navigateToPage } from "@/common/nav.uts";
import { forward } from "@/common/forward.uts";
import { isSavableMessage, isSaveToAlbumMessage, saveMessageMedia } from "@/common/mediaSaver.uts";
import ForwardType from "@/pages/conversation/message/forward/ForwardType.uts";
import eventBus from "@/common/eventBus.uts";
import { getTouchPoint } from "@/common/touch.uts";
import { OpenMessageContextMenuEvent } from "./message/messageEvents.uts";

let innerAudioContext: InnerAudioContext | null = null;

defineOptions({
    name: 'ConversationPage'
})

const moreIcon = ref<string>('')

const isScroll = ref<boolean>(false)
const touchStartX = ref<number>(0)
const touchStartY = ref<number>(0)

const showContextMenu = ref<boolean>(false)
const contextMenuX = ref<number>(0)
const contextMenuY = ref<number>(0)
const contextMenuItems = ref<PopupMenuItem[]>([] as PopupMenuItem[])
const contextMenuMessage = ref<Message | null>(null)

const keyboardHeight = ref<number>(0)
const scrollTop = ref<number>(0)
const scrollIntoView = ref<string>('')
const triggered = ref<boolean>(false)
const freshing = ref<boolean>(false)
const loadingNewMessages = ref<boolean>(false)

// 与原生一致：未读数超过 10 条才显示顶部提示条
const UNREAD_LABEL_MIN_COUNT = 10
const UNREAD_LABEL_MAX_COUNT = 300
const unreadLabelDismissed = ref<boolean>(false)
let highlightClearTimer = 0

// onUnload 时会清空 store 里的当前会话，而此时页面关闭动画才刚开始，页面仍在渲染，
// 直接渲染 store 数据会导致整个页面瞬间变白(白屏动画滑出后才看到会话列表)。
// 所以关闭时冻结渲染，用关闭前的数据副本，保证动画期间页面内容不变。
const closing = ref<boolean>(false)
const closingConversationInfo = ref<ConversationInfo | null>(null)
const closingMessageList = ref<Message[]>([] as Message[])

const messageInputView = ref<MessageInputView | null>(null)

const conversationInfo = computed<ConversationInfo | null>((): ConversationInfo | null => {
    return closing.value ? closingConversationInfo.value : conversationState.currentConversationInfo
})

const messageList = computed<Message[]>((): Message[] => {
    return closing.value ? closingMessageList.value : conversationState.currentConversationMessageList
})

const enableMessageMultiSelection = computed<boolean>((): boolean => {
    return conversationState.enableMessageMultiSelection
})

const highlightMessageId = computed<number>((): number => {
    return conversationState.highlightMessageId
})

const hasMoreNewMessages = computed<boolean>((): boolean => {
    return conversationState.hasMoreNewMessages
})

const unreadCount = computed<number>((): number => {
    return conversationState.enterUnreadCount
})

const unreadMentionCount = computed<number>((): number => {
    return conversationState.enterUnreadMentionCount
})

const showUnreadCountLabel = computed<boolean>((): boolean => {
    return unreadCount.value > UNREAD_LABEL_MIN_COUNT && unreadCount.value < UNREAD_LABEL_MAX_COUNT
})

const showUnreadLabel = computed<boolean>((): boolean => {
    if (unreadLabelDismissed.value) {
        return false
    }
    return unreadMentionCount.value > 0 || showUnreadCountLabel.value
})

const conversationTitle = computed<string>((): string => {
    const info = conversationInfo.value;
    if (info == null) {
        return ''
    }
    const target = store.ensureConversationTarget(info.conversation)
    return target != null ? target._displayName : '';
})

const targetUserOnlineStateDesc = computed<string>((): string => {
    const info = conversationInfo.value;
    return info != null ? info.conversation._targetOnlineStateDesc : '';
})

// 「对方正在输入」，与原生 ConversationFragment#updateTypingStatusTitle 对齐
const typingDesc = computed<string>((): string => {
    const user = conversationState.inputtingUser
    const info = conversationInfo.value
    if (user == null || info == null) {
        return ''
    }
    const conversationType = info.conversation.type
    if (conversationType != ConversationType.Single && conversationType != ConversationType.Group) {
        return ''
    }
    let desc: string
    switch (conversationState.inputtingTypingType) {
        case TypingMessageContent.TYPING_VOICE:
            desc = '正在录音'
            break;
        case TypingMessageContent.TYPING_CAMERA:
            desc = '正在拍照'
            break;
        case TypingMessageContent.TYPING_LOCATION:
            desc = '正在发送位置'
            break;
        case TypingMessageContent.TYPING_FILE:
            desc = '正在发送文件'
            break;
        default:
            desc = '正在输入'
            break;
    }
    if (conversationType == ConversationType.Group) {
        const name = user._displayName != '' ? user._displayName : user.displayName
        return (name != '' ? name : '有人') + ' ' + desc
    }
    return '对方' + desc
})

const navTitle = computed<string>((): string => {
    if (typingDesc.value != '') {
        return typingDesc.value
    }
    return targetUserOnlineStateDesc.value != ''
        ? conversationTitle.value + `(${targetUserOnlineStateDesc.value})`
        : conversationTitle.value
})

// 用于控制同时只能播放一个语音
const currentVoiceMessage = computed<Message | null>((): Message | null => {
    const voice = conversationState.currentVoiceMessage;
    if (voice != null) {
        playVoice(voice);
    } else {
        const ctx = innerAudioContext
        if (ctx != null) {
            ctx.stop();
            innerAudioContext = null;
        }
    }
    return voice;
})

const scrollToBottom = () => {
    setTimeout(() => {
        scrollTop.value = scrollTop.value == 999999 ? 999998 : 999999;
    }, 200)
    // 图片/视频/语音等消息没有输入法弹出带来的额外滚动机会，且内容排版比纯文本慢，
    // 200ms 时可能还没排版完成，这里再兜底滚动一次
    setTimeout(() => {
        scrollTop.value = scrollTop.value == 999999 ? 999998 : 999999;
    }, 600)
}

watch(messageList, (_newList: Message[], _old: Message[]) => {
    if (conversationState.shouldAutoScrollToBottom) {
        scrollToBottom();
    }
    const info = conversationState.currentConversationInfo
    if (info != null && info.unreadCount.unread > 0) {
        store.clearConversationUnreadStatus(info.conversation);
    }
}, { deep: false })

// 触发 currentVoiceMessage computed 的求值
watch(currentVoiceMessage, (_n: Message | null, _o: Message | null) => {
}, { immediate: true })

onUnload(() => {
    // 先冻结渲染，再清空 store，避免关闭动画期间页面变白
    closingConversationInfo.value = conversationState.currentConversationInfo;
    closingMessageList.value = conversationState.currentConversationMessageList;
    closing.value = true;

    if (highlightClearTimer != 0) {
        clearTimeout(highlightClearTimer);
        highlightClearTimer = 0;
    }
    store.setCurrentConversationInfo(null);
    eventBus.$off('openMessageContextMenu', onOpenMessageContextMenu)
    eventBus.$off('reeditMessage', onReeditMessage)
    eventBus.$off('locateMessage', onLocateMessageEvent)
})

onMounted(() => {
    scrollToBottom();
    const info = conversationState.currentConversationInfo
    if (info != null) {
        store.clearConversationUnreadStatus(info.conversation);
    }

    const savedKeyboardHeight = getItem('keyboardHeight');
    if (savedKeyboardHeight != '') {
        keyboardHeight.value = parseInt(savedKeyboardHeight);
    }
    uni.onKeyboardHeightChange((res) => {
        if (keyboardHeight.value != res.height && res.height > 0) {
            keyboardHeight.value = res.height;
            setItem('keyboardHeight', '' + keyboardHeight.value)
        }
        const inputView = messageInputView.value
        if (inputView != null && res.height > 0) {
            (inputView as ComponentPublicInstance).$callMethod('onKeyboardHeightChange', keyboardHeight.value, res.height);
        }
        scrollToBottom();
    });

    eventBus.$on('openMessageContextMenu', onOpenMessageContextMenu);
    eventBus.$on('reeditMessage', onReeditMessage);
    eventBus.$on('locateMessage', onLocateMessageEvent);
})

// 从搜索结果等页面跳转过来时，定位到指定消息
onShow(() => {
    const messageId = store.takePendingLocateMessageId()
    if (messageId != 0) {
        setTimeout(() => {
            store.locateMessage(messageId, onLocated)
        }, 300)
    }
})

const onLocateMessageEvent = (data: any | null) => {
    if (data == null) {
        return
    }
    const messageId = parseInt('' + data)
    if (messageId > 0) {
        store.locateMessage(messageId, onLocated)
    }
}

const onOpenMessageContextMenu = (data: any | null) => {
    if (data instanceof OpenMessageContextMenuEvent) {
        const e = data as OpenMessageContextMenuEvent
        showMessageContextMenu(e.event, e.message)
    }
}

const onReeditMessage = (data: any | null) => {
    if (data != null) {
        const inputView = messageInputView.value
        if (inputView != null) {
            (inputView as ComponentPublicInstance).$callMethod('insertText', '' + data);
        }
    }
}

const showConversationInfo = () => {
    const info = conversationState.currentConversationInfo
    if (info == null) {
        return
    }
    if (info.conversation.type == ConversationType.Single) {
        navigateToPage('/pages/conversation/SingleConversationInfoPage', info);
    } else if (info.conversation.type == ConversationType.Group) {
        navigateToPage('/pages/conversation/GroupConversationInfoPage', info);
    } else {
        uni.showToast({
            title: 'TODO 暂不支持该会话类型',
            icon: 'none'
        } as ShowToastOptions)
    }
}

const clickMessageItem = (message: Message) => {
    if (message.messageContent instanceof NotificationMessageContent) {
        return;
    }
    if (conversationState.enableMessageMultiSelection) {
        store.selectOrDeselectMessage(message);
    }
}

const isNotificationMessage = (message: Message): boolean => {
    return message.messageContent instanceof NotificationMessageContent
        && message.messageContent.type != MessageContentType.RecallMessage_Notification
        && message.messageContent.type != MessageContentType.Rich_Notification;
}

const isContextableNotificationMessage = (message: Message): boolean => {
    return message.messageContent instanceof RichNotificationMessageContent || message.messageContent instanceof ArticlesMessageContent;
}

const isRecallNotificationMessage = (message: Message): boolean => {
    return message.messageContent.type == MessageContentType.RecallMessage_Notification;
}

// 目前仅文本消息支持复制
const isCopyable = (message: Message): boolean => {
    return message.messageContent instanceof TextMessageContent;
}

const isDownloadAble = (message: Message): boolean => {
    return isSavableMessage(message);
}

const isForwardable = (message: Message): boolean => {
    if (message.messageContent instanceof SoundMessageContent) {
        return false;
    }
    return true;
}

const isRecallable = (message: Message): boolean => {
    if (message.conversation.type == ConversationType.Group) {
        const groupInfo = wfc.getGroupInfo(message.conversation.target);
        const selfUserId = wfc.getUserId();
        if (groupInfo.owner == selfUserId) {
            return true;
        }

        const groupMember = wfc.getGroupMember(message.conversation.target, selfUserId);
        if (groupMember.type == GroupMemberType.Manager || groupMember.type == GroupMemberType.Owner) {
            return true;
        }
    }
    const delta = wfc.getServerDeltaTime();
    const now = new Date().getTime();
    if (message.direction == 0 && now - (message.timestamp - delta) < 60 * 1000) {
        return true;
    }
    return false;
}

const isQuotable = (message: Message): boolean => {
    return [MessageContentType.VOIP_CONTENT_TYPE_START,
    MessageContentType.Voice,
    MessageContentType.Video,
    MessageContentType.Composite_Message,
    MessageContentType.CONFERENCE_CONTENT_TYPE_INVITE].indexOf(message.messageContent.type) <= -1;
}

const copy = (message: Message) => {
    const content = message.messageContent;
    if (content instanceof TextMessageContent) {
        copyText((content as TextMessageContent).content)
    }
}

const recallMessage = (message: Message) => {
    wfc.recallMessage(message.messageUid, null, null);
}

const forwardMessage = (message: Message) => {
    forward(ForwardType.NORMAL, [message]);
}

const multiSelect = (message: Message) => {
    store.toggleMessageMultiSelection(message);
}

// 同时只能播放一个语音，逻辑放在会话页统一控制
const playVoice = (message: Message) => {
    let ctx = innerAudioContext
    if (ctx != null) {
        ctx.stop();
    }
    const content = message.messageContent
    if (!(content instanceof SoundMessageContent)) {
        return
    }
    const voice = content as SoundMessageContent;
    let mp3RemotePath = voice.remotePath
    if (!voice.remotePath.endsWith(".mp3") && Config.AMR_TO_MP3_SERVER_ADDRESS != '') {
        mp3RemotePath = Config.AMR_TO_MP3_SERVER_ADDRESS + voice.remotePath;
    }
    ctx = uni.createInnerAudioContext();
    innerAudioContext = ctx;
    ctx.autoplay = false;
    ctx.src = mp3RemotePath;
    ctx.onPlay(() => {
        voice._isPlaying = true;
    });
    ctx.onError((res) => {
        console.log('play voice error', res)
        voice._isPlaying = false;
        store.playVoice(null)
    });
    ctx.onEnded(() => {
        voice._isPlaying = false;
        store.playVoice(null)
    })
    ctx.onCanplay(() => {
        innerAudioContext?.play();
    })
}

const onTouchStart = (e: UniTouchEvent) => {
    isScroll.value = false
    if (e.touches.length > 0) {
        touchStartX.value = e.touches[0].clientX
        touchStartY.value = e.touches[0].clientY
    }
}

const onTouchMove = (e: UniTouchEvent) => {
    uni.hideKeyboard();
    if (e.touches.length > 0) {
        const delX = e.touches[0].clientX - touchStartX.value
        const delY = e.touches[0].clientY - touchStartY.value
        if (Math.abs(delX) > 5 || Math.abs(delY) > 5) {
            isScroll.value = true
        }
    }
}

const showMessageContextMenu = (e: UniTouchEvent, message: Message) => {
    if (isScroll.value) {
        return;
    }
    // longpress 事件 touches 可能为空，改用 changedTouches 兜底取触点坐标
    const point = getTouchPoint(e)
    if (point != null) {
        contextMenuX.value = point.x;
        contextMenuY.value = point.y;
    }
    contextMenuMessage.value = message;

    const items: PopupMenuItem[] = [];
    if (isCopyable(message)) {
        items.push(new PopupMenuItem('复制', 'copy'))
    }
    if (isDownloadAble(message)) {
        items.push(new PopupMenuItem(isSaveToAlbumMessage(message) ? '保存到相册' : '保存到本地', 'save'))
    }
    items.push(new PopupMenuItem('本地删除', 'delete'))
    items.push(new PopupMenuItem('远程删除', 'deleteRemote'))
    if (isForwardable(message)) {
        items.push(new PopupMenuItem('转发', 'forward'))
    }
    if (isRecallable(message)) {
        items.push(new PopupMenuItem('撤回', 'recall'))
    }
    if (isQuotable(message)) {
        items.push(new PopupMenuItem('引用', 'quote'))
    }
    items.push(new PopupMenuItem('多选', 'multiSelection'))
    contextMenuItems.value = items;
    showContextMenu.value = true;
}

const onContextMenuItemSelect = (t: PopupMenuItem) => {
    const message = contextMenuMessage.value
    if (message == null) {
        return
    }
    switch (t.tag) {
        case 'delete':
            wfc.deleteMessage(message.messageId);
            break;
        case 'deleteRemote':
            wfc.deleteRemoteMessageByUid(message.messageUid, () => {
                console.log('delete remote message success')
            }, (err: number) => {
                console.log('delete remote message fail', err);
            })
            break;
        case 'forward':
            forwardMessage(message)
            break;
        case 'recall':
            recallMessage(message);
            break;
        case 'quote':
            store.quoteMessage(message);
            break;
        case 'multiSelection':
            multiSelect(message);
            break;
        case 'copy':
            copy(message);
            break;
        case 'save':
            saveMessageMedia(message);
            break;
        default:
            uni.showToast({
                title: 'TODO ' + t.title,
                icon: 'none'
            } as ShowToastOptions)
            break;
    }
    eventBus.$emit('contextMenuClosed', null)
}

const hideUnreadLabel = () => {
    unreadLabelDismissed.value = true
}

// 定位成功后滚动到目标消息并高亮 3s，与原生 checkAndHighlightMessage 对齐
const onLocated = (found: boolean) => {
    if (!found) {
        uni.showToast({
            title: '未找到该消息',
            icon: 'none'
        } as ShowToastOptions)
        return
    }
    const messageId = conversationState.highlightMessageId
    setTimeout(() => {
        scrollIntoView.value = 'id-' + messageId
    }, 100)
    if (highlightClearTimer != 0) {
        clearTimeout(highlightClearTimer)
    }
    highlightClearTimer = setTimeout(() => {
        highlightClearTimer = 0
        store.clearHighlightMessage()
        scrollIntoView.value = ''
    }, 3000)
}

const locateFirstUnread = () => {
    hideUnreadLabel()
    store.locateFirstUnreadMessage(unreadCount.value, onLocated)
}

const locateFirstUnreadMention = () => {
    hideUnreadLabel()
    store.locateFirstUnreadMentionMessage(unreadCount.value, onLocated)
}

const backToLatest = () => {
    store.backToLatestMessages()
    scrollIntoView.value = ''
    scrollToBottom()
}

const onScrollToLower = () => {
    if (!conversationState.hasMoreNewMessages || loadingNewMessages.value) {
        return
    }
    loadingNewMessages.value = true
    store.loadConversationNewMessages(() => {
        loadingNewMessages.value = false
    }, () => {
        loadingNewMessages.value = false
    })
}

const onRefresh = () => {
    console.log('onRefresh...')
    if (freshing.value) {
        return;
    }

    freshing.value = true;
    triggered.value = true;
    store.loadConversationHistoryMessages(() => {
        triggered.value = false;
        freshing.value = false;
    }, () => {
        triggered.value = false;
        freshing.value = false;
    });
}

const onRestore = () => {
    console.log("onRestore");
}

const onAbort = () => {
    console.log("onAbort");
}
</script>

<style scoped>
.conversation-page {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.conversation-empty-container {
    flex: 1;
    width: 100%;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
}

.conversation-content-container {
    position: relative;
    display: flex;
    flex: 1;
    overflow: hidden;
    flex-direction: column;
    background-color: #f3f3f3;
}

.message-list-container {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}

.message-list {
    flex: 1;
}

.message-item {
    background-color: transparent;
}

.message-item.highlight {
    background-color: #ffe9a8;
}

.unread-label-container {
    position: absolute;
    top: 10px;
    right: 0;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.unread-label {
    margin-left: 8px;
    padding: 6px 10px;
    background-color: #ffffff;
    border: 1px solid #e0e0e0;
    border-top-left-radius: 12px;
    border-bottom-left-radius: 12px;
}

.unread-label-text {
    font-size: 12px;
    color: #3B62E0;
}

.unread-label-close {
    padding: 6px 8px;
    font-size: 14px;
    color: #808080;
}

.back-to-latest {
    position: absolute;
    bottom: 10px;
    right: 10px;
    padding: 6px 12px;
    border-radius: 14px;
    border: 1px solid #e0e0e0;
    background-color: #ffffff;
}

.back-to-latest-text {
    font-size: 12px;
    color: #3B62E0;
}

.message-input-container {
    width: 100%;
}
</style>
