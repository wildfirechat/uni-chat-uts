<template>
    <view class="conversation-info" :style="{ backgroundColor: c.surface }">
        <list-view class="member-list" direction="vertical">
            <list-item @tap="showCreateConversationModal" class="action-item">
                <view class="icon" :style="{ borderColor: c.hairline }">
                    <text class="icon-text" :style="{ color: c.textSecondary }">+</text>
                </view>
                <text class="action-text" :style="{ color: c.textPrimary }">添加成员</text>
            </list-item>
            <UserListView :users="users" :show-category-label="false" padding-left="20px" />
        </list-view>
        <view @tap="clearMessages" class="danger-item" :style="{ borderTopColor: c.hairlineSoft }">
            <text class="danger-text" :style="{ color: c.danger }">清空聊天记录</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import UserListView from "@/pages/user/UserListView.uvue";
import store, { contactState } from "@/store.uts";
import wfc from "@/wfc/client/wfc.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import { takePageOptions } from "@/common/nav.uts";
import { pickUsers, PickUsersOptions } from "@/common/picker.uts";
import { clearConversationMessages } from "@/common/conversationActions.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "SingleConversationInfoPage"
})


const c = computed<AppColors>((): AppColors => colors())
const conversationInfo = ref<ConversationInfo | null>(null)
const users = ref<UserInfo[]>([] as UserInfo[])

onLoad((_options: OnLoadOptions) => {
    console.log('SingleConversationInfoPage onLoad')
    const pageOptions = takePageOptions()
    if (pageOptions != null && pageOptions instanceof ConversationInfo) {
        const info = pageOptions as ConversationInfo
        conversationInfo.value = info;
        users.value = store.getConversationMemberUsrInfos(info.conversation);

        const target = store.ensureConversationTarget(info.conversation)
        uni.setNavigationBarTitle({
            title: target != null ? target._displayName : '',
        } as SetNavigationBarTitleOptions);
    }
})

const showCreateConversationModal = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    const targetUserInfo = wfc.getUserInfo(info.conversation.target, false)
    const options = new PickUsersOptions()
    options.users = contactState.favContactList.concat(contactState.friendList)
    options.initialCheckedUsers = [targetUserInfo]
    options.uncheckableUsers = [targetUserInfo]
    options.confirmTitle = '添加'
    options.successCB = (users: UserInfo[]) => {
        const newPickedUsers = users.slice(0);
        newPickedUsers.push(targetUserInfo)
        store.createConversation(newPickedUsers, null, null);
    }
    pickUsers(options)
}

const clearMessages = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    clearConversationMessages(info.conversation)
}
</script>

<style scoped>
.conversation-info {
    display: flex;
    flex-direction: column;
    position: relative;
    justify-content: flex-start;
    flex: 1;
    overflow: hidden;
}

.member-list {
    flex: 1;
}

.action-item {
    height: 50px;
    display: flex;
    flex-direction: row;
    padding-left: 20px;
    align-items: center;
}

.icon {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 3px;
    border-width: 1px;
    border-style: dashed;
}

.icon-text {
    font-size: 20px;
}

.action-text {
    margin-left: 10px;
    font-size: 13px;
}

.danger-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 50px;
    border-top-width: 1px;
    border-top-style: solid;
}

.danger-text {
    font-size: 15px;
}
</style>
