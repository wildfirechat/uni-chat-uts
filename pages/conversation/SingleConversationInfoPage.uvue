<template>
    <scroll-view class="page" direction="vertical" :style="{ backgroundColor: c.primaryBackground }">
        <form-card>
            <member-grid :users="members" :show-add="true" @memberTap="openUserDetail" @addTap="createGroupWith" />
        </form-card>

        <section-divider />

        <form-card>
            <option-item :title="t('conversation.search_chat_content')" @tap="searchMessages" />
            <option-item :title="t('conversation.chat_files')" @tap="openFiles" />
            <option-item :title="t('conversation.chat_links')" :show-bottom-divider="false" @tap="openLinks" />
        </form-card>

        <section-divider />

        <form-card>
            <option-switch-item :title="t('conversation.disable_notification')" :value="isSilent"
                @change="onSilentChange" />
            <option-switch-item :title="t('conversation.sticky_top')" :value="isTop" :show-bottom-divider="false"
                @change="onTopChange" />
        </form-card>

        <section-divider />

        <form-card>
            <option-button-item :title="t('conversation.clear_chat_history')" :show-bottom-divider="false"
                @tap="clearMessages" />
        </form-card>

        <view class="tail"></view>
        <watermark-overlay />
    </scroll-view>
</template>

<script setup lang="uts">
/**
 * 单聊会话信息页。对齐 flutter `conversation/single_conversation_info_screen.dart`。
 *
 * 与 flutter 的差异：
 * - 少一项「会话链接」—— 链接页归 M3，等那页落地再把入口补上。
 * - 「会话文件」直接复用 FileListPage（见 common/conversationActions.uts 的说明）。
 * - 成员格子只有对方 + 加号，点加号是「拉人建群」（flutter 同样是 createGroup），
 *   不是「往单聊里加人」—— 单聊没有成员概念。
 */
import store, { contactState } from "@/store.uts";
import wfc from "@/wfc/client/wfc.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import { takePageOptions } from "@/common/nav.uts";
import { pickUsers, PickUsersOptions } from "@/common/picker.uts";
import { clearConversationMessages, searchConversationMessages, openConversationFiles, openConversationLinks } from "@/common/conversationActions.uts";
import { colors, AppColors } from "@/common/theme.uts";
import { t } from "@/i18n/i18n.uts";

defineOptions({
    name: "SingleConversationInfoPage"
})

const c = computed<AppColors>((): AppColors => colors())

const conversationInfo = ref<ConversationInfo | null>(null)
const members = ref<UserInfo[]>([] as UserInfo[])
const isSilent = ref<boolean>(false)
const isTop = ref<boolean>(false)

onLoad((_options: OnLoadOptions) => {
    const pageOptions = takePageOptions()
    if (pageOptions == null || !(pageOptions instanceof ConversationInfo)) {
        return
    }
    const info = pageOptions as ConversationInfo
    conversationInfo.value = info
    isSilent.value = info.isSilent
    isTop.value = info.top > 0

    // 只展示对方，不含自己 —— 与 flutter SingleConversationMemberView 一致
    members.value = [store.getUserInfos([info.conversation.target], '')[0]]

    // 进页面强刷一次对方资料，与 flutter 的 getUserInfo(refresh: true) 对齐
    wfc.getUserInfo(info.conversation.target, true)
})

const conversationTitle = computed<string>((): string => {
    const info = conversationInfo.value
    if (info == null) {
        return ''
    }
    const target = store.ensureConversationTarget(info.conversation)
    return target != null ? target._displayName : ''
})

const openUserDetail = (user: UserInfo) => {
    store.setCurrentFriend(user)
    uni.navigateTo({
        url: '/pages/contact/UserDetailPage',
        fail: (err) => {
            console.log('nav to UserDetailPage err', err)
        }
    } as NavigateToOptions)
}

/** 单聊里点「+」= 拉上对方和新选的人建群。 */
const createGroupWith = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    const targetUserInfo = wfc.getUserInfo(info.conversation.target, false)
    const options = new PickUsersOptions()
    options.title = t('common.contact')
    options.users = contactState.favContactList.concat(contactState.friendList)
    options.initialCheckedUsers = [targetUserInfo]
    options.uncheckableUsers = [targetUserInfo]
    options.confirmTitle = t('common.add')
    options.successCB = (users: UserInfo[]) => {
        const newPickedUsers = users.slice(0)
        newPickedUsers.push(targetUserInfo)
        store.createConversation(newPickedUsers, null, null)
    }
    pickUsers(options)
}

const searchMessages = () => {
    const info = conversationInfo.value
    if (info != null) {
        searchConversationMessages(info.conversation)
    }
}

const openFiles = () => {
    const info = conversationInfo.value
    if (info != null) {
        openConversationFiles(info.conversation, conversationTitle.value)
    }
}

const openLinks = () => {
    const info = conversationInfo.value
    if (info != null) {
        openConversationLinks(info.conversation)
    }
}

const onSilentChange = (value: boolean) => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    // 乐观更新：开关先拨过去，失败再拨回来。错误码由 store 统一 toast。
    // 不拨回来的话，开关显示的是一个服务端并不认可的状态，而且重进页面前一直不自愈。
    isSilent.value = value
    store.setConversationSilent(info.conversation, value, null, (err: number) => {
        isSilent.value = !value
    })
}

const onTopChange = (value: boolean) => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    isTop.value = value
    store.setConversationTop(info.conversation, value ? 1 : 0, null, (err: number) => {
        isTop.value = !value
    })
}

const clearMessages = () => {
    const info = conversationInfo.value
    if (info != null) {
        clearConversationMessages(info.conversation)
    }
}
</script>

<style scoped>
.page {
    width: 100%;
    flex: 1;
}

.tail {
    width: 100%;
    height: 18px;
}
</style>
