<template>
    <view>
        <view class="wf-message-input-container"
            :style="{ paddingBottom: inputPaddingBottom + 'px', backgroundColor: c.bottomBarBg }">
            <view class="wf-message-input-toolbar" :style="{ borderTopColor: c.hairline, borderBottomColor: c.hairline }">
                <text class="wf-input-button-icon wxfont" :style="{ color: c.iconSecondary }" @tap="toggleVoice">{{ showVoice ? '' : '' }}</text>
                <text v-if="isPttEnable" class="wf-input-button-icon wxfont" :style="{ color: c.iconSecondary }" @tap="togglePtt">{{ showPtt ? '' : '' }}</text>
                <view class="wf-input-voice-container" v-if="showVoice">
                    <AudioInputView :conversationInfo="conversationInfo"></AudioInputView>
                </view>
                <view class="wf-input-voice-container" v-else-if="showPtt">
                    <PttAudioInputView :conversationInfo="conversationInfo"></PttAudioInputView>
                </view>
                <view v-else class="wf-input-middle">
                    <view class="wf-input-text-container" :style="{ backgroundColor: c.surface }">
                        <textarea class="wf-input-textarea" :style="{ backgroundColor: c.surface, color: c.textPrimary }" @focus="onInputFocus" @input="onInput" :value="text"
                            placeholder="" :hold-keyboard="true" confirm-type="send" @confirm="send" :maxlength="-1"
                            :auto-height="true" :adjust-position="adjustPosition" />
                    </view>
                    <view v-if="quotedMessage != null" class="quote-message-container" :style="{ backgroundColor: c.bubbleQuoted }">
                        <text class="quoted-message single-line" :style="{ fontSize: fontPx(13), color: c.bubbleQuotedText }">{{ quotedMessageDigest }}</text>
                        <text class="cancel icomoon" :style="{ fontSize: iconPx(16), color: c.textSecondary }" @tap="cancelQuote">&#xf12a;</text>
                    </view>
                </view>
                <text @tap="toggleEmoji" class="wf-input-button-icon wxfont" :style="{ color: c.iconSecondary }">&#xe60b;</text>
                <view v-if="!hideSendButton && text != ''" class="wf-input-text-send-button"
                    :style="{ backgroundColor: c.accent, borderColor: c.accent }" @tap="send">
                    <text class="send-button-text" :style="{ fontSize: fontPx(15), color: c.onAccent }">发送</text>
                </view>
                <text v-if="hideSendButton || text == ''" @tap="toggleExt" class="wf-input-button-icon wxfont"
                    :style="{ color: c.iconSecondary }">&#xe657;</text>
            </view>
            <view v-if="showExt" class="wf-ext-container"
                :style="{ height: keyboardHeight + 'px', backgroundColor: c.bottomBarBg }">
                <view class="wf-ext-item" v-for="(v, i) in extList" @tap="onClickExt(v)" :key="i">
                    <view class="wf-ext-item-icon" :style="{ backgroundColor: c.surface }">
                        <text class="wxfont ext-icon">{{ v.icon }}</text>
                    </view>
                    <text class="wf-ext-item-text" :style="{ fontSize: fontPx(12), color: c.textSecondary }">{{ v.title }}</text>
                </view>
            </view>
            <view v-if="showEmoji" class="wf-stickers-container"
                :style="{ height: keyboardHeight + 'px', backgroundColor: c.inputBg }">
                <view class="category-container">
                    <view class="category" :style="{ borderBottomColor: c.hairline }" v-for="(v, i) in emojiStickerList" :key="i"
                        @tap="onCategoryClick(i)">
                        <image class="category-poster" :class="{ active: i == currentEmojiStickerIndex }" :src="v.poster" mode="aspectFit" />
                    </view>
                </view>
                <scroll-view v-if="currentEmojiStickerIndex == 0" direction="vertical" class="wf-emoji-container"
                    :style="{ height: (keyboardHeight - 60) + 'px' }">
                    <view class="wf-emoji-content">
                        <text class="emoji-item" @tap="onClickEmoji(v)" v-for="(v, i) in emojiStickerList[0].emojis"
                            :key="i">{{ v }}</text>
                    </view>
                </scroll-view>
                <scroll-view v-else direction="vertical" class="wf-sticker-container"
                    :style="{ height: (keyboardHeight - 60) + 'px' }">
                    <view class="wf-sticker-content">
                        <image :src="s" class="sticker-item" mode="aspectFit" @tap="onClickSticker(s)"
                            v-for="(s, j) in emojiStickerList[currentEmojiStickerIndex].stickers" :key="j" />
                    </view>
                </scroll-view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import TextMessageContent from "../../wfc/messages/textMessageContent.uts";
import CardMessageContent from "../../wfc/messages/cardMessageContent.uts";
import TypingMessageContent from "../../wfc/messages/typingMessageContent.uts";
import ConversationInfo from "../../wfc/model/conversationInfo.uts";
import Message from "../../wfc/messages/message.uts";
import UserInfo from "../../wfc/model/userInfo.uts";
import wfc from "../../wfc/client/wfc.uts";
import store, { conversationState, contactState } from "../../store.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import emojiStickerConfig, { EmojiStickerCategory } from "./emojiStickerConfig.uts";
import StickerMessageContent from "../../wfc/messages/stickerMessageContent.uts";
import Config from "../../config.uts";
import QuoteInfo from "../../wfc/model/quoteInfo.uts";
import AudioInputView from "./message/AudioInputView.uvue";
import PttAudioInputView from "./message/PttAudioInputView.uvue";
import Draft from "../util/draft.uts";
import { pickUser, PickUserOptions, pickUsers, PickUsersOptions } from "../../common/picker.uts";
import avEngineKit from "../../wfc/av/engine/avEngineKit.uts";
import CallState from "../../wfc/av/engine/callState.uts";
import checkVoipPermissions from "../../wfc/av/voipUtil.uts";
import pttClient from "../../wfc/ptt/pttClient.uts";
import { navigateToPage } from "../../common/nav.uts";
import { toLocalFilePath } from "../../common/filePath.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx, iconPx } from "@/common/layoutScale.uts";
class ExtItem {
    title = ''
    tag = ''
    icon = ''

    constructor(title: string, tag: string, icon: string) {
        this.title = title
        this.tag = tag
        this.icon = icon
    }
}

defineOptions({
    name: "MessageInputView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const props = defineProps<{
    conversationInfo: ConversationInfo
}>()

const emojiStickerList = ref<EmojiStickerCategory[]>(emojiStickerConfig as EmojiStickerCategory[])
const currentEmojiStickerIndex = ref<number>(0)
const hideSendButton = ref<boolean>((Config.getWFCPlatform() == 1 || Config.getWFCPlatform() == 8) as boolean)
const showVoice = ref<boolean>(false)
const showPtt = ref<boolean>(false)
const isPttEnable = ref<boolean>(Config.ENABLE_PTT && pttClient.isEnable())
const extList = ref<ExtItem[]>([
    new ExtItem('相册', 'image', ''),
    new ExtItem('语音通话', 'voip_a', ''),
    new ExtItem('视频通话', 'voip_v', ''),
    new ExtItem('拍摄', 'shot', ''),
    new ExtItem('文件', 'file', ''),
    new ExtItem('位置', 'location', ''),
    new ExtItem('名片', 'userCard', ''),
] as ExtItem[])
const showExt = ref<boolean>(false)
const showEmoji = ref<boolean>(false)
const text = ref<string>('')
const keyboardHeight = ref<number>(300)
const currentKeyboardHeight = ref<number>(0)
const mentions = ref<UserInfo[]>([] as UserInfo[])
const groupMemberUserInfos = ref<UserInfo[]>([] as UserInfo[])
const safeAreaBottomHeight = ref<number>(0)

const sysInfo = uni.getSystemInfoSync()
safeAreaBottomHeight.value = sysInfo.safeAreaInsets.bottom

// 鸿蒙上 textarea 聚焦时，框架会把 KeyboardAvoidMode 设为 OFFSET，整个页面(含页面内自定义导航栏)
// 被键盘顶出屏幕，且顶起高度按光标算，输入框仍会被挡住一部分。
// 这里关掉系统避让，改为手动把输入区抬到键盘上方，等效 Android 的 softinputMode: adjustResize。
const adjustPosition = ref<boolean>(true)
// #ifdef APP-HARMONY
adjustPosition.value = false
// #endif

// 关掉了系统避让时，键盘弹出期间用等高的 padding 顶起输入区；其余情况只留底部安全区
const inputPaddingBottom = computed<number>((): number => {
    if (!adjustPosition.value && currentKeyboardHeight.value > 0) {
        return currentKeyboardHeight.value
    }
    return safeAreaBottomHeight.value
})

const quotedMessage = computed<Message | null>((): Message | null => {
    return conversationState.quotedMessage
})

const quotedMessageDigest = computed<string>((): string => {
    const quotedMsg = conversationState.quotedMessage
    if (quotedMsg == null) {
        return ''
    }
    return quotedMsg.messageContent.digest(quotedMsg)
})

onMounted(() => {
    if (props.conversationInfo.conversation.type == ConversationType.Group) {
        groupMemberUserInfos.value = store.getGroupMemberUserInfos(props.conversationInfo.conversation.target, false, false);
    }
    restoreDraft();
})

onBeforeUnmount(() => {
    storeDraft()
})

// 与原生保持一致，10s 内最多发一条 typing 消息
const TYPING_INTERVAL = 10 * 1000
let lastTypingTime = 0

const notifyTyping = (typingType: number) => {
    const conversation = props.conversationInfo.conversation
    if (conversation.type != ConversationType.Single && conversation.type != ConversationType.Group) {
        return
    }
    const now = new Date().getTime()
    if (now - lastTypingTime <= TYPING_INTERVAL) {
        return
    }
    lastTypingTime = now
    wfc.sendConversationMessage(conversation, new TypingMessageContent(typingType))
}

const onInput = (event: UniInputEvent) => {
    let inserting = false;
    if (event.detail.value.length > text.value.length) {
        inserting = true;
    }
    text.value = event.detail.value;
    const cursor = event.detail.cursor;
    if (inserting) {
        notifyTyping(TypingMessageContent.TYPING_TEXT);
    }
    if (props.conversationInfo.conversation.type == ConversationType.Group) {
        if (inserting && text.value.length > 0 && cursor > 0 && text.value.charAt(cursor - 1) == '@') {
            const atAll = new UserInfo()
            atAll.uid = '@all'
            atAll.displayName = '所有人'
            const target = store.ensureConversationTarget(props.conversationInfo.conversation)
            atAll.portrait = target != null ? target.portrait : ''
            atAll._displayName = '所有人'

            const options = new PickUserOptions()
            const users: UserInfo[] = [atAll]
            options.users = users.concat(groupMemberUserInfos.value)
            options.showCategoryLabel = false
            options.successCB = (user: UserInfo) => {
                text.value = text.value.substring(0, cursor - 1) + `@${user.displayName} ` + text.value.substring(cursor);
                mentions.value.push(user);
            }
            pickUser(options)
        }
    }
}

// 供会话页调用：撤回后重新编辑、@ 某人
const insertText = (insert: string) => {
    text.value = text.value + insert;
}

const mention = (groupId: string, userId: string) => {
    const userInfo = wfc.getUserInfo(userId, false, groupId);
    mentions.value.push(userInfo);
    text.value = text.value + '@' + userInfo.displayName + ' ';
}

const send = () => {
    if (text.value != '') {
        const textMessageContent = new TextMessageContent(text.value)
        const quotedMsg = conversationState.quotedMessage;
        if (quotedMsg != null) {
            const quoteInfo = QuoteInfo.init(quotedMsg.messageUid, quotedMsg.from, quotedMsg.messageContent.digest(quotedMsg));
            textMessageContent.quoteInfo = quoteInfo;
            store.quoteMessage(null);
        }
        if (props.conversationInfo.conversation.type == ConversationType.Group && mentions.value.length > 0) {
            // 匹配以@开始，后面跟着至少一个非空白字符，并且以空格或行尾结尾的字符串
            const regex = /@\S+(\s|$)/g;
            const matches = text.value.match(regex);
            if (matches != null) {
                for (let i = 0; i < matches.length; i++) {
                    const match = (matches[i] ?? '').trim();
                    if (match == '@所有人') {
                        const index = mentions.value.findIndex((user: UserInfo): boolean => user.uid == '@all')
                        if (index >= 0) {
                            textMessageContent.mentionedType = 2;
                            break
                        }
                    } else {
                        const index = mentions.value.findIndex((user: UserInfo): boolean => user.displayName == match.substring(1));
                        if (index >= 0) {
                            const uid = mentions.value[index].uid;
                            if (textMessageContent.mentionedTargets.indexOf(uid) == -1) {
                                textMessageContent.mentionedType = 1;
                                textMessageContent.mentionedTargets.push(uid);
                            }
                        }
                    }
                }
            }
        }

        wfc.sendConversationMessage(props.conversationInfo.conversation, textMessageContent);
        text.value = '';
        mentions.value = [];
        Draft.setConversationDraft(props.conversationInfo.conversation, '', null);
    }
}

const minimizeMessageInputView = () => {
    showEmoji.value = false;
    showExt.value = false;
}

const onInputFocus = () => {
    showEmoji.value = false;
    showExt.value = false;
}

const toggleVoice = () => {
    // 语音/表情/更多面板都是占据键盘位置的，切过去时先收起键盘，否则两者会同时占底部空间
    uni.hideKeyboard();
    showVoice.value = !showVoice.value;
    showPtt.value = false;
    showEmoji.value = false;
    showExt.value = false;
    if (showVoice.value) {
        notifyTyping(TypingMessageContent.TYPING_VOICE);
    }
}

const togglePtt = () => {
    uni.hideKeyboard();
    showPtt.value = !showPtt.value;
    showVoice.value = false;
    showEmoji.value = false;
    showExt.value = false;
}

const toggleEmoji = () => {
    uni.hideKeyboard();
    showEmoji.value = !showEmoji.value;
    showExt.value = false;
    showVoice.value = false;
    showPtt.value = false;
}

const toggleExt = () => {
    uni.hideKeyboard();
    showExt.value = !showExt.value;
    showEmoji.value = false;
    showVoice.value = false;
    showPtt.value = false;
}

const onClickExt = (ext: ExtItem) => {
    console.log('onClick ext', ext.tag);
    // 选择相册/拍摄/文件等会离开当前面板去挑选内容，提前收起，避免面板一直占据底部空间，
    // 导致发送后消息列表可视区域变小，看起来像“没有滚动到底部”
    showExt.value = false;
    switch (ext.tag) {
        case 'image':
            chooseImage();
            break;
        case 'shot':
            shoot();
            break;
        case 'file':
            chooseFile();
            break;
        case 'voip_a':
            voip(true);
            break;
        case 'voip_v':
            voip(false);
            break;
        case 'userCard':
            pickUserCard();
            break;
        default:
            uni.showToast({
                title: 'TODO ' + ext.title,
                icon: 'none'
            } as ShowToastOptions)
            break;
    }
}

const voip = (audioOnly: boolean) => {
    if (!Config.ENABLE_VOIP) {
        uni.showToast({
            title: '当前版本暂不支持音视频通话',
            icon: 'none',
        } as ShowToastOptions)
        return
    }
    checkVoipPermissions(audioOnly).then((granted: boolean): void => {
        if (!granted) {
            return
        }
        const curSession = avEngineKit.currentCallSession()
        if (curSession != null && curSession.state != CallState.STATUS_IDLE) {
            uni.showToast({
                title: '音视频通话正在进行中...',
                icon: 'none',
            } as ShowToastOptions)
            return
        }
        if (props.conversationInfo.conversation.type == ConversationType.Single) {
            const callSession = avEngineKit.startSingleCall(props.conversationInfo.conversation.target, audioOnly)
            if (callSession != null) {
                navigateToPage('/pages/voip/Single', callSession)
            } else {
                uni.showToast({
                    title: '发起通话失败',
                    icon: 'none',
                } as ShowToastOptions)
            }
        } else if (props.conversationInfo.conversation.type == ConversationType.Group) {
            showPickGroupMemberToVoipModal(audioOnly)
        }
    })
}

const showPickGroupMemberToVoipModal = (audioOnly: boolean) => {
    const options = new PickUsersOptions()
    options.users = groupMemberUserInfos.value
    options.confirmTitle = '确定'
    options.showCategoryLabel = false
    options.successCB = (users: UserInfo[]): void => {
        const ids: string[] = []
        for (let i = 0; i < users.length; i++) {
            ids.push(users[i].uid)
        }
        const callSession = avEngineKit.startMultiCall(props.conversationInfo.conversation.target, ids, audioOnly)
        // 不加延时的话，选人弹窗关闭动画和跳转会互相干扰
        setTimeout((): void => {
            if (callSession != null) {
                navigateToPage('/pages/voip/Multi', callSession)
            } else {
                uni.showToast({
                    title: '发起通话失败',
                    icon: 'none',
                } as ShowToastOptions)
            }
        }, 50)
    }
    pickUsers(options)
}

// 名片：选联系人 → 二次确认 → 发送个人名片
const pickUserCard = () => {
    let users = contactState.favContactList.concat(contactState.friendList)
    if (props.conversationInfo.conversation.type == ConversationType.Single) {
        const target = props.conversationInfo.conversation.target
        users = users.filter((u: UserInfo): boolean => u.uid != target)
    }
    if (users.length == 0) {
        uni.showToast({
            title: '没有可发送的联系人',
            icon: 'none',
        } as ShowToastOptions)
        return
    }
    const options = new PickUserOptions()
    options.users = users
    options.showCategoryLabel = false
    options.successCB = (user: UserInfo) => {
        // 不加延时的话，选人页面关闭动画和弹窗会互相干扰
        setTimeout((): void => {
            confirmSendUserCard(user)
        }, 50)
    }
    pickUser(options)
}

const confirmSendUserCard = (user: UserInfo) => {
    const name = user._displayName != '' ? user._displayName : user.displayName
    uni.showModal({
        title: '发送名片',
        content: '发送 ' + name + ' 的名片？',
        success: (res) => {
            if (!res.confirm) {
                return
            }
            const cardMessageContent = new CardMessageContent(0, user.uid, user.displayName, user.portrait, wfc.getUserId())
            cardMessageContent.name = user.name
            wfc.sendConversationMessage(props.conversationInfo.conversation, cardMessageContent)
        }
    } as ShowModalOptions)
}

const shoot = () => {
    uni.showActionSheet({
        itemList: ['拍照', '录像'],
        success: (res) => {
            if (res.tapIndex == 0) {
                takePhoto()
            } else {
                chooseVideo()
            }
        },
        fail: (err) => {
            console.log('show shoot action sheet fail', err)
        }
    } as ShowActionSheetOptions)
}

const takePhoto = () => {
    notifyTyping(TypingMessageContent.TYPING_CAMERA);
    uni.chooseImage({
        count: 1,
        sourceType: ['camera'],
        sizeType: ['original', 'compressed'],
        success: (e) => {
            for (let i = 0; i < e.tempFilePaths.length; i++) {
                store.sendFile(props.conversationInfo.conversation, toLocalFilePath(e.tempFilePaths[i]));
            }
        },
        fail: (err) => {
            console.log('take photo fail', err)
        }
    } as ChooseImageOptions)
}

const onCategoryClick = (i: number) => {
    currentEmojiStickerIndex.value = i;
}

const onClickEmoji = (emoji: string) => {
    text.value = text.value + emoji;
}

const onClickSticker = (sticker: string) => {
    const stickerMsg = new StickerMessageContent('', sticker, 200, 200)
    wfc.sendConversationMessage(props.conversationInfo.conversation, stickerMsg);
}

const chooseImage = () => {
    uni.chooseImage({
        sourceType: ['album', 'camera'],
        sizeType: ['original', 'compressed'],
        success: (e) => {
            console.log('choose image', e.tempFilePaths.length);
            for (let i = 0; i < e.tempFilePaths.length; i++) {
                store.sendFile(props.conversationInfo.conversation, toLocalFilePath(e.tempFilePaths[i]));
            }
        },
        fail: (err) => {
            console.log('choose image fail', err)
        }
    } as ChooseImageOptions)
}

const chooseVideo = () => {
    notifyTyping(TypingMessageContent.TYPING_CAMERA);
    uni.chooseVideo({
        sourceType: ['camera'],
        success: (e) => {
            console.log('choose video', e.tempFilePath);
            store.sendFile(props.conversationInfo.conversation, toLocalFilePath(e.tempFilePath));
        },
        fail: (err) => {
            console.log('choose video fail', err)
        }
    } as ChooseVideoOptions)
}

const chooseFile = () => {
    notifyTyping(TypingMessageContent.TYPING_FILE);
    wfc.chooseFile('all', (file: UTSJSONObject) => {
        const path = toLocalFilePath(file.getString('path') ?? '');
        if (path == '') {
            return
        }
        const name = file.getString('name') ?? ''
        const size = file.getNumber('size') ?? 0
        store.sendFile(props.conversationInfo.conversation, path, name, size);
    }, (err: number) => {
        console.error('choose file error', err);
    });
}

const onKeyboardHeightChange = (kbHeight: number, currentKbHeight: number) => {
    // kbHeight 是记住的键盘高度，用作表情/更多面板高度，还没记住过(为 0)时保留默认值
    if (kbHeight > 0) {
        keyboardHeight.value = kbHeight;
    }
    currentKeyboardHeight.value = currentKbHeight;
}

const cancelQuote = () => {
    store.quoteMessage(null);
}

const restoreDraft = () => {
    const draft = Draft.getConversationDraftEx(props.conversationInfo);
    store.quoteMessage(draft.quotedMessage);
    if (text.value != '') {
        console.log('inputting, ignore', draft.text)
    } else {
        text.value = draft.text;
    }
}

const storeDraft = () => {
    const conversationInfo = props.conversationInfo
    const quotedMsg = conversationState.quotedMessage;
    const draftText = text.value.trim();
    const quoteInfo = quotedMsg != null
        ? QuoteInfo.init(quotedMsg.messageUid, quotedMsg.from, quotedMsg.messageContent.digest(quotedMsg))
        : null;

    if (draftText.length == 0) {
        if (conversationInfo.draft != '') {
            Draft.setConversationDraft(conversationInfo.conversation, draftText, quoteInfo)
        }
    } else {
        if (draftText != conversationInfo.draft) {
            Draft.setConversationDraft(conversationInfo.conversation, draftText, quoteInfo)
        }
    }
}

defineExpose({
    insertText,
    mention,
    minimizeMessageInputView,
    onKeyboardHeightChange,
})
</script>

<style scoped>
.wf-message-input-container {
    width: 100%;
}

.wf-ext-container {
    width: 100%;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
}

.wf-ext-item {
    padding: 17px;
    display: flex;
    flex-direction: column;
    align-items: center;
}

.wf-ext-item-icon {
    width: 55px;
    height: 55px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    border-radius: 6px;
}

.ext-icon {
    font-size: 32px;
}

.wf-ext-item-text {
    margin-top: 8px;
}

.wf-message-input-toolbar {
    position: relative;
    padding: 8px 6px;
    display: flex;
    width: 100%;
    flex-direction: row;
    align-items: flex-end;
    justify-content: space-around;
    border-top-width: 1px;
    border-top-style: solid;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.wf-input-middle {
    flex: 1;
