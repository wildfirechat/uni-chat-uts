<template>
    <view class="conversation-info" v-if="conversationInfo != null">
        <view class="page-header">
            <view class="field">
                <text class="field-label">群名称</text>
                <input class="field-input" type="text" :disabled="!enableEditGroupNameOrAnnouncement"
                    v-model="newGroupName" @confirm="updateGroupName" :placeholder="groupDisplayName" />
            </view>
            <view class="field">
                <text class="field-label">群公告</text>
                <input class="field-input" type="text" :disabled="!enableEditGroupNameOrAnnouncement"
                    @confirm="updateGroupAnnouncement" v-model="newGroupAnnouncement" :placeholder="groupAnnouncement" />
            </view>
            <view class="fav-switch">
                <text class="field-label">保存到通讯录</text>
                <switch class="fav-switch-control" :checked="isFavGroup" @change="onFavSwitchChange" />
            </view>
        </view>
        <view class="search-item">
            <input class="search-input" type="text" v-model="filterQuery" placeholder="搜索" />
        </view>
        <list-view class="member-container" direction="vertical">
            <list-item v-if="enableAddGroupMember && filterQuery == ''" @tap="showCreateConversationModal" class="action-item">
                <view class="icon">
                    <text class="icon-text">+</text>
                </view>
                <text class="action-text">添加成员</text>
            </list-item>
            <list-item v-if="enableRemoveGroupMember && filterQuery == ''" @tap="showRemoveGroupMemberModal" class="action-item">
                <view class="icon">
                    <text class="icon-text">-</text>
                </view>
                <text class="action-text">移除成员</text>
            </list-item>
            <UserListView :users="users" :show-category-label="false" padding-left="20px" />
        </list-view>
        <view @tap="quitGroup(false)" class="quit-group-item">
            <text class="quit-group-text">退出群组</text>
        </view>
        <view v-if="isOwner" @tap="quitGroup(true)" class="quit-group-item">
            <text class="quit-group-text">解散群组</text>
        </view>
    </view>
</template>

<script setup lang="uts">
import UserListView from "@/pages/user/UserListView.uvue";
import store, { contactState } from "@/store.uts";
import wfc from "@/wfc/client/wfc.uts";
import GroupMemberType from "@/wfc/model/groupMemberType.uts";
import GroupType from "@/wfc/model/groupType.uts";
import ModifyGroupInfoType from "@/wfc/model/modifyGroupInfoType.uts";
import ConversationInfo from "@/wfc/model/conversationInfo.uts";
import UserInfo from "@/wfc/model/userInfo.uts";
import EventType from "../../wfc/client/wfcEvent.uts";
import appServerApi from "../../api/appServerApi.uts";
import { takePageOptions } from "@/common/nav.uts";
import { pickUsers, PickUsersOptions } from "@/common/picker.uts";

defineOptions({
    name: "GroupConversationInfoPage"
})

const conversationInfo = ref<ConversationInfo | null>(null)
const groupMemberUserInfos = ref<UserInfo[]>([] as UserInfo[])
const filterQuery = ref<string>('')
const groupAnnouncement = ref<string>('')
const newGroupName = ref<string>('')
const newGroupAnnouncement = ref<string>('')

const groupDisplayName = computed<string>((): string => {
    const info = conversationInfo.value
    if (info == null) {
        return ''
    }
    const target = store.ensureConversationTarget(info.conversation)
    return target != null ? target._displayName : ''
})

const isFavGroup = computed<boolean>((): boolean => {
    const info = conversationInfo.value
    if (info == null) {
        return false
    }
    const target = store.ensureConversationTarget(info.conversation)
    return target != null ? target._isFav : false
})

const enableAddGroupMember = computed<boolean>((): boolean => {
    const info = conversationInfo.value
    if (info == null) {
        return false
    }
    const selfUid = wfc.getUserId();
    const groupInfo = wfc.getGroupInfo(info.conversation.target, false);
    //在group type为Restricted时，0 开放加入权限；1 只能群成员拉人入群；2 只能群管理拉人入群
    if (groupInfo.type == GroupType.Restricted) {
        if (groupInfo.joinType == 0 || groupInfo.joinType == 1) {
            return true;
        } else if (groupInfo.joinType == 2) {
            const groupMember = wfc.getGroupMember(info.conversation.target, selfUid);
            return groupMember.type == GroupMemberType.Manager || groupMember.type == GroupMemberType.Owner;
        }
    }
    return true;
})

const enableRemoveGroupMember = computed<boolean>((): boolean => {
    const info = conversationInfo.value
    if (info == null) {
        return false
    }
    const selfUid = wfc.getUserId();
    const groupMember = wfc.getGroupMember(info.conversation.target, selfUid);
    return groupMember.type == GroupMemberType.Manager || groupMember.type == GroupMemberType.Owner;
})

const enableEditGroupNameOrAnnouncement = computed<boolean>((): boolean => {
    const info = conversationInfo.value
    if (info == null) {
        return false
    }
    const selfUid = wfc.getUserId();
    const groupMember = wfc.getGroupMember(info.conversation.target, selfUid);
    return groupMember.type == GroupMemberType.Manager || groupMember.type == GroupMemberType.Owner;
})

const users = computed<UserInfo[]>((): UserInfo[] => {
    if (filterQuery.value != '') {
        return store.filterUsers(groupMemberUserInfos.value, filterQuery.value)
    } else {
        return groupMemberUserInfos.value;
    }
})

const isOwner = computed<boolean>((): boolean => {
    const info = conversationInfo.value
    if (info == null) {
        return false
    }
    const selfUid = wfc.getUserId();
    const groupInfo = wfc.getGroupInfo(info.conversation.target, false);
    return groupInfo.owner == selfUid
})

const onConversationMembersUpdate = (_args: Array<any | null>) => {
    const info = conversationInfo.value
    if (info != null) {
        groupMemberUserInfos.value = store.getConversationMemberUsrInfos(info.conversation);
    }
}

onLoad((_options: OnLoadOptions) => {
    console.log('GroupConversationInfoPage onLoad')
    const pageOptions = takePageOptions()
    if (pageOptions != null && pageOptions instanceof ConversationInfo) {
        const info = pageOptions as ConversationInfo
        conversationInfo.value = info;
        groupMemberUserInfos.value = store.getConversationMemberUsrInfos(info.conversation);

        const target = store.ensureConversationTarget(info.conversation)
        uni.setNavigationBarTitle({
            title: target != null ? target._displayName : '',
        } as SetNavigationBarTitleOptions);

        getGroupAnnouncement();
    }
})

onMounted(() => {
    wfc.eventEmitter.on(EventType.UserInfosUpdate, onConversationMembersUpdate)
    wfc.eventEmitter.on(EventType.GroupMembersUpdate, onConversationMembersUpdate)
})

onBeforeUnmount(() => {
    wfc.eventEmitter.off(EventType.UserInfosUpdate, onConversationMembersUpdate)
    wfc.eventEmitter.off(EventType.GroupMembersUpdate, onConversationMembersUpdate)
})

const showCreateConversationModal = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    const members = store.getGroupMemberUserInfos(info.conversation.target, false);
    const options = new PickUsersOptions()
    options.users = contactState.favContactList.concat(contactState.friendList)
    options.initialCheckedUsers = members
    options.uncheckableUsers = members
    options.confirmTitle = '添加'
    options.successCB = (users: UserInfo[]) => {
        const ids: string[] = []
        for (let i = 0; i < users.length; i++) {
            ids.push(users[i].uid)
        }
        wfc.addGroupMembers(info.conversation.target, ids, '', [0], null, () => {
            groupMemberUserInfos.value = store.getConversationMemberUsrInfos(info.conversation);
        }, (err: number) => {
            uni.showToast({
                title: '邀请新成员失败 ' + err,
                icon: 'none',
            } as ShowToastOptions);
        })
    }
    pickUsers(options)
}

const showRemoveGroupMemberModal = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    const members = store.getGroupMemberUserInfos(info.conversation.target, false, false);
    const options = new PickUsersOptions()
    options.users = members
    options.confirmTitle = '移除'
    options.showCategoryLabel = false
    options.successCB = (users: UserInfo[]) => {
        const ids: string[] = []
        for (let i = 0; i < users.length; i++) {
            ids.push(users[i].uid)
        }
        wfc.kickoffGroupMembers(info.conversation.target, ids, [0], null, () => {
            groupMemberUserInfos.value = store.getConversationMemberUsrInfos(info.conversation);
        }, (err: number) => {
            uni.showToast({
                title: '踢除群成员失败' + err,
                icon: 'none',
            } as ShowToastOptions);
        })
    }
    pickUsers(options)
}

const getGroupAnnouncement = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    appServerApi.getGroupAnnouncement(info.conversation.target)
        .then((result): void => {
            const text = result?.getString('text')
            if (text != null && text != '') {
                groupAnnouncement.value = text;
            } else {
                if (enableEditGroupNameOrAnnouncement.value) {
                    groupAnnouncement.value = '点击编辑群公告';
                }
            }
        })
        .catch((err): void => {
            console.log('getGroupAnnouncement error', err)
        })
}

const updateGroupName = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    const groupId = info.conversation.target;
    const target = store.ensureConversationTarget(info.conversation)
    if (newGroupName.value == '' || (target != null && newGroupName.value == target._displayName)) {
        return;
    }

    wfc.modifyGroupInfo(groupId, ModifyGroupInfoType.Modify_Group_Name, newGroupName.value, [0], null, () => {
        if (target != null) {
            target._displayName = newGroupName.value;
        }
        uni.setNavigationBarTitle({
            title: newGroupName.value,
        } as SetNavigationBarTitleOptions);
    }, (err: number) => {
        console.log('err', err)
    })
}

const updateGroupAnnouncement = () => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    if (newGroupAnnouncement.value == '' || newGroupAnnouncement.value == groupAnnouncement.value) {
        return;
    }
    appServerApi.updateGroupAnnouncement(wfc.getUserId(), info.conversation.target, newGroupAnnouncement.value)
        .then((result): void => {
            groupAnnouncement.value = newGroupAnnouncement.value;
        })
        .catch((err): void => {
            console.log('updateGroupAnnouncement error', err)
        })
}

const quitGroup = (dismiss: boolean) => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    if (dismiss) {
        store.dismissGroup(info.conversation.target)
    } else {
        store.quitGroup(info.conversation.target)
    }
    uni.switchTab({
        url: '/pages/conversationList/ConversationListPage',
    } as SwitchTabOptions);
}

const onFavSwitchChange = (e: UniSwitchChangeEvent) => {
    const info = conversationInfo.value
    if (info == null) {
        return
    }
    const groupId = info.conversation.target
    const fav = e.detail.value
    wfc.setFavGroup(groupId, fav, () => {
        const target = store.ensureConversationTarget(info.conversation)
        if (target != null) {
            target._isFav = fav;
        }
        store.reloadFavGroupList();
    }, (err: number) => {
        console.log('setFavGroup error', err);
    })
}
</script>

<style scoped>
.conversation-info {
    display: flex;
    flex-direction: column;
    position: relative;
    justify-content: flex-start;
    flex: 1;
    overflow: hidden;
    background-color: #ffffff;
}

.page-header {
    padding-left: 20px;
    padding-right: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.field {
    width: 100%;
    display: flex;
    margin-top: 15px;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
}

.field-label {
    font-size: 14px;
    color: #999999;
}

.field-input {
    margin-top: 5px;
    width: 100%;
    font-size: 13px;
    background-color: transparent;
}

.fav-switch {
    width: 100%;
    display: flex;
    flex-direction: row;
    margin-top: 15px;
    padding-bottom: 15px;
    align-items: center;
    border-bottom: 1px solid #ececec;
}

.fav-switch-control {
    margin-left: 20px;
}

.member-container {
    flex: 1;
}

.search-item {
    position: relative;
    padding: 10px 20px;
}

.search-input {
    width: 100%;
    padding: 0 10px 0 20px;
    height: 25px;
    border-radius: 3px;
    border: 1px solid #ededed;
    background-color: #ffffff;
}

.action-item {
    height: 50px;
    display: flex;
    flex-direction: row;
    padding-left: 20px;
    align-items: center;
}

.icon {
    width: 40px;
    height: 40px;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    border-radius: 3px;
    border: 1px dashed #d6d6d6;
}

.icon-text {
    font-size: 20px;
    color: #888888;
}

.action-text {
    margin-left: 10px;
    font-size: 13px;
}

.quit-group-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    height: 50px;
    border-top: 1px solid #ececec;
}

.quit-group-text {
    color: #ff0000;
    font-size: 15px;
}
</style>
