<template>
    <view class="organization-tree-container" :style="{ backgroundColor: c.surface }">
        <scroll-view class="breadcrumb" direction="horizontal">
            <view class="breadcrumb-list">
                <view v-for="(org, index) in currentOrganizationPathList" :key="index" class="breadcrumb-item">
                    <text class="breadcrumb-link"
                        :style="{ fontSize: fontPx(13), color: index == currentOrganizationPathList.length - 1 ? c.textSecondary : c.accent }"
                        @tap="loadAndShowOrganization(org)">{{ org.getString('name') ?? '' }}</text>
                    <text v-if="index != currentOrganizationPathList.length - 1" class="breadcrumb-sep"
                        :style="{ fontSize: fontPx(13), color: c.textSecondary }">&gt;</text>
                </view>
            </view>
        </scroll-view>
        <scroll-view class="member-list-container" direction="vertical">
            <view v-for="(org, index) in subOrganizations" :key="'o-' + index">
                <view class="organization-item" :style="{ backgroundColor: c.surface }" @tap="loadAndShowOrganization(org)">
                    <image class="item-portrait" :style="{ backgroundColor: c.inputBg }" :src="orgPortrait(org)" />
                    <text class="name" :style="{ fontSize: fontPx(14), color: c.textPrimary }">{{ org.getString('name') ?? '' }}</text>
                </view>
            </view>
            <view v-for="(employee, index) in employees" :key="'e-' + index">
                <view class="organization-item" :style="{ backgroundColor: c.surface }" @tap="showUserInfo(employee)">
                    <image class="item-portrait" :style="{ backgroundColor: c.inputBg }" :src="employeePortrait(employee)" />
                    <text class="name" :style="{ fontSize: fontPx(14), color: c.textPrimary }">{{ employee.getString('name') ?? '' }}</text>
                </view>
            </view>
        </scroll-view>
    </view>
</template>

<script setup lang="uts">
import store, { contactState } from "../../store.uts";
import Config from "../../config.uts";
import organizationServerApi from "../../api/organizationServerApi.uts";
import wfc from "../../wfc/client/wfc.uts";
import UserInfo from "../../wfc/model/userInfo.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "OrganizationTreePage"
})


const c = computed<AppColors>((): AppColors => colors())
const subOrganizations = ref<UTSJSONObject[]>([] as UTSJSONObject[])
const employees = ref<UTSJSONObject[]>([] as UTSJSONObject[])
const currentOrganizationPathList = ref<UTSJSONObject[]>([] as UTSJSONObject[])

const orgPortrait = (org: UTSJSONObject): string => {
    const portrait = org.getString('portrait')
    return portrait != null && portrait != '' ? portrait : Config.DEFAULT_DEPARTMENT_PORTRAIT_URL
}

const employeePortrait = (employee: UTSJSONObject): string => {
    const portrait = employee.getString('portrait')
    return portrait != null && portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
}

const toJsonObjectList = (value: any | null): UTSJSONObject[] => {
    const list: UTSJSONObject[] = []
    if (value != null && value instanceof Array) {
        const arr = value as Array<any>
        for (let i = 0; i < arr.length; i++) {
            const o = arr[i]
            if (o instanceof UTSJSONObject) {
                list.push(o as UTSJSONObject)
            }
        }
    }
    return list
}

const loadOrganizationPathStep = (orgId: number, pathList: UTSJSONObject[]) => {
    organizationServerApi.getOrganizations([orgId])
        .then((res): void => {
            const orgs = toJsonObjectList(res)
            if (orgs.length > 0) {
                const org = orgs[0]
                pathList.push(org)
                const parentId = org.getNumber('parentId') ?? 0
                if (parentId > 0) {
                    loadOrganizationPathStep(parentId, pathList)
                    return
                }
            }
            currentOrganizationPathList.value = pathList.slice(0).reverse();
        })
        .catch((err): void => {
            console.log('loadOrganizationPath error', err)
            currentOrganizationPathList.value = pathList.slice(0).reverse();
        })
}

// 逐级加载组织路径（替代原递归实现）
const loadOrganizationPath = (orgId: number) => {
    const pathList: UTSJSONObject[] = []
    loadOrganizationPathStep(orgId, pathList)
}

const loadAndShowOrganization = (org: UTSJSONObject) => {
    const orgId = org.getNumber('id') ?? 0
    organizationServerApi.getOrganizationEx(orgId)
        .then((res): void => {
            if (res != null && res instanceof UTSJSONObject) {
                const obj = res as UTSJSONObject
                subOrganizations.value = toJsonObjectList(obj.get('subOrganizations'));
                employees.value = toJsonObjectList(obj.get('employees'));
            }
        })
        .catch((err): void => {
            console.log('getOrganizationEx error', err)
        });
    loadOrganizationPath(orgId)
}

const showUserInfo = (employee: UTSJSONObject) => {
    const employeeId = employee.getString('employeeId') ?? ''
    wfc.getUserInfoEx(employeeId, false, (userInfo: UserInfo) => {
        store.setCurrentFriend(userInfo);
        uni.navigateTo({
            url: '/pages/contact/UserDetailPage',
            fail: (err) => {
                console.log('nav to UserDetailPage err', err);
            }
        } as NavigateToOptions)
    }, (err: number) => {
        console.log('getUserInfoEx error', err)
    })
}

onMounted(() => {
    const currentOrganization = contactState.currentOrganization
    if (currentOrganization != null) {
        loadAndShowOrganization(currentOrganization);
    }
})
</script>

<style scoped>
.organization-tree-container {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.breadcrumb {
    padding: 10px 0 0 10px;
}

.breadcrumb-list {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
}

.breadcrumb-item {
    display: flex;
    flex-direction: row;
    align-items: center;
}

.breadcrumb-sep {
    margin: 0 10px;
}

.member-list-container {
    flex: 1;
}

.organization-item {
    display: flex;
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 10px;
}

.item-portrait {
    width: 40px;
    height: 40px;
    border-radius: 5px;
    margin-right: 10px;
}

</style>
