<template>
    <view class="user-detail-container" v-if="user != null">
        <view class="detail-header" :style="{ borderBottomColor: c.hairline }">
            <view class="name-container">
                <text class="user-name" :style="{ color: c.textPrimary }">{{ name }}</text>
            </view>
            <image class="avatar" :src="user.portrait" :style="{ backgroundColor: c.inputBg }" />
        </view>
        <view class="content">
            <view class="info-item">
                <text class="info-label" :style="{ color: c.textSecondary }">备注名</text>
                <input class="alias-input" :style="{ color: c.textPrimary }" type="text" :value="user.friendAlias" placeholder="备注名"
                    @confirm="updateFriendAlias" />
            </view>
            <view class="info-item">
                <text class="info-label" :style="{ color: c.textSecondary }">野火ID</text>
                <text class="info-value single-line" :style="{ color: c.textPrimary }">{{ user.name }}</text>
            </view>
            <view class="info-item">
                <text class="info-label" :style="{ color: c.textSecondary }">地区</text>
                <text class="info-value" :style="{ color: c.textPrimary }">未知</text>
            </view>
            <view class="info-item">
                <text class="info-label" :style="{ color: c.textSecondary }">标签</text>
                <text class="info-value" :style="{ color: c.textPrimary }">测试用户</text>
            </view>
        </view>
        <view class="detail-footer" :style="{ borderTopColor: c.hairline }">
            <view class="action" @tap="chat">
                <text class="icomoon action-icon" :style="{ color: c.accent }">&#xf3fb;</text>
                <text class="action-label" :style="{ color: c.accent }">发消息</text>
            </view>
            <view class="action" @tap="startAudioCall">
                <text class="icomoon action-icon" :style="{ color: c.accent }">&#xf4b8;</text>
                <text class="action-label" :style="{ color: c.accent }">语音通话</text>
            </view>
            <view class="action" @tap="startVideoCall">
                <text class="icomoon action-icon" :style="{ color: c.accent }">&#xf4cc;</text>
                <text class="action-label" :style="{ color: c.accent }">视频通话</text>
            </view>
            <view v-if="!isFriend && !isSelf" class="action" @tap="addFriend">
                <text class="icomoon action-icon" :style="{ color: c.accent }">&#xf39f;</text>
                <text class="action-label" :style="{ color: c.accent }">添加好友</text>
            </view>
            <view v-if="isFriend && !isSelf" class="action" @tap="deleteFriend">
                <text class="icomoon action-icon" :style="{ color: c.danger }">&#xf2f4;</text>
                <text class="action-label" :style="{ color: c.danger }">删除好友</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import store, { contactState } from "../../store.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import Conversation from "../../wfc/model/conversation.uts";
import UserInfo from "../../wfc/model/userInfo.uts";
import wfc from "../../wfc/client/wfc.uts";
import { go2ConversationPage } from "../../common/nav.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "UserDetailPage"
})


const c = computed<AppColors>((): AppColors => colors())
const user = ref<UserInfo | null>(contactState.currentFriend as UserInfo | null)

const name = computed<string>((): string => {
    const friend = user.value;
    if (friend == null) {
        return '';
    }
    return friend.displayName != '' ? friend.displayName : friend.name;
})

const isFriend = computed<boolean>((): boolean => {
    const friend = user.value
    return friend != null && wfc.isMyFriend(friend.uid);
})

const isSelf = computed<boolean>((): boolean => {
    const friend = user.value
    return friend != null && friend.uid == wfc.getUserId();
})

onMounted(() => {
    const friend = user.value
    if (friend != null) {
        wfc.getUserInfo(friend.uid, true);
    }
})

onUnload(() => {
    store.setCurrentFriend(null);
})

const chat = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    const conversation = new Conversation(ConversationType.Single, friend.uid, 0);
    store.setCurrentConversation(conversation);
    go2ConversationPage();
}

const updateFriendAlias = (e: UniInputConfirmEvent) => {
    const friend = user.value
    if (friend == null) {
        return
    }
    const friendAlias = e.detail.value;
    if (friendAlias.trim() != '' && friendAlias != friend.friendAlias) {
        wfc.setFriendAlias(friend.uid, friendAlias,
            () => {
                console.log('setFriendAlias success', friendAlias);
            },
            (error: number) => {
                console.log('setFriendAlias error', error);
            })
    }
}

const deleteFriend = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    wfc.deleteFriend(friend.uid, () => {
        uni.showToast({
            title: '删除好友成功',
            icon: 'none'
        } as ShowToastOptions);
        setTimeout(() => {
            uni.navigateBack({
                delta: 1
            } as NavigateBackOptions)
        }, 1000)
    }, (err: number) => {
        uni.showToast({
            title: '删除好友失败' + err,
            icon: 'none'
        } as ShowToastOptions);
    })
}

const addFriend = () => {
    const friend = user.value
    if (friend == null) {
        return
    }
    const userInfo = wfc.getUserInfo(wfc.getUserId());
    const reason = '你好，我是' + userInfo.displayName;
    wfc.sendFriendRequest(friend.uid, reason, '', () => {
        uni.showToast({
            title: '好友请求发送成功',
            icon: 'none'
        } as ShowToastOptions);
        setTimeout(() => {
            uni.navigateBack({
                delta: 1
            } as NavigateBackOptions)
        }, 1000)
    }, (err: number) => {
        uni.showToast({
            title: '好友请求发送失败 ' + err,
            icon: 'none'
        } as ShowToastOptions);
    })
}

const startAudioCall = () => {
    uni.showToast({
        title: '当前版本暂不支持音视频通话',
        icon: 'none'
    } as ShowToastOptions)
}

const startVideoCall = () => {
    uni.showToast({
        title: '当前版本暂不支持音视频通话',
        icon: 'none'
    } as ShowToastOptions)
}
</script>

<style scoped>
.user-detail-container {
    margin-left: 30px;
    margin-right: 30px;
    flex: 1;
}

.detail-header {
    margin-top: 30px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.avatar {
    width: 80px;
    height: 80px;
    border-radius: 2px;
}

.user-name {
    font-size: 20px;
    margin-bottom: 5px;
}

.content {
    width: 100%;
    margin: 20px 0;
}

.info-item {
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.info-label {
    margin-right: 20px;
    width: 60px;
    font-size: 14px;
}

.info-value {
    flex: 1;
    font-size: 14px;
}

.alias-input {
    flex: 1;
    height: 20px;
    font-size: 14px;
}

.detail-footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
    padding-top: 30px;
    border-top-width: 1px;
    border-top-style: solid;
}

.action {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    align-items: center;
}

.action-label {
    font-size: 10px;
    padding-top: 1px;
}

.action-icon {
    font-size: 20px;
}

</style>
