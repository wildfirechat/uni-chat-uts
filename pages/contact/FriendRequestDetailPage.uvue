    margin-left: 90px;
    margin-right: 90px;
    flex: 1;
}

.detail-header {
    margin-top: 60px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15px;
    border-bottom: 1px solid #e6e6e6;
}

.avatar {
    width: 80px;
    height: 80px;
    border-radius: 2px;
}

.user-name {
    font-size: 20px;
    margin-bottom: 5px;
}

.greeting {
    font-size: 14px;
    color: #888888;
}

.content {
    width: 100%;
    margin: 20px 0;
}

.info-item {
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.info-label {
    margin-right: 20px;
    font-size: 14px;
    color: #333333;
}

.info-value {
    flex: 1;
    font-size: 14px;
}

.detail-footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
}

.chat-button {
    margin-top: 30px;
    padding: 10px 40px;
    background-color: #3497f1;
    border-radius: 5px;
}

.chat-button-text {
    color: #ffffff;
    font-size: 15px;
}
</style>
