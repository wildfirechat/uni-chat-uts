<template>
    <view class="user-detail-container" v-if="friendRequest != null">
        <view class="detail-header">
            <view class="name-container">
                <text class="user-name">{{ name }}</text>
                <text class="greeting">你好</text>
            </view>
            <image class="avatar" :src="portrait" />
        </view>
        <view class="content">
            <view class="info-item">
                <text class="info-label">备注名</text>
                <text class="info-value">{{ alias }}</text>
            </view>
            <view class="info-item">
                <text class="info-label">地区</text>
                <text class="info-value">未知</text>
            </view>
            <view class="info-item">
                <text class="info-label">标签</text>
                <text class="info-value">测试用户</text>
            </view>
        </view>
        <view class="detail-footer">
            <view class="chat-button" @tap="chat">
                <text class="chat-button-text">发消息</text>
            </view>
        </view>
    </view>
</template>

<script lang="uts">
import store, { contactState } from "../../store.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import Conversation from "../../wfc/model/conversation.uts";
import FriendRequest from "../../wfc/model/friendRequest.uts";
import Config from "../../config.uts";
import { go2ConversationPage } from "../../common/nav.uts";

export default {
    name: "FriendRequestDetailPage",
    computed: {
        friendRequest(): FriendRequest | null {
            return contactState.currentFriendRequest
        },
        portrait(): string {
            const friendRequest = this.friendRequest
            if (friendRequest == null) {
                return Config.DEFAULT_PORTRAIT_URL
            }
            const target = friendRequest._target
            const portrait = target != null ? target.portrait : ''
            return portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
        },
        alias(): string {
            const friendRequest = this.friendRequest
            if (friendRequest == null) {
                return ''
            }
            const target = friendRequest._target
            return target != null ? target.friendAlias : ''
        },
        name(): string {
            const friendRequest = this.friendRequest
            if (friendRequest == null) {
                return ''
            }
            const friend = friendRequest._target;
            if (friend == null) {
                return ''
            }
            if (friend.friendAlias != '') {
                return friend.friendAlias;
            } else if (friend.displayName != '') {
                return friend.displayName;
            }
            return friend.name;
        }
    },
    methods: {
        chat() {
            const friendRequest = this.friendRequest
            if (friendRequest == null) {
                return
            }
            const conversation = new Conversation(ConversationType.Single, friendRequest.target, 0);
            store.setCurrentConversation(conversation);
            go2ConversationPage();
        }
    },
}
</script>

