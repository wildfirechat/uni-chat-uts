<template>
    <view class="user-detail-container" v-if="friendRequest != null">
        <view class="detail-header" :style="{ borderBottomColor: c.hairline }">
            <view class="name-container">
                <text class="user-name" :style="{ fontSize: fontPx(20), color: c.textPrimary }">{{ name }}</text>
                <text class="greeting" :style="{ fontSize: fontPx(14), color: c.textSecondary }">你好</text>
            </view>
            <image class="avatar" :src="portrait" :style="{ backgroundColor: c.inputBg }" />
        </view>
        <view class="content">
            <view class="info-item">
                <text class="info-label" :style="{ fontSize: fontPx(14), color: c.textSecondary }">备注名</text>
                <text class="info-value" :style="{ fontSize: fontPx(14), color: c.textPrimary }">{{ alias }}</text>
            </view>
            <view class="info-item">
                <text class="info-label" :style="{ fontSize: fontPx(14), color: c.textSecondary }">地区</text>
                <text class="info-value" :style="{ fontSize: fontPx(14), color: c.textPrimary }">未知</text>
            </view>
            <view class="info-item">
                <text class="info-label" :style="{ fontSize: fontPx(14), color: c.textSecondary }">标签</text>
                <text class="info-value" :style="{ fontSize: fontPx(14), color: c.textPrimary }">测试用户</text>
            </view>
        </view>
        <view class="detail-footer">
            <view class="chat-button" :style="{ backgroundColor: c.accent }" @tap="chat">
                <text class="chat-button-text" :style="{ fontSize: fontPx(15), color: c.onAccent }">发消息</text>
            </view>
        </view>
        <watermark-overlay />
    </view>
</template>

<script setup lang="uts">
import store, { contactState } from "../../store.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import Conversation from "../../wfc/model/conversation.uts";
import FriendRequest from "../../wfc/model/friendRequest.uts";
import Config from "../../config.uts";
import { go2ConversationPage } from "../../common/nav.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "FriendRequestDetailPage"
})


const c = computed<AppColors>((): AppColors => colors())
const friendRequest = computed<FriendRequest | null>((): FriendRequest | null => {
    return contactState.currentFriendRequest
})

const portrait = computed<string>((): string => {
    const friendRequest = friendRequest.value
    if (friendRequest == null) {
        return Config.DEFAULT_PORTRAIT_URL
    }
    const target = friendRequest._target
    const portrait = target != null ? target.portrait : ''
    return portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
})

const alias = computed<string>((): string => {
    const friendRequest = friendRequest.value
    if (friendRequest == null) {
        return ''
    }
    const target = friendRequest._target
    return target != null ? target.friendAlias : ''
})

const name = computed<string>((): string => {
    const friendRequest = friendRequest.value
    if (friendRequest == null) {
        return ''
    }
    const friend = friendRequest._target;
    if (friend == null) {
        return ''
    }
    if (friend.friendAlias != '') {
        return friend.friendAlias;
    } else if (friend.displayName != '') {
        return friend.displayName;
    }
    return friend.name;
})

const chat = () => {
    const friendRequest = friendRequest.value
    if (friendRequest == null) {
        return
    }
    const conversation = new Conversation(ConversationType.Single, friendRequest.target, 0);
    store.setCurrentConversation(conversation);
    go2ConversationPage();
}
</script>

<style scoped>
.user-detail-container {
    margin-left: 90px;
    margin-right: 90px;
    flex: 1;
}

.detail-header {
    margin-top: 60px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 15px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.avatar {
    width: 80px;
    height: 80px;
    border-radius: 2px;
}

.user-name {
    margin-bottom: 5px;
}

.content {
    width: 100%;
    margin: 20px 0;
}

.info-item {
    height: 40px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.info-label {
    margin-right: 20px;
}

.info-value {
    flex: 1;
}

.detail-footer {
    display: flex;
    flex-direction: row;
    justify-content: center;
}

.chat-button {
    margin-top: 30px;
    padding: 10px 40px;
    border-radius: 5px;
}

</style>
