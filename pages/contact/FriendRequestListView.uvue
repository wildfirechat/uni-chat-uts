<template>
    <view class="new-friend-item-container">
        <view v-for="(friendRequest, index) in friendRequestList" :key="index" @tap="showFriendRequest(friendRequest)"
            class="new-friend-item" :style="{ borderBottomColor: c.hairlineSoft }">
            <image class="avatar" :src="portraitOf(friendRequest)" :style="{ backgroundColor: c.inputBg }" />
            <view class="info">
                <view class="name">
                    <text class="single-line request-name" :style="{ color: c.textPrimary }">{{ displayNameOf(friendRequest) }}</text>
                    <text class="reason single-line" :style="{ color: c.textTertiary }">{{ reasonOf(friendRequest) }}</text>
                </view>
                <text v-if="friendRequest.status == 1" class="status" :style="{ color: c.textTertiary }">已添加</text>
                <button v-else-if="friendRequest.status == 0" class="accept" size="mini"
                    :style="{ color: c.onAccent, backgroundColor: c.accent, borderColor: c.accent }"
                    @tap="accept(friendRequest)">添加</button>
                <text v-else-if="friendRequest.status == 3" class="status" :style="{ color: c.textTertiary }">已拒绝</text>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import store, { contactState } from "../../store.uts";
import wfc from "../../wfc/client/wfc.uts";
import EventType from "../../wfc/client/wfcEvent.uts";
import FriendRequest from "../../wfc/model/friendRequest.uts";
import Config from "../../config.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "FriendRequestListView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())
const isActive = ref<boolean>(false)

const friendRequestList = computed<FriendRequest[]>((): FriendRequest[] => {
    return contactState.friendRequestList
})

const portraitOf = (friendRequest: FriendRequest): string => {
    const target = friendRequest._target
    const portrait = target != null ? target.portrait : ''
    return portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
}

const displayNameOf = (friendRequest: FriendRequest): string => {
    const target = friendRequest._target
    return target != null ? target.displayName : ''
}

const reasonOf = (friendRequest: FriendRequest): string => {
    if (friendRequest.reason != '') {
        return friendRequest.reason
    }
    return '我是' + displayNameOf(friendRequest)
}

const showFriendRequest = (friendRequest: FriendRequest) => {
    store.setCurrentFriendRequest(friendRequest);
    uni.navigateTo({
        url: '/pages/contact/FriendRequestDetailPage',
        fail: (err) => {
            console.log('nav to FriendRequestDetailPage err', err);
        }
    } as NavigateToOptions);
}

const accept = (friendRequest: FriendRequest) => {
    wfc.handleFriendRequest(friendRequest.target, true, "", () => {
        friendRequest.status = 1;
    }, (err: number) => {
        uni.showToast({
            title: '添加好友失败 ' + err,
            icon: 'none',
        } as ShowToastOptions);
        console.log('accept friend request error', err)
    })
}

const onFriendRequestUpdate = (_args: Array<any | null>) => {
    if (isActive.value) {
        wfc.clearUnreadFriendRequestStatus();
    }
}

onMounted(() => {
    isActive.value = true;
    wfc.clearUnreadFriendRequestStatus();
    wfc.eventEmitter.on(EventType.FriendRequestUpdate, onFriendRequestUpdate);
})

onBeforeUnmount(() => {
    isActive.value = false;
    wfc.eventEmitter.off(EventType.FriendRequestUpdate, onFriendRequestUpdate);
})
</script>

<style scoped>
.new-friend-item-container {
    padding-left: 10px;
}

.avatar {
    width: 40px;
    height: 40px;
    border-radius: 3px;
}

.new-friend-item {
    display: flex;
    flex-direction: row;
    width: 100%;
    padding: 10px 10px 10px 0;
    align-items: center;
    position: relative;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.info {
    margin-left: 10px;
    flex: 1;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.name {
    flex: 1;
}

.request-name {
    font-size: 13px;
}

.accept {
    text-align: center;
    border-width: 1px;
    border-style: solid;
}

.status {
    font-size: 13px;
}

.reason {
    font-size: 12px;
}
</style>
