<template>
    <list-item v-for="(organization, index) in rootOrganizations" :key="index" @tap="showOrganization(organization)">
        <view class="organization-item" :style="{ backgroundColor: c.sectionGap }">
            <image class="avatar" :src="portraitOf(organization)" :style="{ backgroundColor: c.inputBg }" />
            <text class="org-name single-line" :class="fs14" :style="{ color: c.textPrimary }">{{ organization.getString('name') ?? '' }}</text>
        </view>
    </list-item>
</template>

<script setup lang="uts">
import store from "../../store.uts";
import organizationServerApi from "../../api/organizationServerApi.uts";
import Config from "../../config.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontClass } from "@/common/layoutScale.uts";
defineOptions({
    name: "OrganizationListView",
    styleIsolation: 'app'
})


const c = computed<AppColors>((): AppColors => colors())

// list-item 内部字号只能切静态 class，不能走 :style，见 common/layoutScale.uts
const fs14 = computed<string>((): string => fontClass(14))
const rootOrganizations = ref<UTSJSONObject[]>([] as UTSJSONObject[])

onMounted(() => {
    organizationServerApi.getRootOrganization()
        .then((orgs): void => {
            if (orgs != null && orgs instanceof Array) {
                const list: UTSJSONObject[] = []
                const arr = orgs as Array<any>
                for (let i = 0; i < arr.length; i++) {
                    const o = arr[i]
                    if (o instanceof UTSJSONObject) {
                        list.push(o as UTSJSONObject)
                    }
                }
                rootOrganizations.value = list;
            }
        }).catch((reason): void => {
            console.log('getRootOrganization fail')
        })
})

const portraitOf = (organization: UTSJSONObject): string => {
    const portrait = organization.getString('portrait')
    return portrait != null && portrait != '' ? portrait : Config.DEFAULT_ORGANIZATION_PORTRAIT_URL
}

const showOrganization = (organization: UTSJSONObject) => {
    store.setCurrentOrganization(organization)
    uni.navigateTo({
        url: '/pages/contact/OrganizationPage',
        fail: (err) => {
            console.log('nav to OrganizationPage err', err);
        }
    } as NavigateToOptions)
}
</script>

<style scoped>
.avatar {
    width: 40px;
    height: 40px;
    border-radius: 3px;
}

.organization-item {
    height: 50px;
    padding: 5px 10px 5px 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.org-name {
    margin-left: 10px;
}
</style>
