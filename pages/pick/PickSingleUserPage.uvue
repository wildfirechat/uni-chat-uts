<template>
    <view class="pick-single-user-container" :style="{ backgroundColor: c.bottomBarBg }">
        <view class="input-container">
            <input class="search-input" type="text" placeholder="搜索" v-model="filterQuery"
                :style="{ borderColor: c.hairlineSoft, backgroundColor: c.surface, color: c.textPrimary }" />
        </view>
        <list-view class="user-list-container" direction="vertical">
            <UserListView :users="filteredUsers" :show-category-label="showCategoryLabel && filterQuery == ''"
                :emit-click-event="true" @userClick="onClickUser" padding-left="20px" />
        </list-view>
    </view>
</template>

<script setup lang="uts">
import store from "@/store.uts";
import UserListView from "../user/UserListView.uvue";
import UserInfo from "@/wfc/model/userInfo.uts";
import { currentPickUserOptions, notifyPickedUser } from "@/common/picker.uts";

import { colors, AppColors } from "@/common/theme.uts";
defineOptions({
    name: "PickSingleUserPage"
})


const c = computed<AppColors>((): AppColors => colors())
const filterQuery = ref<string>('')
const users = ref<UserInfo[]>([] as UserInfo[])
const showCategoryLabel = ref<boolean>(true)

const filteredUsers = computed<UserInfo[]>((): UserInfo[] => {
    if (filterQuery.value != '') {
        return store.filterUsers(users.value, filterQuery.value);
    } else {
        return users.value;
    }
})

onLoad((_options: OnLoadOptions) => {
    console.log('PickSingleUserPage onLoad')
    const options = currentPickUserOptions()
    if (options != null) {
        users.value = options.users;
        showCategoryLabel.value = options.showCategoryLabel;
    }
})

const onClickUser = (user: UserInfo) => {
    console.log('onClick user', user.uid)
    uni.navigateBack({} as NavigateBackOptions);
    notifyPickedUser(user);
}
</script>

<style scoped>
.pick-single-user-container {
    display: flex;
    flex-direction: column;
    flex: 1;
    width: 100%;
}

.input-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.search-input {
    height: 25px;
    margin: 15px 20px 0 15px;
    flex: 1;
    border-radius: 3px;
    border-width: 1px;
    border-style: solid;
    padding-left: 10px;
}

.user-list-container {
    flex: 1;
    margin-top: 10px;
}
</style>
