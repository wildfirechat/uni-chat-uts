<template>
    <view class="pick-contact-container" :style="{ backgroundColor: c.bottomBarBg }">
        <view class="contact-list-container">
            <view class="input-container">
                <input class="search-input" type="text" placeholder="搜索" v-model="filterQuery"
                    :style="{ borderColor: c.hairlineSoft, backgroundColor: c.surface, color: c.textPrimary }" />
            </view>
            <list-view class="friend-list-container" direction="vertical">
                <CheckableUserListView :users="filteredUsers" :initial-checked-users="initialCheckedUsers"
                    :uncheckable-users="uncheckableUsers" :show-category-label="showCategoryLabel && filterQuery == ''"
                    padding-left="20px" />
            </list-view>
        </view>
        <view class="checked-contact-list-container"
            :style="{ backgroundColor: c.surface, borderTopColor: c.hairlineSoft }">
            <view class="panel-header">
                <text class="panel-desc" :style="{ fontSize: fontPx(13), color: c.textSecondary }" v-if="checkedUsers.length == 0">已选择联系人</text>
                <text class="panel-desc" :style="{ fontSize: fontPx(13), color: c.textSecondary }" v-else>已选择联系人 {{ checkedUsers.length }}</text>
                <button size="mini" :disabled="checkedUsers.length == 0" @tap="confirm">{{ confirmTitle }}</button>
            </view>
            <scroll-view class="picked-content" direction="horizontal">
                <view class="picked-user" v-for="(user, index) in checkedUsers" :key="index" @tap="unpick(user)">
                    <image class="avatar" :src="user.portrait" :style="{ backgroundColor: c.inputBg }" />
                    <text class="name single-line" :style="{ fontSize: fontPx(12), color: c.textPrimary }">{{ user.displayName }}</text>
                </view>
            </scroll-view>
        </view>
    </view>
</template>

<script setup lang="uts">
import store, { pickState } from "@/store.uts";
import CheckableUserListView from "@/pages/user/CheckableUserListView.uvue";
import UserInfo from "@/wfc/model/userInfo.uts";
import { currentPickUsersOptions, notifyPickedUsers } from "@/common/picker.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";
defineOptions({
    name: "PickUserPage"
})


const c = computed<AppColors>((): AppColors => colors())
const users = ref<UserInfo[]>([] as UserInfo[])
const initialCheckedUsers = ref<UserInfo[]>([] as UserInfo[])
const uncheckableUsers = ref<UserInfo[]>([] as UserInfo[])
const confirmTitle = ref<string>('确定')
const showCategoryLabel = ref<boolean>(true)
const filterQuery = ref<string>('')
const confirmed = ref<boolean>(false)

const checkedUsers = computed<UserInfo[]>((): UserInfo[] => {
    const users = pickState.users;
    if (initialCheckedUsers.value.length == 0) {
        return users;
    }
    return users.filter((u: UserInfo): boolean => {
        return initialCheckedUsers.value.findIndex((iu: UserInfo): boolean => iu.uid == u.uid) == -1
    })
})

const filteredUsers = computed<UserInfo[]>((): UserInfo[] => {
    if (filterQuery.value != '') {
        return store.filterUsers(users.value, filterQuery.value);
    } else {
        return users.value;
    }
})

onLoad((_options: OnLoadOptions) => {
    console.log('PickUserPage onLoad')
    const options = currentPickUsersOptions()
    if (options != null) {
        users.value = options.users;
        initialCheckedUsers.value = options.initialCheckedUsers;
        uncheckableUsers.value = options.uncheckableUsers;
        showCategoryLabel.value = options.showCategoryLabel;
        confirmTitle.value = options.confirmTitle;
    }
})

onUnload(() => {
    pickState.users = []
})

const unpick = (user: UserInfo) => {
    if (isUserUncheckable(user)) {
        return;
    }
    store.pickOrUnpickUser(user);
}

const isUserUncheckable = (user: UserInfo): boolean => {
    return uncheckableUsers.value.findIndex((u: UserInfo): boolean => u.uid == user.uid) >= 0;
}

/**
 * 不包含默认选中的用户
 */
const confirm = () => {
    let pickedUsers: UserInfo[]
    if (initialCheckedUsers.value.length > 0) {
        pickedUsers = pickState.users.filter((u: UserInfo): boolean => initialCheckedUsers.value.findIndex((iu: UserInfo): boolean => iu.uid == u.uid) == -1);
    } else {
        pickedUsers = pickState.users;
    }
    const users = pickedUsers.slice(0);
    pickState.users = []
    confirmed.value = true

    uni.navigateBack({} as NavigateBackOptions);
    notifyPickedUsers(users);
}
</script>

<style scoped>
.pick-contact-container {
    display: flex;
    flex-direction: column;
    position: relative;
    flex: 1;
    width: 100%;
    overflow: hidden;
}

.contact-list-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    overflow: hidden;
}

.input-container {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.search-input {
    height: 25px;
    margin: 15px 20px 0 15px;
    flex: 1;
    border-radius: 3px;
    border-width: 1px;
    border-style: solid;
    padding-left: 10px;
}

.friend-list-container {
    flex: 1;
    margin-top: 10px;
}

.checked-contact-list-container {
    display: flex;
    height: 150px;
    flex-direction: column;
    border-top-width: 1px;
    border-top-style: solid;
}

.panel-header {
    height: 45px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}

.picked-content {
    flex: 1;
    display: flex;
    flex-direction: row;
    padding: 0 20px;
}

.picked-user {
    width: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5px;
}

.avatar {
    width: 45px;
    height: 45px;
    border-radius: 3px;
}

.name {
    width: 100%;
    text-align: center;
}
</style>
