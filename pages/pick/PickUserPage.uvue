    display: flex;
    flex-direction: column;
    position: relative;
    flex: 1;
    width: 100%;
    overflow: hidden;
}

.contact-list-container {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    background-color: #f7f7f7;
    overflow: hidden;
}

.input-container {
    position: relative;
    display: flex;
    flex-direction: row;
    align-items: center;
    width: 100%;
}

.search-input {
    height: 25px;
    margin: 15px 20px 0 15px;
    flex: 1;
    border-radius: 3px;
    border: 1px solid #ededed;
    background-color: #ffffff;
    padding-left: 10px;
}

.friend-list-container {
    flex: 1;
    margin-top: 10px;
}

.checked-contact-list-container {
    display: flex;
    height: 150px;
    flex-direction: column;
    background-color: #ffffff;
    border-top: 1px solid #ececec;
}

.panel-header {
    height: 45px;
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 0 20px;
}

.panel-desc {
    font-size: 13px;
}

.picked-content {
    flex: 1;
    display: flex;
    flex-direction: row;
    padding: 0 20px;
}

.picked-user {
    width: 60px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: 5px;
}

.avatar {
    width: 45px;
    height: 45px;
    background-color: #d6d6d6;
    border-radius: 3px;
}

.name {
    width: 100%;
    font-size: 12px;
    text-align: center;
}
</style>
