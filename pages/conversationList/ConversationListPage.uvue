<template>
    <view class="page-container" :style="{ backgroundColor: c.primaryBackground }">
        <NavBar title="野火" :rightIcon1="searchIcon" :rightIcon2="plusIcon" @right1Tap="onSearchTap" @right2Tap="onPlusTap" />
        <text v-if="connectionStatusDesc != ''" class="connection-status"
            :style="{ color: c.textSecondary, fontSize: fontPx(13) }">{{ connectionStatusDesc }}</text>
        <!-- 「PC 已登录」横幅，对齐 flutter home/conversation_list_widget.dart 的 StatusNotificationHeader -->
        <view v-if="pcOnlineDesc != ''" class="pc-online-banner"
            :style="{ backgroundColor: c.conversationBg }" @tap="showPcOnlineDevices">
            <text class="pc-online-text" :style="{ color: c.textSecondary, fontSize: fontPx(13) }">{{ pcOnlineDesc }}</text>
            <text class="icomoon pc-online-arrow" :style="{ color: c.textSecondary }">&#xf3d3;</text>
        </view>
        <list-view class="conversation-list" direction="vertical">
            <list-item class="conversation-item"
                v-for="conversationInfo in conversationInfoList" :key="conversationInfoKey(conversationInfo)"
                @tap="showConversation(conversationInfo)"
                @longpress="showConversationContextMenu($event, conversationInfo)">
                <ConversationItemView :conversationInfo="conversationInfo" />
            </list-item>
        </list-view>

        <chunLei-popups v-model="showContextMenu" :popData="contextMenuItems" @tapPopup="onContextMenuItemSelect"
            :x="contextMenuX" :y="contextMenuY" direction="column" theme="dark" :triangle="false" :dynamic="true" />
        <main-action-menu ref="mainActionMenu"></main-action-menu>
    </view>
</template>

<script setup lang="uts">
import ConversationItemView from "./ConversationItemView.uvue";
import NavBar from "../common/NavBar.uvue";
import store, { conversationState, miscState } from "../../store.uts";
import wfc from "../../wfc/client/wfc.uts";
import ConnectionStatus from "../../wfc/client/connectionStatus.uts";
import ConversationInfo from "../../wfc/model/conversationInfo.uts";
import { getItem } from "../util/storageHelper.uts";
import organizationServerApi from "../../api/organizationServerApi.uts";
import { go2ConversationPage } from "../../common/nav.uts";
import { getTouchPoint } from "../../common/touch.uts";
import { PopupMenuItem } from "../../common/popupMenu.uts";
import PCOnlineType from "../../wfc/model/pcOnlineType.uts";
import { colors, AppColors } from "../../common/theme.uts";
import { fontPx } from "../../common/layoutScale.uts";
import { t, t1 } from "../../i18n/i18n.uts";

defineOptions({
    name: 'ConversationListPage'
})

const c = computed<AppColors>((): AppColors => colors())

// wx_iconfont.ttf 中的图标：搜索、加号（与原 titleNView buttons 一致）
const searchIcon = ref<string>('\ue636')
const plusIcon = ref<string>('\ue657')
const showContextMenu = ref<boolean>(false)
const contextMenuX = ref<number>(0)
const contextMenuY = ref<number>(0)
const contextMenuItems = ref<PopupMenuItem[]>([] as PopupMenuItem[])
const contextMenuConversationInfo = ref<ConversationInfo | null>(null)
const orgLoginTried = ref<boolean>(false)

const mainActionMenu = ref<ComponentPublicInstance | null>(null)

const conversationInfoList = computed<ConversationInfo[]>((): ConversationInfo[] => {
    return conversationState.conversationInfoList
})

const connectionStatus = computed<number>((): number => {
    return miscState.connectionStatus
})

const connectionStatusDesc = computed<string>((): string => {
    let desc = '';
    switch (miscState.connectionStatus) {
        case ConnectionStatus.ConnectionStatusConnecting:
            desc = '正在连接...';
            break;
        case ConnectionStatus.ConnectionStatusReceiveing:
            desc = '正在同步...';
            break;
        case ConnectionStatus.ConnectionStatusConnected:
            desc = '';
            break;
        case ConnectionStatus.ConnectionStatusUnconnected:
            desc = '连接失败';
            break;
        default:
            break;
    }
    return desc;
})

/**
 * 「PC 已登录」横幅文案。只在已连接且确实有其他端在线时才出现；
 * 多端在线时按类型去重后用 `/` 连起来（与 flutter 的 `.toSet().join('/')` 一致）。
 */
const pcOnlineDesc = computed<string>((): string => {
    if (miscState.connectionStatus != ConnectionStatus.ConnectionStatusConnected) {
        return ''
    }
    const infos = miscState.pcOnlineInfos
    if (infos.length == 0) {
        return ''
    }
    const names: string[] = []
    for (let i = 0; i < infos.length; i++) {
        let name = t('pc.pc_client')
        if (infos[i].type == PCOnlineType.Web_Online) {
            name = t('pc.web_client')
        } else if (infos[i].type == PCOnlineType.WX_Online) {
            name = t('pc.mini_program')
        } else if (infos[i].type == PCOnlineType.Pad_Online) {
            name = t('pc.pad_client')
        }
        if (names.indexOf(name) < 0) {
            names.push(name)
        }
    }
    return t1('pc.logged_in', names.join('/'))
})

const showPcOnlineDevices = () => {
    uni.navigateTo({
        url: '/pages/me/PcOnlineDevicesPage',
        fail: (err) => {
            console.log('nav to PcOnlineDevicesPage err', err)
        }
    } as NavigateToOptions)
}

const unread = computed<number>((): number => {
    let count = 0;
    const list = conversationState.conversationInfoList
    for (let i = 0; i < list.length; i++) {
        const info = list[i]
        if (info.isSilent) {
            continue;
        }
        count += info.unreadCount.unread;
    }
    return count;
})

const updateTabBarBadge = () => {
    const newValue = unread.value;
    if (newValue > 0) {
        uni.setTabBarBadge({
            index: 0,
            text: newValue > 99 ? '99+' : '' + newValue
        } as SetTabBarBadgeOptions)
    } else {
        uni.removeTabBarBadge({
            index: 0
        } as RemoveTabBarBadgeOptions)
    }
}

watch(connectionStatus, (newValue: number, _oldValue: number) => {
    if (newValue == ConnectionStatus.ConnectionStatusConnected && !orgLoginTried.value) {
        orgLoginTried.value = true
        organizationServerApi.login()
            .then((r): void => {
                console.log('org login success')
            })
            .catch((reason): void => {
                console.log('org login fail')
            });
    }
}, { immediate: true })

watch(unread, (newValue: number, _oldValue: number) => {
    updateTabBarBadge();
})

onShow(() => {
    console.log('conversationList onShow', conversationState.conversationInfoList.length)
    const userId = getItem('userId');
    if (userId == '') {
        // 被踢等，需要退到登录页面
        uni.reLaunch({
            url: '/pages/login/LoginPage'
        } as ReLaunchOptions);
    } else {
        updateTabBarBadge();
    }
})

onHide(() => {
    console.log('conversationList onHide');
    const menu = mainActionMenu.value
    if (menu != null) {
        (menu as ComponentPublicInstance).$callMethod('hide');
    }
})

const onPlusTap = () => {
    const menu = mainActionMenu.value
    if (menu != null) {
        (menu as ComponentPublicInstance).$callMethod('toggle');
    }
}

const onSearchTap = () => {
    const menu = mainActionMenu.value
    if (menu != null) {
        (menu as ComponentPublicInstance).$callMethod('hide');
    }
    uni.navigateTo({
        url: '/pages/search/SearchPortalPage'
    } as NavigateToOptions);
}

const showConversation = (conversationInfo: ConversationInfo) => {
    store.setCurrentConversationInfo(conversationInfo);
    go2ConversationPage();
}

const removeConversation = (conversationInfo: ConversationInfo) => {
    store.removeConversation(conversationInfo.conversation);
}

const conversationInfoKey = (conversationInfo: ConversationInfo): string => {
    const conv = conversationInfo.conversation;
    return conv.target + '-' + conv.type + '-' + conv.line;
}

const showConversationContextMenu = (e: any, conversationInfo: ConversationInfo) => {
    // longpress 事件 touches 可能为空，改用 changedTouches 兜底取触点坐标
    const point = getTouchPoint(e as UniTouchEvent);
    if (point != null) {
        contextMenuX.value = point.x;
        contextMenuY.value = point.y;
    }
    contextMenuConversationInfo.value = conversationInfo;
    const items: PopupMenuItem[] = [];

    items.push(new PopupMenuItem(conversationInfo.top > 0 ? '取消置顶' : '置顶', 'top'))
    items.push(new PopupMenuItem(conversationInfo.isSilent ? '取消静音' : '静音', 'silent'))
    items.push(new PopupMenuItem('删除会话', 'delete'))
    items.push(new PopupMenuItem(conversationInfo._unread == 0 ? '标记为未读' : '标记为已读', 'mark'))
    contextMenuItems.value = items;
    showContextMenu.value = true;
}

const onContextMenuItemSelect = (t: PopupMenuItem) => {
    const conversationInfo = contextMenuConversationInfo.value
    if (conversationInfo == null) {
        return
    }
    switch (t.tag) {
        case 'delete':
            store.removeConversation(conversationInfo.conversation);
            break;
        case 'top':
            store.setConversationTop(conversationInfo.conversation, conversationInfo.top > 0 ? 0 : 1);
            break;
        case 'silent':
            store.setConversationSilent(conversationInfo.conversation, !conversationInfo.isSilent);
            break;
        case 'mark':
            if (conversationInfo._unread == 0) {
                wfc.markConversationAsUnread(conversationInfo.conversation, true);
            } else {
                wfc.clearConversationUnreadStatus(conversationInfo.conversation);
            }
            break;
        default:
            uni.showToast({
                title: 'TODO ' + t.title,
                icon: 'none'
            } as ShowToastOptions)
            break;
    }
}
</script>

<style scoped>
.page-container {
    flex: 1;
    display: flex;
    flex-direction: column;
}

.connection-status {
    text-align: center;
    padding: 5px 0;
}

/* 组件/页面各自声明一遍图标字体：字体本身是 App.uvue loadFontFace 全局加载的，
 * 被样式隔离挡住的只是 class 本身 */
.icomoon {
    font-family: "icomoon";
}

.pc-online-banner {
    width: 100%;
    height: 40px;
    padding: 0 16px;
    display: flex;
    flex-direction: row;
    align-items: center;
}

.pc-online-text {
    flex: 1;
}

.pc-online-arrow {
    font-size: 16px;
    flex-shrink: 0;
}

.conversation-list {
    flex: 1;
}

/* 底色/置顶色/分隔线都挪到了 ConversationItemView 的根节点，
 * list-item 走复用渲染，这里一个动态绑定都不留。 */
.conversation-item {
    position: relative;
}
</style>
