<template>
    <view class="conversation-item-container"
        :style="{ backgroundColor: conversationInfo.top > 0 ? c.cellTop : c.surface, borderBottomColor: c.hairlineSoft }">
        <!-- 按下态挂在这层而不是外面那层：外层有自己的底色（置顶是 cellTop），
             而 hover-class 的半透明值是替换 background-color、透出**父节点**的底色，
             挂在有底色的那层上会把置顶色按没了。左内边距也一并挪到这层，
             否则按下态盖不到最左边 10px。 -->
        <view class="conversation-item" :hover-class="pressedClass" hover-stay-time="80">
            <view class="header">
                <image class="avatar" :src="portrait" mode="aspectFill" :style="{ backgroundColor: c.inputBg }" />
                <text v-if="unread > 0" class="badge" :class="{ silent: conversationInfo.isSilent }"
                    :style="{ color: c.onAccent, backgroundColor: c.badge }">{{ unread > 99 ? '99' : '' + unread }}</text>
            </view>
            <view class="content-container">
                <view class="title-time-container">
                    <text class="title single-line" :class="fs14" :style="{ color: c.textPrimary }">{{ conversationTitle }}</text>
                    <text class="time" :class="fs10" :style="{ color: c.textSecondary }">{{ conversationInfo._timeStr }}</text>
                </view>
                <view class="content">
                    <text class="draft single-line" :class="fs13" v-if="shouldShowDraft" :style="{ color: c.textPrimary }"><text
                            class="draft-label" :class="fs13" :style="{ color: c.danger }">[草稿]</text>{{ draft }}</text>
                    <text v-if="unreadMention > 0" class="mention" :class="fs13" :style="{ color: c.danger }">[有人@我]</text>
                    <text v-if="!shouldShowDraft" class="last-message-desc single-line" :class="fs13"
                        :style="{ color: c.textTertiary }">{{ lastMessageContent }}</text>
                    <text v-if="conversationInfo.isSilent" class="icomoon silent-icon"
                        :style="{ color: c.textTertiary }">&#xf39a;</text>
                </view>
            </view>
        </view>
    </view>
</template>

<script setup lang="uts">
import ConversationInfo from "../../wfc/model/conversationInfo.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import { ConversationTarget } from "../../wfc/model/conversation.uts";
import store, { conversationState } from "../../store.uts";
import Draft from "../util/draft.uts";
import NotificationMessageContent from "../../wfc/messages/notification/notificationMessageContent.uts";
import Config from "../../config.uts";
import { colors, AppColors, pressedRowClass } from "../../common/theme.uts";
import { fontClass } from "../../common/layoutScale.uts";

defineOptions({
    name: "ConversationItemView",
    // 'app' 不只是为了 global.css 的 single-line，下面的 fs-* 档位类也在那里
    styleIsolation: 'app'
})

// 本组件在 list-view 里，走的是鸿蒙 vapor 的**复用（recycle）渲染路径**。
// 规矩（踩过一次坑）：只有颜色走 :style，**尺寸一律留在下面的 class 里**。
// 上次把 height/font-size 挪进 :style，鸿蒙上整行塌成 0 高——有滚动条、看不到 item、点不动。
// 字号要跟设置里的档位走，所以改成切静态 class（global.css 的 .fs-<基准>-<档位>），
// 和置顶态用 :class 切类是同一个套路，不碰 :style。
const c = computed<AppColors>((): AppColors => colors())
const pressedClass = computed<string>((): string => pressedRowClass())

// 行高 70px 不跟着放大：最大档下 20.3 + 18.85 = 39.15px，仍在 50px 的文字区里放得下，
// 而给复用渲染的 item 改高度风险远大于收益。
const fs14 = computed<string>((): string => fontClass(14))
const fs13 = computed<string>((): string => fontClass(13))
const fs10 = computed<string>((): string => fontClass(10))

const props = defineProps<{
    conversationInfo: ConversationInfo
}>()

// target（头像/名称）在展示时才按需解析：本地没有还会发远程拉取，
// 会话很多（2000+ 群）时不能在加载会话列表时批量做，见 store._loadConversationList。
// store 内部按 conversation._target 缓存，重复调用是廉价的。
const conversationTarget = computed<ConversationTarget | null>((): ConversationTarget | null => {
    return store.ensureConversationTarget(props.conversationInfo.conversation);
})

const portrait = computed<string>((): string => {
    const target = conversationTarget.value
    const portrait = target != null ? target.portrait : ''
    return portrait != '' ? portrait : Config.DEFAULT_PORTRAIT_URL
})

const conversationTitle = computed<string>((): string => {
    const info = props.conversationInfo;
    const target = conversationTarget.value
    if (target == null) {
        return ''
    }
    if (info.conversation.type == ConversationType.Single) {
        return target._displayName;
    } else {
        return target.name;
    }
})

const shouldShowDraft = computed<boolean>((): boolean => {
    const currentConversationInfo = conversationState.currentConversationInfo
    if (currentConversationInfo != null && currentConversationInfo.conversation.equal(props.conversationInfo.conversation)) {
        return false;
    }
    if (props.conversationInfo.unreadCount.unreadMention + props.conversationInfo.unreadCount.unreadMentionAll > 0) {
        return false;
    }
    const draft = Draft.getConversationDraftEx(props.conversationInfo);
    return draft.text.trim() != '' || draft.quotedMessage != null;
})

const draft = computed<string>((): string => {
    const draft = Draft.getConversationDraftEx(props.conversationInfo);
    let draftText = draft.text;
    draftText = draftText.replace(/<img [:a-zA-Z0-9_+; ,\-=\/."]+>/g, '[图片]')
    draftText = draftText.replace(/&nbsp;/g, ' ');
    draftText = draftText.replace(/<br>/g, '')
    if (draft.quotedMessage != null) {
        draftText += '...'
    }
    return draftText;
})

const lastMessageContent = computed<string>((): string => {
    const conversationInfo = props.conversationInfo;
    const lastMessage = conversationInfo.lastMessage
    if (lastMessage != null) {
        let senderName = '';
        if (conversationInfo.conversation.type == ConversationType.Group && lastMessage.direction == 1
            && !(lastMessage.messageContent instanceof NotificationMessageContent)) {
            let from = lastMessage._from
            if (from == null) {
                store._patchMessage(lastMessage, 0)
                from = lastMessage._from
            }
            if (from != null) {
                senderName = from._displayName + ': ';
            } else {
                senderName = '<' + lastMessage.from + '>: ';
            }
        }
        return senderName + lastMessage.messageContent.digest(lastMessage);
    } else {
        return '';
    }
})

const unread = computed<number>((): number => {
    const unreadCount = props.conversationInfo.unreadCount;
    return unreadCount.unread + unreadCount.unreadMention + unreadCount.unreadMentionAll;
})

const unreadMention = computed<number>((): number => {
    const unreadCount = props.conversationInfo.unreadCount;
    return unreadCount.unreadMention + unreadCount.unreadMentionAll;
})
</script>

<style scoped>
/* 行的底色、置顶底色、分隔线都画在这里（组件根节点），而不是外面那个 list-item：
 * list-item 走复用渲染，尽量不给它任何动态绑定。 */
.conversation-item-container {
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.conversation-item {
    width: 100%;
    height: 70px;
    padding-left: 10px;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
}

.header {
    height: 70px;
    padding: 10px 10px 10px 0;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
}

.avatar {
    width: 45px;
    height: 45px;
    border-radius: 3px;
}

.badge {
    position: absolute;
    font-size: 10px;
    border-radius: 8px;
    width: 16px;
    height: 16px;
    line-height: 16px;
    text-align: center;
    right: 2px;
    top: 6px;
}

.badge.silent {
    width: 8px;
    height: 8px;
    font-size: 0;
    line-height: 8px;
}

.content-container {
    flex: 1;
    height: 50px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-around;
    padding-right: 12px;
}

.title-time-container {
    display: flex;
    flex-direction: row;
    width: 100%;
    justify-content: space-between;
}

/* 下面这几个类不写 font-size：字号由模板上的 .fs-<基准>-<档位> 提供（global.css）。
 * 两边都写会变成两条同权重规则，谁生效取决于声明顺序，别加回来。
 * .badge 和 .silent-icon 例外——角标数字和静音图标是图形，按约定不跟字号档位放大。 */
.title {
    padding-right: 10px;
    flex: 1;
}

.time {
    flex-shrink: 0;
}

.content {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
}

.draft {
    flex: 1;
}

.draft-label {
    padding-right: 5px;
}

.mention {
    flex-shrink: 0;
}

.last-message-desc {
    flex: 1;
}

.silent-icon {
    font-size: 14px;
}
</style>
