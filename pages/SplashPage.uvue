<template>
    <view class="splash-container" :style="{ backgroundColor: c.surface }"></view>
</template>

<script setup lang="uts">
import { getItem } from "./util/storageHelper.uts";
import wfc from "../wfc/client/wfc.uts";
import { colors, AppColors } from "../common/theme.uts";

const c = computed<AppColors>((): AppColors => colors())

onLoad(() => {
    const userId = getItem('userId');
    const token = getItem('token')
    if (token != '') {
        wfc.connect(userId, token);
        go2ConversationList();
    } else {
        uni.redirectTo({
            url: '/pages/login/LoginPage',
        } as RedirectToOptions)
    }
})

const go2ConversationList = () => {
    uni.switchTab({
        url: '/pages/conversationList/ConversationListPage',
        success: (_) => {
            console.log('to conversation list success');
        },
        fail: (e) => {
            console.log('to conversation list error', e);
        },
        complete: (_) => {
            console.log('switch tab complete')
        }
    } as SwitchTabOptions);
}
</script>

<style scoped>
.splash-container {
    flex: 1;
}
</style>
