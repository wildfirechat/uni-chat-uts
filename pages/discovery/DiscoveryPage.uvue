<template>
    <view class="discovery-container" :style="{ backgroundColor: c.primaryBackground }">
        <section-divider />
        <form-card v-if="supportMoments">
            <option-item :title="t('moment.entry')" left-image="/static/image/icon/ic_moment.png"
                :desc="momentUnreadDesc" :show-bottom-divider="false" @tap="showMoments" />
        </form-card>
        <section-divider v-if="supportMoments" />
        <form-card>
            <option-item :title="t('discovery.chatroom')" left-image="/static/image/icon/ic_chatroom.png"
                @tap="showChatroomList" />
            <!-- 会议入口只在集成了高级版（会议版）音视频 SDK 时出现，见 README-AV.md -->
            <option-item v-if="supportConference" :title="t('discovery.conference')"
                left-image="/static/image/av/ic_conference.png" @tap="showConferencePortal" />
            <option-item :title="t('discovery.robot')" left-image="/static/image/icon/ic_robot.png"
                :show-bottom-divider="false" @tap="showRobotConversation" />
        </form-card>

        <section-divider />

        <form-card>
            <option-item :title="t('discovery.channel')" left-image="/static/image/icon/ic_channel.png"
                @tap="showChannelList" />
            <option-item :title="t('discovery.dev_guide')" left-image="/static/image/icon/ic_dev_docs.png"
                :show-bottom-divider="false" @tap="showDevGuide" />
        </form-card>
    </view>
</template>

<script setup lang="uts">
import store from "../../store.uts";
import momentClient from "../../wfc/moment/momentClient.uts";
import MomentCommentMessageContent from "../../wfc/moment/momentCommentMessageContent.uts";
import MomentFeedMessageContent from "../../wfc/moment/momentFeedMessageContent.uts";
import Conversation from "../../wfc/model/conversation.uts";
import ConversationType from "../../wfc/model/conversationType.uts";
import avEngineKit from "../../wfc/av/engine/avEngineKit.uts";
import Config from "../../config.uts";
import { go2ConversationPage } from "../../common/nav.uts";
import { colors, AppColors } from "../../common/theme.uts";
import { t } from "../../i18n/i18n.uts";

const c = computed<AppColors>((): AppColors => colors())

// 会议依赖会议版音视频 SDK（替换 avenginekit.aar/har/xcframework 切换），多人版下不显示入口
const supportConference = computed<boolean>((): boolean => {
    return Config.ENABLE_VOIP && avEngineKit.isSupportConference()
})

const showConferencePortal = () => {
    uni.navigateTo({
        url: '/pages/voip/conference/ConferencePortalPage',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}

// 朋友圈：对齐 flutter `Config.ENABLE_MOMENTS`，关掉时整行不出现
const supportMoments = Config.ENABLE_MOMENTS

// 朋友圈未读数（红点），从 line=1 的单聊会话里取
const momentUnread = ref<number>(0)
const momentUnreadDesc = computed<string>((): string => momentUnread.value > 0 ? ('' + momentUnread.value) : '')

onLoad((_options: OnLoadOptions) => {
    if (!supportMoments) {
        return
    }
    // 挂上朋友圈消息监听，停在发现页时收到评论/@提醒红点也会跟着变
    // （init 可重复调用，只会挂一次监听）
    momentClient.init((_: MomentCommentMessageContent) => {
        momentUnread.value = momentClient.getUnreadCount()
    }, (_: MomentFeedMessageContent) => {
        momentUnread.value = momentClient.getUnreadCount()
    })
})

onShow(() => {
    if (supportMoments) {
        momentUnread.value = momentClient.getUnreadCount()
    }
})

const showMoments = () => {
    uni.navigateTo({
        url: '/pages/moment/MomentFeedListPage',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}

const showChatroomList = () => {
    uni.navigateTo({
        url: '/pages/discovery/ChatroomListPage',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}

const showRobotConversation = () => {
    const conversation = new Conversation(ConversationType.Single, "FireRobot", 0);
    store.setCurrentConversation(conversation);
    go2ConversationPage();
}

const showChannelList = () => {
    uni.navigateTo({
        url: '/pages/contact/ChannelListPage',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}

const showDevGuide = () => {
    uni.navigateTo({
        url: '/pages/misc/WebViewPage?url=https://docs.wildfirechat.cn/',
        fail: (e) => {
            console.log(e)
        }
    } as NavigateToOptions);
}
</script>

<style scoped>
/* 行的样式全在 option-item / form-card 里，这里只剩页面容器 */
.discovery-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    flex: 1;
    overflow: hidden;
}
</style>
