<template>
    <view class="page-body" :style="{ backgroundColor: c.surface }">
        <text class="login-type-title" :style="{ fontSize: fontPx(24), color: c.textPrimary }">验证码登录</text>
        <view class="mobile-container">
            <text class="input-label" :style="{ fontSize: fontPx(16), color: c.textPrimary }">请输入手机号</text>
            <view class="mobile-input-container">
                <input class="input" @input="bindPhoneInput" type="number" placeholder="手机号"
                    :style="{ fontSize: fontPx(14), color: c.textPrimary, borderBottomColor: c.hairline }" />
            </view>
        </view>

        <view class="auth-code-container">
            <text class="input-label" :style="{ fontSize: fontPx(16), color: c.textPrimary }">请输入验证码</text>
            <view class="auth-code-input-container">
                <input class="auth-code-input" @input="bindCodeInput" type="number" placeholder="验证码"
                    :style="{ fontSize: fontPx(14), color: c.textPrimary, borderBottomColor: c.hairline }" />
                <button size="mini" :disabled="phone.length != 11" @tap="bindAuthCodeTap">获取验证码</button>
            </view>
        </view>

        <button :disabled="!(phone.length > 0 && code.length > 0)" class="confirm-button" @tap="bindLoginTap">登录</button>
    </view>
</template>

<script setup lang="uts">
import wfc from "../../wfc/client/wfc.uts";
import Config from '../../config.uts';
import { setItem } from "../util/storageHelper.uts";
import appServerApi, { LoginResult } from "../../api/appServerApi.uts";

import { colors, AppColors } from "@/common/theme.uts";
import { fontPx } from "@/common/layoutScale.uts";

const c = computed<AppColors>((): AppColors => colors())
const focus = ref<boolean>(false)
const phone = ref<string>('')
const code = ref<string>('')

onShow(() => {
    console.log('login onShow');
    if ((Config.APP_SERVER.indexOf('wildfirechat') >= 0 && Config.IM_SERVER_HOST.indexOf('wildfirechat') == -1)
        || (Config.APP_SERVER.indexOf('wildfirechat') == -1 && Config.IM_SERVER_HOST.indexOf('wildfirechat') >= 0)) {
        console.error('!!!! 严重错误!!!! Config.APP_SERVER 和 Config.IM_SERVER_HOST要一起修改，不能一个用官方服务，一个用自己部署的服务');
    } else if (Config.IM_SERVER_HOST.indexOf(':') >= 0) {
        console.error('!!!! 严重错误!!!! Config.IM_SERVER_HOST 不能包含端口，只需要 HOST 即可');
    } else if (Config.IM_SERVER_HOST.indexOf('http') >= 0) {
        console.error('!!!! 严重错误!!!! Config.IM_SERVER_HOST 不能包含http，只需要 HOST 即可');
    }
})

const go2ConversationList = () => {
    uni.switchTab({
        url: '/pages/conversationList/ConversationListPage',
        success: (_) => {
            console.log('to conversation list success');
        },
        fail: (e) => {
            console.log('to conversation list error', e);
        },
        complete: (_) => {
            console.log('switch tab complete')
        }
    } as SwitchTabOptions);
}

const login = (phone: string, code: string) => {
    console.log('login', wfc.getClientId(), Config.getWFCPlatform());
    appServerApi.loginWithAuthCode(phone, code)
        .then((result: LoginResult) => {
            console.log('login result', result.userId);
            const userId = result.userId;
            const token = result.token;
            wfc.connect(userId, token);
            setItem('userId', userId);
            setItem('token', token)

            go2ConversationList();
        })
        .catch((r) => {
            console.log('login failed', r)
            uni.showToast({
                title: '登录失败',
                icon: 'none',
            } as ShowToastOptions);
        });
}

const authCode = (phone: string) => {
    appServerApi.requestAuthCode(phone)
        .then((result) => {
            uni.showToast({
                title: '发送验证码成功',
                icon: 'none',
            } as ShowToastOptions);
        })
        .catch((reason) => {
            uni.showToast({
                title: '发送验证码失败',
                icon: 'none',
            } as ShowToastOptions);
        })
}

const bindPhoneInput = (e: UniInputEvent) => {
    phone.value = e.detail.value;
}

const bindCodeInput = (e: UniInputEvent) => {
    code.value = e.detail.value;
}

const bindLoginTap = () => {
    console.log(phone.value);
    login(phone.value, code.value);
}

const bindAuthCodeTap = () => {
    console.log(phone.value);
    authCode(phone.value);
}
</script>
<style>
.page-body {
    padding: 20rpx;
    flex: 1;
}

.login-type-title {
    margin-top: 120rpx;
    margin-bottom: 50rpx;
}

.mobile-container {
    margin-top: 20rpx;
}

.mobile-input-container {
    display: flex;
    flex-direction: column;
    justify-content: center;
    height: 40px;
}

.input {
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.auth-code-container {
    margin-top: 30rpx;
}

.auth-code-input-container {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    height: 40px;
}

.auth-code-input {
    flex: 1;
    margin-right: 5px;
    border-bottom-width: 1px;
    border-bottom-style: solid;
}

.confirm-button {
    margin-top: 40px;
}
</style>
