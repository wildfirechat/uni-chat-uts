/**
 * 纯 UTS 实现的 utf8 <-> base64 转换，替代原 base64.min.js + unescape/escape 方案。
 */

const B64_CHARS = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/'

function utf8Bytes(str: string): number[] {
    const bytes: number[] = []
    let i = 0
    while (i < str.length) {
        let code = str.charCodeAt(i) ?? 0
        // 处理代理对
        if (code >= 0xD800 && code <= 0xDBFF && i + 1 < str.length) {
            const low = str.charCodeAt(i + 1) ?? 0
            if (low >= 0xDC00 && low <= 0xDFFF) {
                code = (code - 0xD800) * 0x400 + (low - 0xDC00) + 0x10000
                i++
            }
        }
        if (code < 0x80) {
            bytes.push(code)
        } else if (code < 0x800) {
            bytes.push(0xC0 | (code >> 6))
            bytes.push(0x80 | (code & 0x3F))
        } else if (code < 0x10000) {
            bytes.push(0xE0 | (code >> 12))
            bytes.push(0x80 | ((code >> 6) & 0x3F))
            bytes.push(0x80 | (code & 0x3F))
        } else {
            bytes.push(0xF0 | (code >> 18))
            bytes.push(0x80 | ((code >> 12) & 0x3F))
            bytes.push(0x80 | ((code >> 6) & 0x3F))
            bytes.push(0x80 | (code & 0x3F))
        }
        i++
    }
    return bytes
}

function bytesToUtf8(bytes: number[]): string {
    let result = ''
    let i = 0
    while (i < bytes.length) {
        const b0 = bytes[i]
        let code = 0
        if (b0 < 0x80) {
            code = b0
            i += 1
        } else if ((b0 & 0xE0) == 0xC0 && i + 1 < bytes.length) {
            code = ((b0 & 0x1F) << 6) | (bytes[i + 1] & 0x3F)
            i += 2
        } else if ((b0 & 0xF0) == 0xE0 && i + 2 < bytes.length) {
            code = ((b0 & 0x0F) << 12) | ((bytes[i + 1] & 0x3F) << 6) | (bytes[i + 2] & 0x3F)
            i += 3
        } else if ((b0 & 0xF8) == 0xF0 && i + 3 < bytes.length) {
            code = ((b0 & 0x07) << 18) | ((bytes[i + 1] & 0x3F) << 12) | ((bytes[i + 2] & 0x3F) << 6) | (bytes[i + 3] & 0x3F)
            i += 4
        } else {
            // 非法字节，跳过
            i += 1
            continue
        }
        if (code >= 0x10000) {
            code -= 0x10000
            result += String.fromCharCode(0xD800 + (code >> 10))
            result += String.fromCharCode(0xDC00 + (code & 0x3FF))
        } else {
            result += String.fromCharCode(code)
        }
    }
    return result
}

function bytesToBase64(bytes: number[]): string {
    let result = ''
    let i = 0
    while (i + 2 < bytes.length) {
        const n = (bytes[i] << 16) | (bytes[i + 1] << 8) | bytes[i + 2]
        result += B64_CHARS.charAt((n >> 18) & 63)
        result += B64_CHARS.charAt((n >> 12) & 63)
        result += B64_CHARS.charAt((n >> 6) & 63)
        result += B64_CHARS.charAt(n & 63)
        i += 3
    }
    const remain = bytes.length - i
    if (remain == 1) {
        const n = bytes[i] << 16
        result += B64_CHARS.charAt((n >> 18) & 63)
        result += B64_CHARS.charAt((n >> 12) & 63)
        result += '=='
    } else if (remain == 2) {
        const n = (bytes[i] << 16) | (bytes[i + 1] << 8)
        result += B64_CHARS.charAt((n >> 18) & 63)
        result += B64_CHARS.charAt((n >> 12) & 63)
        result += B64_CHARS.charAt((n >> 6) & 63)
        result += '='
    }
    return result
}

function base64ToBytes(b64: string): number[] {
    const bytes: number[] = []
    let buffer = 0
    let bits = 0
    for (let i = 0; i < b64.length; i++) {
        const c = b64.charAt(i)
        if (c == '=' || c == '\n' || c == '\r') {
            continue
        }
        const index = B64_CHARS.indexOf(c)
        if (index < 0) {
            continue
        }
        buffer = (buffer << 6) | index
        bits += 6
        if (bits >= 8) {
            bits -= 8
            bytes.push((buffer >> bits) & 0xFF)
        }
    }
    return bytes
}

/**
 * utf8 字符串转 base64
 */
export function utf8_to_b64(str: string): string {
    return bytesToBase64(utf8Bytes(str))
}

/**
 * base64 转 utf8 字符串
 */
export function b64_to_utf8(b64: string): string {
    return bytesToUtf8(base64ToBytes(b64))
}
