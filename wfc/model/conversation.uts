import ConversationType from "./conversationType.uts";

/**
 * 会话目标的 UI 展示信息（原 JS 版本直接把 UserInfo/GroupInfo/ChannelInfo 挂到 conversation._target 上，
 * UTS 需要统一的类型，store._patchConversationInfo 负责填充）
 */
export class ConversationTarget {
    // 单聊时是 uid，群聊时是 groupId，频道时是 channelId
    target = '';
    name = '';
    remark = '';
    portrait = '';
    _displayName = '';
    // 群聊时，是否已保存到通讯录
    _isFav = false;
    // 群聊时的群信息，仅群聊有效
    memberCount = 0;
}

export default class Conversation {
    type: number = ConversationType.Single;
    conversationType: number = ConversationType.Single; // 这行是为了做一个兼容处理
    target = '';
    line = 0;

    // ---- UI 层补丁字段 ----
    _target: ConversationTarget | null = null;
    _targetOnlineStateDesc = '';

    constructor(type: number, target: string, line: number = 0) {
        this.type = type;
        this.conversationType = type;
        this.target = target;
        this.line = line;
    }

    equal(conversation: Conversation | null): boolean {
        if (conversation == null) {
            return false;
        }
        return this.type == conversation.type
            && this.target == conversation.target
            && this.line == conversation.line;
    }

    /**
     * 序列化为传递给 native 的 json 字符串（不包含 UI 补丁字段）
     */
    toJsonStr(): string {
        return JSON.stringify({
            type: this.type,
            conversationType: this.conversationType,
            target: this.target,
            line: this.line,
        } as UTSJSONObject)!
    }

    static fromJsonObject(obj: UTSJSONObject | null): Conversation | null {
        if (obj == null) {
            return null
        }
        let type = obj.getNumber('type')
        if (type == null) {
            type = obj.getNumber('conversationType')
        }
        if (type == null) {
            return null
        }
        return new Conversation(type, obj.getString('target') ?? '', obj.getNumber('line') ?? 0)
    }
}
