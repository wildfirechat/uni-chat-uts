import NotificationMessageContent from '../../messages/notification/notificationMessageContent.uts';
import MessageContentType from '../../messages/messageContentType.uts';
import MessagePayload from '../../messages/messagePayload.uts';
import { getUserDisplayName } from '../../client/userBrief.uts'
import { utf8_to_b64, b64_to_utf8 } from '../../util/base64.uts'

/**
 * 邀请新成员加入通话的可见通知，例如 “张三 邀请 李四 加入了通话”
 */
export default class AddParticipantsMessageContent extends NotificationMessageContent {
    callId = '';
    initiator = '';
    pin = '';
    participants: string[] = [];
    existParticipants: string[] = [];
    audioOnly = false;
    autoAnswer = false;
    clientId = '';

    constructor() {
        super(MessageContentType.VOIP_CONTENT_TYPE_ADD_PARTICIPANT);
    }

    override formatNotification(message: any | null): string {
        const initiatorName = this.fromSelf ? '您' : getUserDisplayName(this.initiator);
        const names = this.participants.map(uid => getUserDisplayName(uid)).join('、');
        return `${initiatorName} 邀请 ${names} 加入了通话`;
    }

    override encode(): MessagePayload {
        const payload = super.encode();
        payload.content = this.callId;
        const obj = {
            i: this.initiator,
            p: this.pin,
            ps: this.participants,
            eps: this.existParticipants,
            a: this.audioOnly ? 1 : 0,
            aa: this.autoAnswer ? 1 : 0,
            c: this.clientId,
        } as UTSJSONObject;
        payload.binaryContent = utf8_to_b64(JSON.stringify(obj)!);
        return payload;
    }

    override decode(payload: MessagePayload): void {
        super.decode(payload);
        this.callId = payload.content;
        if (payload.binaryContent != '') {
            const obj = JSON.parseObject(b64_to_utf8(payload.binaryContent));
            if (obj != null) {
                this.initiator = obj.getString('i') ?? '';
                this.pin = obj.getString('p') ?? '';
                this.participants = obj.getArray<string>('ps') ?? ([] as string[]);
                this.existParticipants = obj.getArray<string>('eps') ?? ([] as string[]);
                this.audioOnly = (obj.getNumber('a') ?? 0) == 1;
                this.autoAnswer = (obj.getNumber('aa') ?? 0) == 1;
                this.clientId = obj.getString('c') ?? '';
            }
        }
    }
}
