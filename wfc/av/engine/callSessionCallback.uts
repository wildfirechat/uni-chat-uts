/**
 * 单次通话 Session 的事件回调，页面按需给需要的字段赋值（函数类型属性，而非可 override 的方法——
 * UTS 编译到 Kotlin/Swift 后，实例方法无法像 JS 那样被逐实例替换，只有函数类型的属性才可以）。
 * 参数顺序、含义与原生事件保持一致，详见 avEngineKit.uts 里 _handleCallSessionEvent 的分发。
 */
export default class CallSessionCallback {
    didCallEndWithReason: (reason: number) => void = (_reason: number): void => {}
    didChangeState: (state: number) => void = (_state: number): void => {}
    didParticipantJoined: (userId: string, screenSharing: boolean) => void = (_userId: string, _screenSharing: boolean): void => {}
    didParticipantConnected: (userId: string, screenSharing: boolean) => void = (_userId: string, _screenSharing: boolean): void => {}
    didParticipantLeft: (userId: string, reason: number, screenSharing: boolean) => void = (_userId: string, _reason: number, _screenSharing: boolean): void => {}
    didChangeMode: (audioOnly: boolean) => void = (_audioOnly: boolean): void => {}
    didChangeInitiator: (initiator: string) => void = (_initiator: string): void => {}
    didCreateLocalVideoTrack: () => void = (): void => {}
    didReceiveRemoteVideoTrack: (userId: string, screenSharing: boolean) => void = (_userId: string, _screenSharing: boolean): void => {}
    didRemoveRemoteVideoTrack: (userId: string) => void = (_userId: string): void => {}
    didError: (error: string) => void = (_error: string): void => {}
    didVideoMuted: (userId: string, muted: boolean) => void = (_userId: string, _muted: boolean): void => {}
    didReportAudioVolume: (userId: string, volume: number) => void = (_userId: string, _volume: number): void => {}
    didAudioDeviceChanged: (device: number) => void = (_device: number): void => {}
    didChangeType: (userId: string, audience: boolean, screenSharing: boolean) => void = (_userId: string, _audience: boolean, _screenSharing: boolean): void => {}
    didMuteStateChanged: (participants: string[]) => void = (_participants: string[]): void => {}
    /**
     * 屏幕共享已开始（本端）。这不是原生 SDK 的回调，是插件合成出来的：
     * startScreenShare 是异步的（要等用户在系统确认框上点同意），成功与否只能靠事件回话。
     */
    didScreenShareStarted: () => void = (): void => {}
    /**
     * 屏幕共享已结束（本端）。三种情况都会走这里：主动 stopScreenShare、
     * 用户在系统确认框上点了取消、以及 startScreenShare 本身失败。
     * 页面照着它把「共享屏幕」按钮状态落回去即可，不要自己猜。
     */
    didScreenShareEnded: () => void = (): void => {}
}
