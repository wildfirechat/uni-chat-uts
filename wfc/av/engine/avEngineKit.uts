/*
 * 音视频通话引擎门面，包一层 uni_modules/wfc-av-client（本项目自建的 UTS 插件）。
 * 对外 API 尽量对齐迁移前 wfc/av/engine/avengineKit.js 的方法名，方便对照旧实现。
 *
 * 和旧版 .nvue/.vue 时代不同：uni-app x 是单一运行时，不需要旧代码里
 * “.nvue 页面必须通过 getApp().avengineKit 访问单例” 的 workaround，
 * 页面直接 import 这个单例使用即可。
 */
import * as native from '@/uni_modules/wfc-av-client'
import CallSession from './callSession.uts'
import CallSessionCallback from './callSessionCallback.uts'
import CallState from './callState.uts'
import ParticipantProfile from './participantProfile.uts'
import Config from '../../../config.uts'
import ConversationType from '../../model/conversationType.uts'
import wfc from '../../client/wfc.uts'
import { navigateToPage, notify } from '../../../common/nav.uts'
import { t } from '../../../i18n/i18n.uts'
import { onReceiveProtoMessages, onConferenceEvent } from "../../client/wfcEventSubscriber.uts";


function parseArgs(argsJson: string): Array<any | null> {
    const arr = JSON.parseArray(argsJson)
    return arr == null ? [] : arr as Array<any | null>
}

function argString(args: Array<any | null>, i: number): string {
    if (i >= args.length || args[i] == null) return ''
    return args[i] as string
}

function argNumber(args: Array<any | null>, i: number): number {
    if (i >= args.length || args[i] == null) return 0
    return args[i] as number
}

function argBoolean(args: Array<any | null>, i: number): boolean {
    if (i >= args.length || args[i] == null) return false
    return args[i] as boolean
}

const VOIP_ROUTES = ['pages/voip/Single', 'pages/voip/Multi', 'pages/voip/conference/ConferencePage']

function isOnVoipPage(): boolean {
    const pages = getCurrentPages()
    if (pages.length == 0) {
        return false
    }
    return VOIP_ROUTES.indexOf(pages[pages.length - 1].route) >= 0
}

let ringAudio: InnerAudioContext | null = null

function startRing(isIncoming: boolean): void {
    stopRing()
    ringAudio = uni.createInnerAudioContext()
    ringAudio!.loop = true
    ringAudio!.src = isIncoming ? '/static/audios/incoming_call_ring.mp3' : '/static/audios/outgoing_call_ring.mp3'
    ringAudio!.play()
}

function stopRing(): void {
    if (ringAudio != null) {
        ringAudio!.stop()
        ringAudio = null
    }
}

class AVEngineKit {
    private initialized = false;
    private sessionCallback: CallSessionCallback | null = null;

    init(): void {
        if (this.initialized) {
            return
        }
        this.initialized = true
        console.log('avEngineKit init')
        native.initAVEngineKit()
        // 通话挂起时原生侧要显示的文案（Android 通知栏、iOS 悬浮窗、鸿蒙画中画）。
        // 插件读不到 App 的 i18n 词条，只能由这里按当前语言送一次进去。
        native.setVoipUIStrings(t('voip.ongoing'), t('voip.waiting_answer'), t('voip.connecting'), t('voip.resume_hint'))
        Config.ICE_SERVERS.forEach(s => native.addICEServer(s.uri, s.userName, s.password))
        native.onAVEngineEvent((event: string, argsJson: string) => {
            this._handleAVEngineEvent(event, parseArgs(argsJson))
        })
        native.onCallSessionEvent((event: string, argsJson: string) => {
            this._handleCallSessionEvent(event, parseArgs(argsJson))
        })
        // 鸿蒙端音视频引擎在 ArkTS 侧，拿不到原生消息回调，voip 信令要靠这里转发过去；
        // Android/iOS 的 dispatchReceivedMessages 是空实现。
        onReceiveProtoMessages((messagesStr: string, hasMore: boolean) => {
            native.dispatchReceivedMessages(messagesStr, hasMore)
        })
        // 同理，会议事件（janus videoroom 事件）也收不到。高级版（会议版）音视频 SDK 的所有通话
        // 都走 SFU，远端流要显式订阅，而「谁发布了流」正是从这条通道来的；不转发的表现是通话能接通、
        // 但看不到对方画面也听不到声音。多人版不监听这个事件，转发了也不影响。
        onConferenceEvent((event: string) => {
            native.dispatchConferenceEvent(event)
        })
    }

    setSessionCallback(cb: CallSessionCallback | null): void {
        this.sessionCallback = cb
    }

    /** 是否支持多人音视频通话 */
    isSupportMultiCall(): boolean {
        return native.isSupportMultiCall()
    }

    /**
     * 是否支持音视频会议。
     * 音视频 SDK 分「多人版」和「高级版（会议版）」两个包，通过替换
     * uni_modules/wfc-av-client/utssdk/app-android/libs/avenginekit.aar（鸿蒙是同目录 app-harmony
     * 下的 avenginekit.har，iOS 是 app-ios/Frameworks/WFAVEngineKit.xcframework）切换，
     * 两个包对外接口一致，但会议相关接口在多人版上不可用。所有会议入口都必须先判断这个方法。
     */
    isSupportConference(): boolean {
        return native.isSupportConference()
    }

    setVideoProfile(profile: number, swapWidthHeight: boolean = false): void {
        native.setVideoProfile(profile, swapWidthHeight)
    }

    startSingleCall(userId: string, audioOnly: boolean): CallSession | null {
        const str = native.startSingleCall(userId, audioOnly)
        if (str == null) {
            // 原生 startCall 内部异常只会 printStackTrace 后返回 null，具体原因需查 logcat 中 avenginekit/PCRTCClient 相关日志
            console.error('startSingleCall 失败：原生 startCall 返回 null')
            return null
        }
        return CallSession.fromJsonStr(str)
    }

    startMultiCall(groupId: string, participants: string[], audioOnly: boolean): CallSession | null {
        const str = native.startMultiCall(groupId, participants, audioOnly)
        if (str == null) {
            console.error('startMultiCall 失败：原生 startCall 返回 null')
            return null
        }
        return CallSession.fromJsonStr(str)
    }

    /**
     * 发起会议（仅会议版 SDK 有效）
     * @param callId 会议 id
     * @param audioOnly true 音频会议，false 视频会议
     * @param pin 入会 pin 码
     * @param host 主持人用户 id
     * @param title 会议标题
     * @param desc 会议描述
     * @param audience 其他人加入会议时是否默认为观众
     * @param advance 是否为高级（超级）会议
     * @param record 是否开启服务端录制
     * @param callExtra 通话附加信息，会议的所有参与者都能看到
     */
    startConference(callId: string, audioOnly: boolean, pin: string, host: string, title: string, desc: string, audience: boolean, advance: boolean, record: boolean = false, callExtra: string = ''): CallSession | null {
        if (!this.isSupportConference()) {
            console.error('startConference 失败：当前音视频 SDK 不是会议版')
            return null
        }
        const str = native.startConference(callId, audioOnly, pin, host, title, desc, audience, advance, record, callExtra)
        if (str == null) {
            console.error('startConference 失败：原生返回 null')
            return null
        }
        return CallSession.fromJsonStr(str)
    }

    /**
     * 加入会议（仅会议版 SDK 有效）
     * @param muteAudio 是否静音入会
     * @param muteVideo 是否关闭摄像头入会
     */
    joinConference(callId: string, audioOnly: boolean, pin: string, host: string, title: string, desc: string, audience: boolean, advance: boolean, muteAudio: boolean, muteVideo: boolean, callExtra: string = ''): CallSession | null {
        if (!this.isSupportConference()) {
            console.error('joinConference 失败：当前音视频 SDK 不是会议版')
            return null
        }
        const str = native.joinConference(callId, audioOnly, pin, host, title, desc, audience, advance, muteAudio, muteVideo, callExtra)
        if (str == null) {
            console.error('joinConference 失败：原生返回 null')
            return null
        }
        return CallSession.fromJsonStr(str)
    }

    /**
     * 离开会议
     * @param destroyRoom 是否同时销毁会议，仅主持人有效
     */
    leaveConference(callId: string, destroyRoom: boolean = false): void {
        native.leaveConference(callId, destroyRoom)
    }

    /** 当前是否允许切换观众/互动者身份 */
    canSwitchAudience(callId: string): boolean {
        return native.canSwitchAudience(callId)
    }

    /** 切换观众/互动者身份，仅会议有效 */
    switchAudience(callId: string, audience: boolean): boolean {
        return native.switchAudience(callId, audience)
    }

    currentCallSession(): CallSession | null {
        return CallSession.fromJsonStr(native.currentCallSession())
    }

    answerCall(callId: string, audioOnly: boolean): void {
        native.answerCall(callId, audioOnly)
    }

    endCall(callId: string): void {
        native.endCall(callId)
    }

    muteAudio(callId: string, mute: boolean): boolean {
        return native.muteAudio(callId, mute)
    }

    muteVideo(callId: string, mute: boolean): boolean {
        return native.muteVideo(callId, mute)
    }

    downgrade2Voice(callId: string): void {
        native.downgrade2Voice(callId)
    }

    switchCamera(callId: string): void {
        native.switchCamera(callId)
    }

    setSpeakerOn(callId: string, speakerOn: boolean): void {
        native.setSpeakerOn(callId, speakerOn)
    }

    inviteNewParticipant(callId: string, userIds: string[]): void {
        native.inviteNewParticipant(callId, userIds)
    }

    kickoffParticipant(callId: string, userId: string, successCB: () => void, failCB: (error: number) => void): void {
        native.kickoffParticipant(callId, userId, successCB, failCB)
    }

    getParticipantProfiles(callId: string): ParticipantProfile[] {
        const str = native.getParticipantProfiles(callId)
        const arr = JSON.parseArray(str)
        const list: ParticipantProfile[] = []
        if (arr != null) {
            for (let i = 0; i < arr.length; i++) {
                const o = arr[i]
                if (o instanceof UTSJSONObject) {
                    const p = ParticipantProfile.fromJsonObject(o as UTSJSONObject)
                    if (p != null) {
                        list.push(p)
                    }
                }
            }
        }
        return list
    }

    getParticipantProfile(callId: string, userId: string, screenSharing: boolean = false): ParticipantProfile | null {
        const str = native.getParticipantProfile(callId, userId, screenSharing)
        if (str == null) {
            return null
        }
        return ParticipantProfile.fromJsonObject(JSON.parseObject(str))
    }

    getMyProfile(callId: string): ParticipantProfile | null {
        const str = native.getMyProfile(callId)
        if (str == null) {
            return null
        }
        return ParticipantProfile.fromJsonObject(JSON.parseObject(str))
    }

    /**
     * 是否已有悬浮窗权限（SYSTEM_ALERT_WINDOW）。纯查询，没有副作用。
     * iOS / 鸿蒙没有这个概念，恒为 true。
     */
    checkOverlayPermission(): boolean {
        return native.checkOverlayPermission()
    }

    /**
     * 跳系统设置页让用户开悬浮窗权限。仅 Android 有效，其余平台是空实现。
     *
     * ⚠️ 没有授权回调 —— 跳走之后拿不到结果，只能等用户自己回到 App 再 checkOverlayPermission()。
     * 所以调用点不要 `requestOverlayPermission(); if (check()) {...}` 这样连着写。
     */
    requestOverlayPermission(): void {
        native.requestOverlayPermission()
    }

    /**
     * 最小化。三端的 minimize 都只负责挂起 UI，不管页面栈 —— 页面侧请用
     * wfc/av/voipUtil.uts 的 minimizeCall()，它会顺带 navigateBack，并处理 Android 的悬浮窗权限引导。
     *
     * 「怎么回到通话页」三端不一样，都由插件内部触发 resumeVoipPage 事件（见 _handleCallSessionEvent）：
     *   Android —— 跨应用的系统级悬浮窗，点它回来；没有 SYSTEM_ALERT_WINDOW 权限时悬浮窗不出，
     *              还有前台服务那条常驻通知兜底，点通知一样能回来
     *   iOS     —— App 内的 UIWindow 悬浮窗，点它回来
     *   鸿蒙     —— 画中画，点「恢复」回来；画中画起不来时还有长时任务那条系统通知兜底
     *
     * @param focusVideoUser 视频通话/会议时有效，表示挂起 UI 显示哪个用户的视频流；空表示由插件自己挑
     *
     * ⚠️ 除了用户点最小化按钮，**App 切到后台时插件会自己最小化一次**（不经过这个方法）：
     * 挂起 UI 由原生侧直接挂上，再发 minimizeVoipPage 事件让这边把通话页收掉（见 _popVoipPage）。
     * 所以「通话页不在栈里但通话还在」这个状态，不止手动最小化一条来路。
     */
    minimize(callId: string, focusVideoUser: string = ''): void {
        native.minimize(callId, focusVideoUser)
    }

    setLocalVideoView(callId: string, element: UniNativeViewElement): void {
        native.setLocalVideoView(callId, element)
    }

    setRemoteVideoView(callId: string, userId: string, element: UniNativeViewElement, screenSharing: boolean = false): void {
        native.setRemoteVideoView(callId, userId, screenSharing, element)
    }

    setParticipantVideoType(callId: string, userId: string, screenSharing: boolean, videoType: number): void {
        native.setParticipantVideoType(callId, userId, screenSharing, videoType)
    }

    private _handleAVEngineEvent(event: string, args: Array<any | null>): void {
        console.log('av engine event', event)
        switch (event) {
            case 'onReceiveCall': {
                const session = CallSession.fromJsonStr(argString(args, 0))
                if (session != null) {
                    this._navigateToCallPage(session)
                }
                break
            }
            case 'shouldStartRing':
                startRing(argBoolean(args, 0))
                break
            case 'shouldStopRing':
                stopRing()
                break
            case 'didCallEnded':
                stopRing()
                if (isOnVoipPage()) {
                    uni.navigateBack({} as NavigateBackOptions)
                }
                break
            default:
                break
        }
    }

    private _navigateToCallPage(session: CallSession): void {
        let url = '/pages/voip/Single'
        if (session.conference) {
            url = '/pages/voip/conference/ConferencePage'
        } else if (session.conversation.type == ConversationType.Group) {
            url = '/pages/voip/Multi'
        }
        navigateToPage(url, session)
    }

    /**
     * 通话进行中但页面被关掉（最小化后从悬浮窗点回来、或异常退出）时，重新打开对应的通话页面。
     * 对齐旧版 avengineKit.js 的 _resumeVoipPage。
     */
    resumeVoipPage(): void {
        if (isOnVoipPage()) {
            return
        }
        const session = this.currentCallSession()
        if (session == null || session.state == CallState.STATUS_IDLE) {
            return
        }
        this._navigateToCallPage(session)
    }

    /**
     * App 切到后台，原生侧已经自己把挂起 UI 挂起来了（Android 悬浮窗 / iOS 悬浮窗 / 鸿蒙画中画），
     * 这里只负责把通话页从页面栈里收掉 —— 和用户手动点最小化后的状态完全一致，
     * 回来的路也就都收敛到同一条 resumeVoipPage 上。
     *
     * 不用 navigateBack({delta: 1})：通话页上面可能还压着别的页（比如会议里点了「邀请成员」再切后台），
     * 那样只会弹掉最上面那一层，通话页还留在栈里。按通话页在栈中的位置算 delta，一次弹干净。
     */
    private _popVoipPage(): void {
        const pages = getCurrentPages()
        let index = -1
        for (let i = pages.length - 1; i >= 0; i--) {
            if (VOIP_ROUTES.indexOf(pages[i].route) >= 0) {
                index = i
                break
            }
        }
        // 栈里没有通话页 → 不用收；通话页就是栈底（正常走不到，通话页总是从别的页 push 出来的）
        // → 弹了就一个页面都不剩了，宁可留着。
        if (index <= 0) {
            return
        }
        uni.navigateBack({
            delta: pages.length - index,
            fail: (err) => {
                console.log('auto minimize nav back err', err)
            }
        } as NavigateBackOptions)
    }

    private _handleCallSessionEvent(event: string, args: Array<any | null>): void {
        // 点悬浮窗回到通话页面：此时页面已销毁、sessionCallback 为 null，必须在下面的判空之前处理
        if (event == 'resumeVoipPage') {
            this.resumeVoipPage()
            return
        }
        // App 切到后台时原生侧自动最小化。同样要在判空之前处理：这一下之后通话页才销毁，
        // 但事件到达的时机没有保证，不该依赖 sessionCallback 还在。
        if (event == 'minimizeVoipPage') {
            this._popVoipPage()
            return
        }
        const cb = this.sessionCallback
        if (cb == null) {
            return
        }
        switch (event) {
            case 'didCallEndWithReason':
                stopRing()
                cb.didCallEndWithReason(argNumber(args, 0))
                break
            case 'didChangeState':
                cb.didChangeState(argNumber(args, 0))
                break
            case 'didParticipantJoined':
                cb.didParticipantJoined(argString(args, 0), argBoolean(args, 1))
                break
            case 'didParticipantConnected':
                cb.didParticipantConnected(argString(args, 0), argBoolean(args, 1))
                break
            case 'didParticipantLeft':
                cb.didParticipantLeft(argString(args, 0), argNumber(args, 1), argBoolean(args, 2))
                break
            case 'didChangeMode':
                cb.didChangeMode(argBoolean(args, 0))
                break
            case 'didChangeInitiator':
                cb.didChangeInitiator(argString(args, 0))
                break
            case 'didCreateLocalVideoTrack':
                cb.didCreateLocalVideoTrack()
                break
            case 'didReceiveRemoteVideoTrack':
                cb.didReceiveRemoteVideoTrack(argString(args, 0), argBoolean(args, 1))
                break
            case 'didRemoveRemoteVideoTrack':
                cb.didRemoveRemoteVideoTrack(argString(args, 0))
                break
            case 'didError':
                cb.didError(argString(args, 0))
                break
            case 'didVideoMuted':
                cb.didVideoMuted(argString(args, 0), argBoolean(args, 1))
                break
            case 'didReportAudioVolume':
                cb.didReportAudioVolume(argString(args, 0), argNumber(args, 1))
                break
            case 'didAudioDeviceChanged':
                cb.didAudioDeviceChanged(argNumber(args, 0))
                break
            case 'didChangeType':
                cb.didChangeType(argString(args, 0), argBoolean(args, 1), argBoolean(args, 2))
                break
            case 'didMuteStateChanged': {
                const arr = JSON.parseArray(argString(args, 0))
                const list: string[] = []
                if (arr != null) {
                    for (let i = 0; i < arr.length; i++) {
                        list.push(arr[i] as string)
                    }
                }
                cb.didMuteStateChanged(list)
                break
            }
            default:
                break
        }
    }
}

const avEngineKit = new AVEngineKit()
export default avEngineKit
