/**
 * 视频分辨率/帧率/码率档位，Android VideoProfile 与 iOS WFAVVideoProfile 使用同一套数值。
 */
export default class VideoProfile {
    static VP120P = 0;
    static VP180P = 10;
    static VP240P = 20;
    static VP360P = 30;
    static VP360P_4 = 33;
    static VP480P = 40;
    static VP480P_4 = 43;
    static VP720P = 50;
    static VP720P_3 = 52;
    static VP1080P = 56;
    static VPDEFAULT = 30; // VP360P
}
