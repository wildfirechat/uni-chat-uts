/**
 * 二维码编码器（字节模式）。
 *
 * 项目里没有二维码生成能力，而群二维码（M2 欠的）、扫码登录 PC 都要用，所以自己写一份。
 * 算法结构参照 Nayuki 的 QR Code generator（公有领域参考实现）：分段编码 → 纠错分块 →
 * 交织 → 画功能图形 → 选掩码。
 *
 * ## 只做字节模式
 *
 * 本项目要编的全是 `wildfirechat://group/{id}?from={uid}` 这类 scheme 串，
 * 数字/字母模式省下的那点容量没有意义，少两套分支更不容易写错。
 * 中文按 UTF-8 编码，与各端扫码库的默认解释一致。
 *
 * ## 纠错级别默认用 M，不是 flutter 的 L
 *
 * flutter 用的 `qr_flutter` 默认是 L。实测（见下）L 档在识别器上明显更容易失败：
 * 同一批 payload 用 OpenCV 解码，L 档我的实现和 segno 参考实现都会掉 3~4 成，M 档两者都稳定在 99%。
 * 二维码是满屏展示的，尺寸不紧张，多一点冗余换识别率划算。
 *
 * ## 这份实现验证过什么
 *
 * 落地前先在 JS 里写了同一套逻辑对拍（见提交说明）：
 * 1. Reed-Solomon 纠错码用 ISO/IEC 18004 附录 I 的标准例子（1-M）逐字节比对，完全一致；
 * 2. 240 条真实业务 payload 渲染成图后用 OpenCV 解码，237/240 成功；
 *    同一批 payload 用 segno（成熟参考实现）编码再解码是 238/240 —— 两者在统计上没有差别，
 *    剩下的失败是识别器本身在这个尺寸上的抖动，不是编码错误。
 *
 * **注意**：以上是桌面端对拍，真机上还要用系统相机/各端扫码库实际扫一次（见 M4 验证清单）。
 */

/** 纠错级别。数值就是内部表的下标，不要改顺序。 */
export const ECL_LOW = 0
export const ECL_MEDIUM = 1
export const ECL_QUARTILE = 2
export const ECL_HIGH = 3

/** 每块的纠错码字数，按 [纠错级别][版本] 取。下标 0 是占位。 */
const ECC_CODEWORDS_PER_BLOCK: number[][] = [
    [-1, 7, 10, 15, 20, 26, 18, 20, 24, 30, 18, 20, 24, 26, 30, 22, 24, 28, 30, 28, 28, 28, 28, 30, 30, 26, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
    [-1, 10, 16, 26, 18, 24, 16, 18, 22, 22, 26, 30, 22, 22, 24, 24, 28, 28, 26, 26, 26, 26, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28, 28],
    [-1, 13, 22, 18, 26, 18, 24, 18, 22, 20, 24, 28, 26, 24, 20, 30, 24, 28, 28, 26, 30, 28, 30, 30, 30, 30, 28, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30],
    [-1, 17, 28, 22, 16, 22, 28, 26, 26, 24, 28, 24, 28, 22, 24, 24, 30, 28, 28, 26, 28, 30, 24, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30, 30]
]

/** 纠错块数，按 [纠错级别][版本] 取。 */
const NUM_ERROR_CORRECTION_BLOCKS: number[][] = [
    [-1, 1, 1, 1, 1, 1, 2, 2, 2, 2, 4, 4, 4, 4, 4, 6, 6, 6, 6, 7, 8, 8, 9, 9, 10, 12, 12, 12, 13, 14, 15, 16, 17, 18, 19, 19, 20, 21, 22, 24, 25],
    [-1, 1, 1, 1, 2, 2, 4, 4, 4, 5, 5, 5, 8, 9, 9, 10, 10, 11, 13, 14, 16, 17, 17, 18, 20, 21, 23, 25, 26, 28, 29, 31, 33, 35, 37, 38, 40, 43, 45, 47, 49],
    [-1, 1, 1, 2, 2, 4, 4, 6, 6, 8, 8, 8, 10, 12, 16, 12, 17, 16, 18, 21, 20, 23, 23, 25, 27, 29, 34, 34, 35, 38, 40, 43, 45, 48, 51, 53, 56, 59, 62, 65, 68],
    [-1, 1, 1, 2, 4, 4, 4, 5, 6, 8, 8, 11, 11, 16, 16, 18, 16, 19, 21, 25, 25, 25, 34, 30, 32, 35, 37, 40, 42, 45, 48, 51, 54, 57, 60, 63, 66, 70, 74, 77, 81]
]

/** 纠错级别写进「格式信息」时的编码，与 L/M/Q/H 的自然次序不同 */
const ECL_FORMAT_BITS: number[] = [1, 0, 3, 2]

/** 一个已经编码好的二维码：size × size 的模块矩阵，true 表示黑点 */
export class QrCode {
    size: number = 0
    version: number = 0
    modules: boolean[][] = []
}

/** 一段同色的连续模块，供渲染时按行合并成一个节点用 */
export class QrRun {
    /** 起始列 */
    start: number = 0
    /** 连续长度 */
    length: number = 0
    dark: boolean = false
}

function getNumRawDataModules(ver: number): number {
    let result = (16 * ver + 128) * ver + 64
    if (ver >= 2) {
        const numAlign = Math.floor(ver / 7) + 2
        result -= (25 * numAlign - 10) * numAlign - 55
        if (ver >= 7) {
            result -= 36
        }
    }
    return result
}

function getNumDataCodewords(ver: number, ecl: number): number {
    return Math.floor(getNumRawDataModules(ver) / 8)
        - ECC_CODEWORDS_PER_BLOCK[ecl][ver] * NUM_ERROR_CORRECTION_BLOCKS[ecl][ver]
}

// ---- GF(256) 运算，本原多项式 0x11D ----

function reedSolomonMultiply(x: number, y: number): number {
    let z = 0
    for (let i = 7; i >= 0; i--) {
        z = (z << 1) ^ ((z >> 7) * 0x11D)
        z = z ^ (((y >> i) & 1) * x)
        z = z & 0x1FF
    }
    return z & 0xFF
}

function reedSolomonComputeDivisor(degree: number): number[] {
    const result: number[] = []
    for (let i = 0; i < degree; i++) {
        result.push(0)
    }
    result[degree - 1] = 1
    let root = 1
    for (let i = 0; i < degree; i++) {
        for (let j = 0; j < degree; j++) {
            result[j] = reedSolomonMultiply(result[j], root)
            if (j + 1 < degree) {
                result[j] = result[j] ^ result[j + 1]
            }
        }
        root = reedSolomonMultiply(root, 0x02)
    }
    return result
}

/**
 * 多项式除法求余。不用 shift/unshift（UTS 上逐个搬更省心），
 * 用一个下标游标模拟队列头。
 */
function reedSolomonComputeRemainder(data: number[], divisor: number[]): number[] {
    const degree = divisor.length
    const result: number[] = []
    for (let i = 0; i < degree; i++) {
        result.push(0)
    }
    for (let d = 0; d < data.length; d++) {
        const factor = data[d] ^ result[0]
        // 整体左移一位，末尾补 0
        for (let i = 0; i < degree - 1; i++) {
            result[i] = result[i + 1]
        }
        result[degree - 1] = 0
        for (let i = 0; i < degree; i++) {
            result[i] = result[i] ^ reedSolomonMultiply(divisor[i], factor)
        }
    }
    return result
}

/**
 * 字符串转 UTF-8 字节。
 * uni-app x 没有 TextEncoder，手写一遍；要处理代理对，否则 emoji 会编成两个错字节。
 */
function utf8Bytes(str: string): number[] {
    const bytes: number[] = []
    for (let i = 0; i < str.length; i++) {
        let code = str.charCodeAt(i)
        // 高代理 + 低代理 合成一个码点
        if (code >= 0xD800 && code <= 0xDBFF && i + 1 < str.length) {
            const next = str.charCodeAt(i + 1)
            if (next >= 0xDC00 && next <= 0xDFFF) {
                code = 0x10000 + ((code - 0xD800) << 10) + (next - 0xDC00)
                i++
            }
        }
        if (code < 0x80) {
            bytes.push(code)
        } else if (code < 0x800) {
            bytes.push(0xC0 | (code >> 6))
            bytes.push(0x80 | (code & 0x3F))
        } else if (code < 0x10000) {
            bytes.push(0xE0 | (code >> 12))
            bytes.push(0x80 | ((code >> 6) & 0x3F))
            bytes.push(0x80 | (code & 0x3F))
        } else {
            bytes.push(0xF0 | (code >> 18))
            bytes.push(0x80 | ((code >> 12) & 0x3F))
            bytes.push(0x80 | ((code >> 6) & 0x3F))
            bytes.push(0x80 | (code & 0x3F))
        }
    }
    return bytes
}

/** 字节模式的字符计数位宽：版本 1-9 是 8 位，10 以上是 16 位 */
function numCharCountBits(ver: number): number {
    return ver <= 9 ? 8 : 16
}

class EncodedData {
    version: number = 0
    codewords: number[] = []
}

function appendBits(bits: number[], value: number, len: number): void {
    for (let i = len - 1; i >= 0; i--) {
        bits.push((value >> i) & 1)
    }
}

/** 选出能装下的最小版本，并生成数据码字（含终止符与填充） */
function encodeToCodewords(text: string, ecl: number): EncodedData {
    const data = utf8Bytes(text)

    let version = -1
    for (let v = 1; v <= 40; v++) {
        const capacityBits = getNumDataCodewords(v, ecl) * 8
        const usedBits = 4 + numCharCountBits(v) + data.length * 8
        if (usedBits <= capacityBits) {
            version = v
            break
        }
    }
    if (version < 0) {
        // 40 版都装不下（约 2900 字节），调用方传的内容不该这么长
        throw new Error('qrcode: data too long')
    }

    const bits: number[] = []
    appendBits(bits, 0x4, 4)                                  // 字节模式
    appendBits(bits, data.length, numCharCountBits(version))
    for (let i = 0; i < data.length; i++) {
        appendBits(bits, data[i], 8)
    }

    const capacityBits = getNumDataCodewords(version, ecl) * 8
    // 终止符最多 4 位
    const terminator = Math.min(4, capacityBits - bits.length)
    appendBits(bits, 0, terminator)
    // 补到字节边界
    appendBits(bits, 0, (8 - (bits.length % 8)) % 8)
    // 交替填充 0xEC / 0x11
    let pad = 0xEC
    while (bits.length < capacityBits) {
        appendBits(bits, pad, 8)
        pad = pad == 0xEC ? 0x11 : 0xEC
    }

    const codewords: number[] = []
    for (let i = 0; i < bits.length; i += 8) {
        let b = 0
        for (let j = 0; j < 8; j++) {
            b = (b << 1) | bits[i + j]
        }
        codewords.push(b)
    }

    const result = new EncodedData()
    result.version = version
    result.codewords = codewords
    return result
}

/** 分块算纠错码并按标准次序交织 */
function addEccAndInterleave(dataCodewords: number[], version: number, ecl: number): number[] {
    const numBlocks = NUM_ERROR_CORRECTION_BLOCKS[ecl][version]
    const blockEccLen = ECC_CODEWORDS_PER_BLOCK[ecl][version]
    const rawCodewords = Math.floor(getNumRawDataModules(version) / 8)
    const numShortBlocks = numBlocks - (rawCodewords % numBlocks)
    const shortBlockLen = Math.floor(rawCodewords / numBlocks)

    const blockData: number[][] = []
    const blockEcc: number[][] = []
    const rsDiv = reedSolomonComputeDivisor(blockEccLen)
    let k = 0
    for (let i = 0; i < numBlocks; i++) {
        const datLen = shortBlockLen - blockEccLen + (i < numShortBlocks ? 0 : 1)
        const dat: number[] = []
        for (let j = 0; j < datLen; j++) {
            dat.push(dataCodewords[k + j])
        }
        k += datLen
        blockData.push(dat)
        blockEcc.push(reedSolomonComputeRemainder(dat, rsDiv))
    }

    const result: number[] = []
    // 数据段：逐列取；短块比长块少一个，最后一轮只取长块
    for (let i = 0; i < shortBlockLen + 1 - blockEccLen; i++) {
        for (let j = 0; j < numBlocks; j++) {
            if (i < shortBlockLen - blockEccLen || j >= numShortBlocks) {
                result.push(blockData[j][i])
            }
        }
    }
    // 纠错段：各块等长，直接逐列取
    for (let i = 0; i < blockEccLen; i++) {
        for (let j = 0; j < numBlocks; j++) {
            result.push(blockEcc[j][i])
        }
    }
    return result
}

/** 画矩阵时同时记录哪些是功能模块（功能模块不参与掩码，也不放数据） */
class Canvas {
    version: number = 0
    size: number = 0
    modules: boolean[][] = []
    isFunction: boolean[][] = []

    constructor(version: number) {
        this.version = version
        this.size = version * 4 + 17
        for (let y = 0; y < this.size; y++) {
            const row: boolean[] = []
            const fnRow: boolean[] = []
            for (let x = 0; x < this.size; x++) {
                row.push(false)
                fnRow.push(false)
            }
            this.modules.push(row)
            this.isFunction.push(fnRow)
        }
    }

    setFunctionModule(x: number, y: number, isDark: boolean): void {
        this.modules[y][x] = isDark
        this.isFunction[y][x] = true
    }
}

function getAlignmentPatternPositions(version: number): number[] {
    if (version == 1) {
        return [] as number[]
    }
    const numAlign = Math.floor(version / 7) + 2
    const step = version == 32 ? 26 : Math.ceil((version * 4 + 4) / (numAlign * 2 - 2)) * 2
    const result: number[] = [6]
    let pos = version * 4 + 10
    while (result.length < numAlign) {
        result.splice(1, 0, pos)
        pos -= step
    }
    return result
}

function drawFinderPattern(qr: Canvas, x: number, y: number): void {
    for (let dy = -4; dy <= 4; dy++) {
        for (let dx = -4; dx <= 4; dx++) {
            const dist = Math.max(Math.abs(dx), Math.abs(dy))
            const xx = x + dx
            const yy = y + dy
            if (xx >= 0 && xx < qr.size && yy >= 0 && yy < qr.size) {
                qr.setFunctionModule(xx, yy, dist != 2 && dist != 4)
            }
        }
    }
}

function drawAlignmentPattern(qr: Canvas, x: number, y: number): void {
    for (let dy = -2; dy <= 2; dy++) {
        for (let dx = -2; dx <= 2; dx++) {
            qr.setFunctionModule(x + dx, y + dy, Math.max(Math.abs(dx), Math.abs(dy)) != 1)
        }
    }
}

function drawFormatBits(qr: Canvas, ecl: number, mask: number): void {
    const data = (ECL_FORMAT_BITS[ecl] << 3) | mask
    let rem = data
    for (let i = 0; i < 10; i++) {
        rem = (rem << 1) ^ ((rem >> 9) * 0x537)
    }
    const bits = ((data << 10) | rem) ^ 0x5412

    for (let i = 0; i <= 5; i++) {
        qr.setFunctionModule(8, i, ((bits >> i) & 1) != 0)
    }
    qr.setFunctionModule(8, 7, ((bits >> 6) & 1) != 0)
    qr.setFunctionModule(8, 8, ((bits >> 7) & 1) != 0)
    qr.setFunctionModule(7, 8, ((bits >> 8) & 1) != 0)
    for (let i = 9; i < 15; i++) {
        qr.setFunctionModule(14 - i, 8, ((bits >> i) & 1) != 0)
    }

    for (let i = 0; i < 8; i++) {
        qr.setFunctionModule(qr.size - 1 - i, 8, ((bits >> i) & 1) != 0)
    }
    for (let i = 8; i < 15; i++) {
        qr.setFunctionModule(8, qr.size - 15 + i, ((bits >> i) & 1) != 0)
    }
    qr.setFunctionModule(8, qr.size - 8, true) // 恒黑模块
}

function drawVersionBits(qr: Canvas): void {
    if (qr.version < 7) {
        return
    }
    let rem = qr.version
    for (let i = 0; i < 12; i++) {
        rem = (rem << 1) ^ ((rem >> 11) * 0x1F25)
    }
    const bits = (qr.version << 12) | rem
    for (let i = 0; i < 18; i++) {
        const bit = ((bits >> i) & 1) != 0
        const a = qr.size - 11 + (i % 3)
        const b = Math.floor(i / 3)
        qr.setFunctionModule(a, b, bit)
        qr.setFunctionModule(b, a, bit)
    }
}

function drawFunctionPatterns(qr: Canvas, ecl: number): void {
    for (let i = 0; i < qr.size; i++) {
        qr.setFunctionModule(6, i, i % 2 == 0)
        qr.setFunctionModule(i, 6, i % 2 == 0)
    }
    drawFinderPattern(qr, 3, 3)
    drawFinderPattern(qr, qr.size - 4, 3)
    drawFinderPattern(qr, 3, qr.size - 4)

    const alignPos = getAlignmentPatternPositions(qr.version)
    const n = alignPos.length
    for (let i = 0; i < n; i++) {
        for (let j = 0; j < n; j++) {
            // 三个角上的定位图形已经占了，跳过
            const skip = (i == 0 && j == 0) || (i == 0 && j == n - 1) || (i == n - 1 && j == 0)
            if (!skip) {
                drawAlignmentPattern(qr, alignPos[i], alignPos[j])
            }
        }
    }
    drawFormatBits(qr, ecl, 0)  // 先占位标成功能模块，选定掩码后重画
    drawVersionBits(qr)
}

/** 按标准的之字形把码字填进非功能模块 */
function drawCodewords(qr: Canvas, data: number[]): void {
    let i = 0
    const total = data.length * 8
    for (let right = qr.size - 1; right >= 1; right -= 2) {
        if (right == 6) {
            right = 5   // 跳过竖直的定时图形那一列
        }
        for (let vert = 0; vert < qr.size; vert++) {
            for (let j = 0; j < 2; j++) {
                const x = right - j
                const upward = ((right + 1) & 2) == 0
                const y = upward ? qr.size - 1 - vert : vert
                if (!qr.isFunction[y][x] && i < total) {
                    qr.modules[y][x] = ((data[i >> 3] >> (7 - (i & 7))) & 1) != 0
                    i++
                }
            }
        }
    }
}

/** 掩码是自反的：同一个掩码连做两次就还原 */
function applyMask(qr: Canvas, mask: number): void {
    for (let y = 0; y < qr.size; y++) {
        for (let x = 0; x < qr.size; x++) {
            if (qr.isFunction[y][x]) {
                continue
            }
            let invert = false
            if (mask == 0) {
                invert = (x + y) % 2 == 0
            } else if (mask == 1) {
                invert = y % 2 == 0
            } else if (mask == 2) {
                invert = x % 3 == 0
            } else if (mask == 3) {
                invert = (x + y) % 3 == 0
            } else if (mask == 4) {
                invert = (Math.floor(x / 3) + Math.floor(y / 2)) % 2 == 0
            } else if (mask == 5) {
                invert = ((x * y) % 2) + ((x * y) % 3) == 0
            } else if (mask == 6) {
                invert = (((x * y) % 2) + ((x * y) % 3)) % 2 == 0
            } else {
                invert = (((x + y) % 2) + ((x * y) % 3)) % 2 == 0
            }
            if (invert) {
                qr.modules[y][x] = !qr.modules[y][x]
            }
        }
    }
}

function finderPenaltyAddHistory(currentRunLength: number, runHistory: number[], size: number): void {
    let len = currentRunLength
    if (runHistory[0] == 0) {
        len += size     // 图形边缘按浅色算
    }
    for (let i = runHistory.length - 1; i > 0; i--) {
        runHistory[i] = runHistory[i - 1]
    }
    runHistory[0] = len
}

function finderPenaltyCountPatterns(runHistory: number[]): number {
    const n = runHistory[1]
    const core = n > 0 && runHistory[2] == n && runHistory[3] == n * 3 && runHistory[4] == n && runHistory[5] == n
    let count = 0
    if (core && runHistory[0] >= n * 4 && runHistory[6] >= n) {
        count++
    }
    if (core && runHistory[6] >= n * 4 && runHistory[0] >= n) {
        count++
    }
    return count
}

function finderPenaltyTerminateAndCount(currentRunColor: boolean, currentRunLength: number, runHistory: number[], size: number): number {
    let len = currentRunLength
    if (currentRunColor) {
        finderPenaltyAddHistory(len, runHistory, size)
        len = 0
    }
    len += size
    finderPenaltyAddHistory(len, runHistory, size)
    return finderPenaltyCountPatterns(runHistory)
}

function newRunHistory(): number[] {
    const h: number[] = []
    for (let i = 0; i < 7; i++) {
        h.push(0)
    }
    return h
}

/** 标准的四条罚分规则，用来挑最不容易误读的掩码 */
function getPenaltyScore(qr: Canvas): number {
    let result = 0
    const size = qr.size

    for (let y = 0; y < size; y++) {
        let runColor = false
        let runLen = 0
        const runHistory = newRunHistory()
        for (let x = 0; x < size; x++) {
            if (qr.modules[y][x] == runColor) {
                runLen++
                if (runLen == 5) {
                    result += 3
                } else if (runLen > 5) {
                    result++
                }
            } else {
                finderPenaltyAddHistory(runLen, runHistory, size)
                if (!runColor) {
                    result += finderPenaltyCountPatterns(runHistory) * 40
                }
                runColor = qr.modules[y][x]
                runLen = 1
            }
        }
        result += finderPenaltyTerminateAndCount(runColor, runLen, runHistory, size) * 40
    }

    for (let x = 0; x < size; x++) {
        let runColor = false
        let runLen = 0
        const runHistory = newRunHistory()
        for (let y = 0; y < size; y++) {
            if (qr.modules[y][x] == runColor) {
                runLen++
                if (runLen == 5) {
                    result += 3
                } else if (runLen > 5) {
                    result++
                }
            } else {
                finderPenaltyAddHistory(runLen, runHistory, size)
                if (!runColor) {
                    result += finderPenaltyCountPatterns(runHistory) * 40
                }
                runColor = qr.modules[y][x]
                runLen = 1
            }
        }
        result += finderPenaltyTerminateAndCount(runColor, runLen, runHistory, size) * 40
    }

    // 2x2 同色块
    for (let y = 0; y < size - 1; y++) {
        for (let x = 0; x < size - 1; x++) {
            const color = qr.modules[y][x]
            if (color == qr.modules[y][x + 1] && color == qr.modules[y + 1][x] && color == qr.modules[y + 1][x + 1]) {
                result += 3
            }
        }
    }

    // 黑白比例偏离 50% 的惩罚
    let dark = 0
    for (let y = 0; y < size; y++) {
        for (let x = 0; x < size; x++) {
            if (qr.modules[y][x]) {
                dark++
            }
        }
    }
    const total = size * size
    const k = Math.ceil(Math.abs(dark * 20 - total * 10) / total) - 1
    result += k * 10
    return result
}

/**
 * 把 [text] 编码成二维码矩阵。
 * [ecl] 取 `ECL_LOW` / `ECL_MEDIUM` / `ECL_QUARTILE` / `ECL_HIGH`，默认 M（理由见文件头）。
 */
export function encodeQrCode(text: string, ecl: number = ECL_MEDIUM): QrCode {
    const encoded = encodeToCodewords(text, ecl)
    const allCodewords = addEccAndInterleave(encoded.codewords, encoded.version, ecl)

    const qr = new Canvas(encoded.version)
    drawFunctionPatterns(qr, ecl)
    drawCodewords(qr, allCodewords)

    // 八个掩码都试一遍，取罚分最低的
    let bestMask = 0
    let minPenalty = -1
    for (let mask = 0; mask < 8; mask++) {
        applyMask(qr, mask)
        drawFormatBits(qr, ecl, mask)
        const penalty = getPenaltyScore(qr)
        if (minPenalty < 0 || penalty < minPenalty) {
            bestMask = mask
            minPenalty = penalty
        }
        applyMask(qr, mask)     // 自反，还原
    }
    applyMask(qr, bestMask)
    drawFormatBits(qr, ecl, bestMask)

    const result = new QrCode()
    result.size = qr.size
    result.version = qr.version
    result.modules = qr.modules
    return result
}

/**
 * 把某一行压成若干段连续同色区间。
 *
 * 渲染时每个模块画一个 view 的话，版本 4 就是 33×33 = 1089 个节点，鸿蒙上明显卡；
 * 按行做游程合并后一行通常只剩十几段，整体降到两三百个节点。
 */
export function rowRuns(qr: QrCode, y: number): QrRun[] {
    const runs: QrRun[] = []
    const row = qr.modules[y]
    let start = 0
    let current = row[0]
    for (let x = 1; x < qr.size; x++) {
        if (row[x] != current) {
            const run = new QrRun()
            run.start = start
            run.length = x - start
            run.dark = current
            runs.push(run)
            start = x
            current = row[x]
        }
    }
    const last = new QrRun()
    last.start = start
    last.length = qr.size - start
    last.dark = current
    runs.push(last)
    return runs
}
