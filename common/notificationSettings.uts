/**
 * 消息通知设置的业务语义。对齐 flutter `settings/notification_settings.dart`。
 *
 * 两件事在这里统一，页面不要自己算：
 *
 * 1. **取反语义**：服务端存的是「是否静默 / 是否隐藏 / 是否禁用」，UI 呈现的是正向开关
 *    （「接收通知 / 显示详情 / 同步草稿」），读写都要取反。写反了不会报错，只会让开关的含义颠倒。
 * 2. **免打扰时段的时区**：服务端按 **UTC 零点起的分钟数**存，展示要换算成本地时间。
 */
import wfc from '@/wfc/client/wfc.uts'

/**
 * 免打扰时段固定按东八区呈现（与 iOS/Android 官方客户端一致）。
 * 要支持其他时区就改这一个常量。
 */
export const UTC_OFFSET_MINUTES: number = 8 * 60

/** 默认免打扰时段：本地 21:00 - 次日 07:00，换算成 UTC 分钟数。 */
export const DEFAULT_NO_DISTURB_START: number = 21 * 60 - UTC_OFFSET_MINUTES
export const DEFAULT_NO_DISTURB_END: number = 7 * 60 - UTC_OFFSET_MINUTES

function pad2(value: number): string {
    return value < 10 ? '0' + value : '' + value
}

/**
 * 把免打扰时段（UTC 分钟数）格式化成本地时间 `'21:00 - 07:00'`。
 */
export function formatNoDisturbTime(startMins: number, endMins: number): string {
    // 加完时区偏移可能越界（负数或超过一天），先归一到 [0, 1440)
    const dayMinutes = 24 * 60
    let localStart = (startMins + UTC_OFFSET_MINUTES) % dayMinutes
    let localEnd = (endMins + UTC_OFFSET_MINUTES) % dayMinutes
    if (localStart < 0) {
        localStart += dayMinutes
    }
    if (localEnd < 0) {
        localEnd += dayMinutes
    }
    return pad2(Math.floor(localStart / 60)) + ':' + pad2(localStart % 60)
        + ' - '
        + pad2(Math.floor(localEnd / 60)) + ':' + pad2(localEnd % 60)
}

/**
 * 读一个布尔型 user setting。[invert] 为 true 时存储语义与 UI 相反。
 *
 * 未设置过（空串）按 `false` 算 —— 与服务端一致：没写过就是没开启。
 */
export function getBoolSetting(scope: number, invert: boolean): boolean {
    const value = wfc.getUserSetting(scope, '')
    const enabled = !(value == '' || value == '0')
    return invert ? !enabled : enabled
}

/**
 * 写一个布尔型 user setting，[value] 是 **UI 上的开关值**，[invert] 同 [getBoolSetting]。
 * 失败时调用方应回读并提示。
 */
export function setBoolSetting(scope: number, value: boolean, invert: boolean, successCB: (() => void) | null, failCB: ((err: number) => void) | null): void {
    const stored = invert ? !value : value
    wfc.setUserSetting(scope, '', stored ? '1' : '0', successCB, failCB)
}
