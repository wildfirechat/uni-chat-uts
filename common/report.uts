/**
 * 举报（UGC 审核指南 1.2 要求）：确认后打开与官方账号的单聊，用户把举报内容发给官方处理。
 *
 * flutter 侧同一段逻辑抄了两份（`settings/general_settings.dart` 的设置入口、
 * `conversation/conversation_controller.dart` 的消息长按菜单），这里合成一处。
 */
import store from "../store.uts";
import Conversation from "../wfc/model/conversation.uts";
import ConversationType from "../wfc/model/conversationType.uts";
import { go2ConversationPage } from "./nav.uts";
import { t } from "../i18n/i18n.uts";

/** 举报接收方：官方账号，与 flutter 一致。 */
export const REPORT_TARGET_USER_ID = 'cgc8c8VV'

// 写成箭头常量而不是 export function：GeneralSettingsPage 的模板里直接 @tap="report"，
// 模板表达式编译成 unref(report)，要求它是个值；Kotlin 的 fun 名字不能当值用
export const report = (): void => {
    uni.showModal({
        title: t('setting.report'),
        content: t('setting.report_tip'),
        success: (res) => {
            if (!res.confirm) {
                return
            }
            store.setCurrentConversation(new Conversation(ConversationType.Single, REPORT_TARGET_USER_ID, 0))
            go2ConversationPage()
        }
    } as ShowModalOptions)
}
