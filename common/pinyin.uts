/**
 * 拼音工具，替代原 js pinyin 库（及鸿蒙端插件 pinyin）。
 * 数据表见 pinyinData.uts（0x4E00-0x9FA5 常用汉字，首读音、无声调）。
 */
import { PINYIN_DICT, PINYIN_DICT_START } from './pinyinData.uts'

let dictArray: string[] | null = null

function dict(): string[] {
    if (dictArray == null) {
        dictArray = PINYIN_DICT.split(',')
    }
    return dictArray!
}

function pinyinOfChar(c: string): string {
    const cp = c.charCodeAt(0)
    const index = cp - PINYIN_DICT_START
    const d = dict()
    if (index >= 0 && index < d.length) {
        const py = d[index]
        if (py != '') {
            return py
        }
    }
    return c
}

/**
 * 完整拼音，等价于原 pinyin(str, {style: 0}).join('').trim().toLowerCase()
 */
export function pinyinOf(str: string): string {
    let result = ''
    for (let i = 0; i < str.length; i++) {
        result += pinyinOfChar(str.charAt(i))
    }
    return result.trim().toLowerCase()
}

/**
 * 拼音首字母，等价于原 pinyin(str, {style: 4}).join('').trim().toLowerCase()
 */
export function pinyinFirstLetters(str: string): string {
    let result = ''
    for (let i = 0; i < str.length; i++) {
        const py = pinyinOfChar(str.charAt(i))
        if (py.length > 0) {
            result += py.charAt(0)
        }
    }
    return result.trim().toLowerCase()
}
